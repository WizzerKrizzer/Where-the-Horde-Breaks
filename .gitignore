# Scenes the Unity test runner generates
Assets/InitTestScene*.unity
Assets/InitTestScene*.unity.meta

# Anything made with Mixamo animations goes in a folder named Mixamo. Adobe's terms do not allow
# redistributing those files, and this repository is public.
**/Mixamo/
**/Mixamo.meta

# Kevin Iglesias animations (Unity Asset Store EULA): royalty-free in the game, but the files may not
# be redistributed, so they and anything built from them stay out of this public repository.
**/KevinIglesias/
**/KevinIglesias.meta

# Models made with Meshy stay local for now (user, 2026-11-11): the mammoth and its pen.
Assets/Resources/Meshy/
Assets/Resources/Meshy.meta

# Meshy models and Gemini images stay local for now (user, 2026-11-11): the sources in Art/ and the
# copies the capture tests read.
Art/**/Meshy/
Art/**/Gemini/
Assets/Tests/PlayMode/StyleAssets/Resources/cave.fbx*
Assets/Tests/PlayMode/StyleAssets/Resources/cave-tex.png*
Assets/Tests/PlayMode/StyleAssets/Resources/spearrock.fbx*
