void EmitDetailedEvent(uint objectIndex, uint eventType, float value, uint generation, int sourceIndex)
{
    uint eventIndex;
    InterlockedAdd(_EventCount[0], 1, eventIndex);
    if (eventIndex < _EventCapacity)
    {
        HordeEvent result;
        result.index = objectIndex;
        result.type = eventType;
        result.value = value;
        result.generation = generation;
        result.sourceIndex = sourceIndex;
        result.padding = 0.0;
        _HordeEvents[eventIndex] = result;
    }
}

void RecordCorpse(AgentState state)
{
    if (_CorpseCapacity == 0u) return;
    int cursor;
    InterlockedAdd(_Aux[0], 1, cursor);
    uint offset = _CorpseBase + ((uint)cursor % _CorpseCapacity) * 4u;
    _Aux[offset] = asint(state.position.x);
    _Aux[offset + 1u] = asint(state.position.y);
    _Aux[offset + 2u] = asint(state.scale);
    _Aux[offset + 3u] = asint(1.0);
}

void EmitEvent(uint agentIndex, uint eventType, float value)
{
    EmitDetailedEvent(agentIndex, eventType, value, 0u, -1);
}

int2 WorldToCell(float2 position)
{
    return (int2)floor((position - _GridOrigin) / _CellSize);
}

bool IsInside(int2 cell)
{
    return all(cell >= 0) && cell.x < _GridSize.x && cell.y < _GridSize.y;
}

uint CellIndex(int2 cell)
{
    return (uint)(cell.y * _GridSize.x + cell.x);
}

float BoundaryDistanceAt(int2 cell)
{
    if (!IsInside(cell))
    {
        return -_CellSize;
    }

    return _FlowData[CellIndex(cell)].w;
}

float SampleBoundaryDistance(float2 position)
{
    float2 grid = (position - _GridOrigin) / _CellSize - 0.5;
    int2 baseCell = (int2)floor(grid);
    float2 t = frac(grid);
    int2 bottomRightCell = baseCell + int2(1, 0);
    int2 topLeftCell = baseCell + int2(0, 1);
    int2 topRightCell = baseCell + int2(1, 1);
    float bottomLeft = BoundaryDistanceAt(baseCell);
    float bottomRight = BoundaryDistanceAt(bottomRightCell);
    float topLeft = BoundaryDistanceAt(topLeftCell);
    float topRight = BoundaryDistanceAt(topRightCell);
    float bottom = lerp(bottomLeft, bottomRight, t.x);
    float top = lerp(topLeft, topRight, t.x);
    return lerp(bottom, top, t.y);
}

float2 SampleBoundaryNormal(float2 position)
{
    float offset = _CellSize * 0.5;
    float2 gradient = float2(
        SampleBoundaryDistance(position + float2(offset, 0.0)) -
            SampleBoundaryDistance(position - float2(offset, 0.0)),
        SampleBoundaryDistance(position + float2(0.0, offset)) -
            SampleBoundaryDistance(position - float2(0.0, offset)));
    float lengthSq = dot(gradient, gradient);
    return lengthSq > 0.000001 ? gradient * rsqrt(lengthSq) : float2(0.0, 0.0);
}

bool IsWalkable(float2 position)
{
    return IsInside(WorldToCell(position)) && SampleBoundaryDistance(position) >= 0.0;
}

float4 GetFlowVector(int2 cell)
{
    if (!IsInside(cell) || _FlowData[CellIndex(cell)].y < 0.0)
    {
        return 0.0;
    }

    return _FlowVectors[CellIndex(cell)];
}

float CellOccupancy(int2 cell)
{
    return IsInside(cell) ? (float)_CellCountsRead[CellIndex(cell)] : 0.0;
}

float PressureOccupancy(int2 cell)
{
    // Road boundaries are handled by signed-distance contacts. Filling every
    // outside cell with imaginary bodies repels goblins up to two grid cells
    // (~1.2m) before the actual edge, leaving an invisible empty border.
    return IsInside(cell) && _FlowData[CellIndex(cell)].y >= 0.0
        ? CellOccupancy(cell)
        : (_AnimatedGoblin != 0u ? 0.0 : (float)_CellCapacity);
}

float SmoothedSideOccupancy(int2 cell, int2 offset, int2 tangent)
{
    int2 side = cell + offset;
    return PressureOccupancy(side) +
        (PressureOccupancy(side + tangent) + PressureOccupancy(side - tangent)) * 0.5;
}

float2 SampleFlow(float2 position)
{
    float2 grid = (position - _GridOrigin) / _CellSize - 0.5;
    int2 baseCell = (int2)floor(grid);
    float2 t = frac(grid);
    float2 a = lerp(GetFlowVector(baseCell).xy, GetFlowVector(baseCell + int2(1, 0)).xy, t.x);
    float2 b = lerp(GetFlowVector(baseCell + int2(0, 1)).xy, GetFlowVector(baseCell + int2(1, 1)).xy, t.x);
    float2 direction = lerp(a, b, t.y);
    float lengthSq = dot(direction, direction);
    return lengthSq > 0.000001 ? direction * rsqrt(lengthSq) : float2(0.0, 0.0);
}

float SamplePotential(float2 position)
{
    int2 cell = WorldToCell(position);
    return IsInside(cell) && _FlowData[CellIndex(cell)].y >= 0.0
        ? _FlowData[CellIndex(cell)].z
        : 0.0;
}

float SampleIntegration(float2 position)
{
    int2 cell = WorldToCell(position);
    return IsInside(cell) && _FlowData[CellIndex(cell)].y >= 0.0
        ? _FlowData[CellIndex(cell)].y
        : 1e20;
}

float2 Rotate2D(float2 value, float radians)
{
    float sine;
    float cosine;
    sincos(radians, sine, cosine);
    return float2(value.x * cosine - value.y * sine, value.x * sine + value.y * cosine);
}

float2 FindNavigableFlow(float2 position, float2 preferred)
{
    float probeDistance = _CellSize * 0.7;
    if (IsWalkable(position + preferred * probeDistance))
    {
        return preferred;
    }

    float currentIntegration = SampleIntegration(position);
    float2 best = preferred;
    float bestScore = -1e20;
    [unroll]
    for (int step = 1; step <= 4; step++)
    {
        float angle = radians(step * 22.5);
        float2 candidates[2] = { Rotate2D(preferred, angle), Rotate2D(preferred, -angle) };
        [unroll]
        for (int side = 0; side < 2; side++)
        {
            float2 candidate = candidates[side];
            float2 probe = position + candidate * probeDistance;
            if (!IsWalkable(probe))
            {
                continue;
            }

            // Integration always decreases towards the exit. It resolves the
            // otherwise symmetric up/down choice at square corners without relying
            // on the expensive harmonic potential used by irregular routes.
            float progress = currentIntegration - SampleIntegration(probe);
            float2 probeFlow = SampleFlow(probe);
            float routeAlignment = dot(probeFlow, probeFlow) > 0.0001
                ? dot(candidate, probeFlow)
                : 0.0;
            // A runner carries its current direction until the environment blocks
            // it; only then does this choose a locally valid branch. The nearby
            // route vector wins that choice, while integration is merely a weak
            // tie-breaker for dead ends and split roads.
            float score = routeAlignment * 3.0 + dot(candidate, preferred) * 0.7 + progress * 0.2;
            if (score > bestScore)
            {
                bestScore = score;
                best = candidate;
            }
        }
    }

    return best;
}

float2 ConstrainMoveStep(float2 current, float2 desired)
{
    if (IsWalkable(desired))
    {
        return desired;
    }

    float2 displacement = desired - current;
    float desiredDistance = SampleBoundaryDistance(desired);
    float2 inwardNormal = SampleBoundaryNormal(desired);
    float normalLengthSq = dot(inwardNormal, inwardNormal);
    if (normalLengthSq > 0.0001)
    {
        float2 projected = desired + inwardNormal * (max(0.0, -desiredDistance) + 0.002);
        if (IsWalkable(projected))
        {
            return projected;
        }

        float outwardAmount = min(0.0, dot(displacement, inwardNormal));
        float2 slidePosition = current + displacement - inwardNormal * outwardAmount;
        if (IsWalkable(slidePosition))
        {
            return slidePosition;
        }
    }

    float2 xOnly = float2(desired.x, current.y);
    float2 yOnly = float2(current.x, desired.y);
    bool xValid = IsWalkable(xOnly);
    bool yValid = IsWalkable(yOnly);
    if (xValid && yValid)
    {
        return dot(xOnly - current, xOnly - current) >= dot(yOnly - current, yOnly - current) ? xOnly : yOnly;
    }

    return xValid ? xOnly : (yValid ? yOnly : current);
}

float2 ConstrainMove(float2 current, float2 desired)
{
    float2 displacement = desired - current;
    float distance = length(displacement);
    int stepCount = clamp((int)ceil(distance / max(_CellSize * 0.4, 0.05)), 1, 16);
    float2 step = displacement / (float)stepCount;
    float2 result = current;
    [loop]
    for (int stepIndex = 0; stepIndex < stepCount; stepIndex++)
    {
        result = ConstrainMoveStep(result, result + step);
    }
    return result;
}

[numthreads(64, 1, 1)]
void ApplyDynamicTargetCommands(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _DynamicTargetCommandCount)
    {
        return;
    }

    DynamicTargetCommand command = _DynamicTargetCommands[id.x];
    if (command.slot >= _DynamicTargetCapacity)
    {
        return;
    }

    DynamicTargetState state = _DynamicTargets[command.slot];
    if (command.operation == 1u)
    {
        state.position = command.position;
        state.health = command.health;
        state.maxHealth = command.maxHealth;
        state.radius = command.radius;
        state.axis = command.axis;
        state.segmentHalfLength = command.segmentHalfLength;
        state.halfDepth = command.halfDepth;
        state.blockCapacity = command.blockCapacity;
        state.armor = command.armor;
        state.physicalResistance = command.physicalResistance;
        state.fireResistance = command.fireResistance;
        state.slowResistance = command.slowResistance;
        state.thornsDamage = command.thornsDamage;
        state.slowMultiplier = 1.0;
        state.slowTimer = 0.0;
        state.burnDamagePerSecond = 0.0;
        state.burnTimer = 0.0;
        state.generation = command.generation;
        state.status = 1u;
        state.kind = command.kind;
        state.flags = 0u;
    }
    else if (state.generation == command.generation && command.operation == 2u)
    {
        state.position = command.position;
        state.radius = command.radius;
        state.axis = command.axis;
        state.segmentHalfLength = command.segmentHalfLength;
        state.halfDepth = command.halfDepth;
        state.blockCapacity = command.blockCapacity;
    }
    else if (state.generation == command.generation && command.operation == 3u)
    {
        state.status = 0u;
        state.health = 0.0;
    }

    _DynamicTargets[command.slot] = state;
}

[numthreads(64, 1, 1)]
void ClearDynamicTargetGrid(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _CellCount)
    {
        _DynamicTargetCellCounts[id.x] = 0u;
    }
    if (id.x < _DynamicTargetCapacity)
    {
        _DynamicTargetBlockedMass[id.x] = 0u;
        _DynamicTargetDamage[id.x] = 0u;
        _DynamicTargetLastAttacker[id.x] = 0u;
    }
    if (id.x == 0u)
    {
        _DynamicTargetActiveCount[0] = 0u;
    }
}

[numthreads(64, 1, 1)]
void BuildDynamicTargetGrid(uint3 id : SV_DispatchThreadID)
{
    uint targetIndex = id.x;
    if (targetIndex >= _DynamicTargetCapacity)
    {
        return;
    }

    DynamicTargetState state = _DynamicTargetsRead[targetIndex];
    int2 cell = WorldToCell(state.position);
    if (state.status != 1u || !IsInside(cell))
    {
        return;
    }

    uint activeSlot;
    InterlockedAdd(_DynamicTargetActiveCount[0], 1u, activeSlot);
    if (activeSlot < _DynamicTargetCapacity)
    {
        _DynamicTargetActiveIndices[activeSlot] = targetIndex;
    }

    uint cellIndex = CellIndex(cell);
    uint slot;
    InterlockedAdd(_DynamicTargetCellCounts[cellIndex], 1u, slot);
    if (slot < _DynamicTargetCellCapacity)
    {
        _DynamicTargetCellIndices[cellIndex * _DynamicTargetCellCapacity + slot] = targetIndex;
    }
}

[numthreads(64, 1, 1)]
void ResolveDynamicTargetDamage(uint3 id : SV_DispatchThreadID)
{
    uint targetIndex = id.x;
    if (targetIndex >= _DynamicTargetCapacity)
    {
        return;
    }

    DynamicTargetState state = _DynamicTargets[targetIndex];
    uint packedDamage = _DynamicTargetDamage[targetIndex];
    if (state.status != 1u || packedDamage == 0u)
    {
        return;
    }

    float rawDamage = packedDamage / 1024.0;
    float appliedDamage = max(0.0, rawDamage - state.armor) * (1.0 - saturate(state.physicalResistance));
    if (appliedDamage <= 0.0)
    {
        return;
    }

    state.health = max(0.0, state.health - appliedDamage);
    uint attackerToken = _DynamicTargetLastAttacker[targetIndex];
    int sourceIndex = -1;
    if (attackerToken > 0u && attackerToken <= _AgentCount)
    {
        sourceIndex = (int)_StatesInput[attackerToken - 1u].definitionIndex;
    }

    if (state.health <= 0.0)
    {
        state.status = 2u;
        EmitDetailedEvent(targetIndex, 4u, 0.0, state.generation, sourceIndex);
    }
    else
    {
        EmitDetailedEvent(targetIndex, 3u, state.health, state.generation, sourceIndex);
    }
    _DynamicTargets[targetIndex] = state;
}

[numthreads(64, 1, 1)]
void ApplySpawns(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _SpawnCount) return;
    uint index = _SpawnStart + id.x;
    AgentState state = _SpawnStates[id.x];
    state.stepStartPosition = state.position;
    _StatesRead[index] = state;
    _StatesWrite[index] = state;
    if (_SpawnHasControls != 0u) _SpawnControlsWrite[index] = _SpawnControls[id.x];
}

[numthreads(64, 1, 1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _CellCount)
    {
        _CellCounts[id.x] = 0;
    }
}

[numthreads(64, 1, 1)]
void ClearDiagnostics(uint3 id : SV_DispatchThreadID)
{
    if (id.x < 19)
    {
        _Diagnostics[id.x] = 0;
    }
}

[numthreads(64, 1, 1)]
void BuildGrid(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _AgentCount) return;
    AgentState state = _StatesRead[index];
    if (state.status != 1 || _Controls[index].y < 0.5)
    {
        // Active-only kernels never visit retired slots. Carry their final state
        // into the other buffer, or the next swap resurrects the old live body.
        _StatesWrite[index] = state;
        return;
    }

    int2 cell = WorldToCell(_StatesRead[index].position);
    if (!IsInside(cell))
    {
        _StatesWrite[index] = state;
        return;
    }

    uint cellIndex = CellIndex(cell);
    _SpatialStates[index] = float4(state.position, state.scale, max(0.1, state.mass));
    uint slot;
    InterlockedAdd(_CellCounts[cellIndex], 1, slot);
    uint activeSlot;
    InterlockedAdd(_Diagnostics[3], 1, activeSlot);
    _ActiveIndices[activeSlot] = index;
    InterlockedMax(_Diagnostics[2], slot + 1);
    if (slot < _CellCapacity)
    {
        _CellAgents[cellIndex * _CellCapacity + slot] = index;
    }
}

[numthreads(1, 1, 1)]
void FinalizeActiveDispatch(uint3 id : SV_DispatchThreadID)
{
    uint groupCount = (_Diagnostics[3] + 63u) / 64u;
    _ActiveDispatchArgs.Store(0, groupCount);
    _ActiveDispatchArgs.Store(4, 1u);
    _ActiveDispatchArgs.Store(8, 1u);
}

[numthreads(64, 1, 1)]
void ApplyDamageCommands(uint3 id : SV_DispatchThreadID)
{
    uint commandIndex = id.x;
    if (commandIndex >= _DamageCommandCount)
    {
        return;
    }

    DamageCommand command = _DamageCommands[commandIndex];
    if (command.index >= _AgentCount || command.damage <= 0.0)
    {
        return;
    }

    AgentState state = _StatesRead[command.index];
    if (state.status != 1 || state.health <= 0.0)
    {
        return;
    }

    float appliedDamage = max(0.0, command.damage - state.armor) * (1.0 - saturate(state.physicalResistance));
    state.health -= appliedDamage;
    if (state.health <= 0.0)
    {
        state.health = 0.0;
        state.status = 3;
        EmitEvent(command.index, 1u, appliedDamage);
        _StatesWrite[command.index] = state;
    }

    _StatesRead[command.index] = state;
}

[numthreads(64, 1, 1)]
void ApplyStatusCommands(uint3 id : SV_DispatchThreadID)
{
    uint commandIndex = id.x;
    if (commandIndex >= _StatusCommandCount)
    {
        return;
    }

    StatusCommand command = _StatusCommands[commandIndex];
    if (command.index >= _AgentCount)
    {
        return;
    }

    AgentState state = _StatesRead[command.index];
    if (state.status != 1 || state.health <= 0.0)
    {
        return;
    }

    if (command.slowDuration > 0.0)
    {
        state.slowMultiplier = min(state.slowMultiplier, command.slowMultiplier);
        state.slowTimer = max(state.slowTimer, command.slowDuration * (1.0 - saturate(state.slowResistance)));
    }

    if (command.burnDamagePerSecond > 0.0 && command.burnDuration > 0.0 && command.burnApplications > 0u)
    {
        uint existingStacks = (uint)round(state.burnDamagePerSecond / max(command.burnDamagePerSecond, 0.0001));
        uint nextStacks = min(max(1u, command.maxBurnStacks), existingStacks + command.burnApplications);
        state.burnDamagePerSecond = command.burnDamagePerSecond * nextStacks * (1.0 - saturate(state.fireResistance));
        state.burnTimer = max(state.burnTimer, command.burnDuration);
    }

    _StatesRead[command.index] = state;
}

// combatFlags bit 4: nothing pushes this body (the boss). maxPushMass > 0 also spares bodies
// heavier than it (the mammoth does not push Orc Brutes until upgraded).
// combatFlags bit 8: blockers (cavemen, the fighting mammoth) do not stop this body (the boss);
// each one it touches slows it by this share, down to the slowest, while it strikes them.
// TEMPORARY values until balancing.
#define PASS_BLOCKER_SLOW 0.15
#define PASS_BLOCKER_SLOWEST 0.25

bool PassesBlockers(AgentState state)
{
    return (state.combatFlags & 8u) != 0u;
}

bool CanBePushed(AgentState state, float maxPushMass)
{
    return (state.combatFlags & 4u) == 0u && (maxPushMass <= 0.0 || state.mass <= maxPushMass);
}

[numthreads(1, 1, 1)]
void ApplyAreaEffect(uint3 id : SV_DispatchThreadID)
{
    [loop]
    for (uint commandIndex = 0u; commandIndex < _AreaCommandCount; commandIndex++)
    {
        AreaEffectCommand command = _AreaEffectCommands[commandIndex];
        bool unlimitedCommand = command.maxTargets == 0u;
        bool hasCappedSlow = command.slowDuration > 0.0 && command.slowMultiplier < 0.995 &&
            command.slowCapacity > 0.0;
        if (unlimitedCommand && !hasCappedSlow)
        {
            continue;
        }

        int2 centerCell = WorldToCell(command.center);
        int cellRadius = max(1, (int)ceil(command.radius / _CellSize));
        float radiusSq = command.radius * command.radius;
        uint hitCount = 0u;
        float hitMass = 0.0;
        float usedSlowCapacity = 0.0;
        bool commandComplete = false;
        [loop]
        for (int oy = -cellRadius; oy <= cellRadius && !commandComplete; oy++)
        {
            [loop]
            for (int ox = -cellRadius; ox <= cellRadius && !commandComplete; ox++)
            {
                int2 cell = centerCell + int2(ox, oy);
                if (!IsInside(cell))
                {
                    continue;
                }

                uint cellIndex = CellIndex(cell);
                uint count = min(_CellCountsRead[cellIndex], _CellCapacity);
                [loop]
                for (uint slot = 0u; slot < count; slot++)
                {
                    uint agentIndex = _CellAgentsRead[cellIndex * _CellCapacity + slot];
                    AgentState state = _StatesRead[agentIndex];
                    if (state.status != 1 || state.health <= 0.0)
                    {
                        continue;
                    }

                    float2 offset = state.position - command.center;
                    float distanceSq = dot(offset, offset);
                    if (distanceSq > radiusSq)
                    {
                        continue;
                    }

                    bool applySlow = command.slowDuration > 0.0 && command.slowMultiplier < 0.995 &&
                        usedSlowCapacity + max(0.1, state.mass) <= command.slowCapacity;
                    bool hasOtherEffect = !unlimitedCommand &&
                        (command.damage > 0.0 || command.knockback > 0.0 || command.burnDamagePerSecond > 0.0);
                    if (!applySlow && !hasOtherEffect)
                    {
                        continue;
                    }

                    if (!IsAirborne(state))
                    {
                        hitMass += max(0.1, state.mass);
                    }

                    // A body it cannot push reports itself (event 8): the mammoth stops at it.
                    if (!unlimitedCommand && command.knockback > 0.0 && command.reportId != 0u &&
                        !IsAirborne(state) && !CanBePushed(state, command.maxPushMass))
                    {
                        EmitEvent(command.reportId, 8u, max(0.1, state.mass));
                    }

                    if (!unlimitedCommand && command.knockback > 0.0 && CanBePushed(state, command.maxPushMass))
                    {
                        float distance = sqrt(max(distanceSq, 0.000001));
                        float2 direction;
                        if (distanceSq > 0.000001)
                        {
                            direction = offset / distance;
                        }
                        else
                        {
                            float angle = frac((agentIndex + 1u) * 0.61803398875) * 6.2831853;
                            sincos(angle, direction.y, direction.x);
                        }
                        float falloff = 1.0 - saturate(distance / command.radius);
                        float2 addedVelocity = direction * command.knockback * lerp(2.5, 8.0, falloff);
                        state.knockbackVelocity += addedVelocity;
                        LaunchIntoAir(state, addedVelocity, command.launch);
                        state.padding = max(state.padding, clamp(command.knockback / 32.0, 0.55, 2.5));
                    }

                    if (!unlimitedCommand && command.damage > 0.0)
                    {
                        float appliedDamage = max(0.0, command.damage - state.armor) * (1.0 - saturate(state.physicalResistance));
                        state.health -= appliedDamage;
                        if (state.health <= 0.0)
                        {
                            state.health = 0.0;
                            state.status = 3;
                            EmitEvent(agentIndex, 1u, appliedDamage);
                        }
                        else
                        {
                            EmitEvent(agentIndex, 5u, appliedDamage);
                        }
                    }

                    if (!unlimitedCommand && state.status == 1 && command.burnDamagePerSecond > 0.0 && command.burnDuration > 0.0)
                    {
                        uint existingStacks = (uint)round(state.burnDamagePerSecond / max(command.burnDamagePerSecond, 0.0001));
                        uint nextStacks = min(max(1u, command.maxBurnStacks), existingStacks + 1u);
                        state.burnDamagePerSecond = command.burnDamagePerSecond * nextStacks * (1.0 - saturate(state.fireResistance));
                        state.burnTimer = max(state.burnTimer, command.burnDuration);
                    }

                    if (state.status == 1 && applySlow)
                    {
                        state.slowMultiplier = min(state.slowMultiplier, command.slowMultiplier);
                        state.slowTimer = max(state.slowTimer, command.slowDuration * (1.0 - saturate(state.slowResistance)));
                        usedSlowCapacity += max(0.1, state.mass);
                    }

                    _StatesRead[agentIndex] = state;
                    hitCount++;
                    if (command.maxTargets > 0u && hitCount >= command.maxTargets)
                    {
                        commandComplete = true;
                        break;
                    }
                }
            }
        }

        if (command.reportId != 0u)
        {
            EmitEvent(command.reportId, 7u, hitMass);
        }
    }
}

[numthreads(64, 1, 1)]
void ApplyUnlimitedAreaEffects(uint3 id : SV_DispatchThreadID)
{
    uint activeCount = _DiagnosticsRead[3];
    if (id.x >= activeCount)
    {
        return;
    }

    uint agentIndex = _ActiveIndicesRead[id.x];
    AgentState state = _StatesRead[agentIndex];
    if (state.status != 1u || state.health <= 0.0)
    {
        return;
    }

    [loop]
    for (uint commandIndex = 0u; commandIndex < _AreaCommandCount; commandIndex++)
    {
        AreaEffectCommand command = _AreaEffectCommands[commandIndex];
        if (command.maxTargets != 0u)
        {
            continue;
        }

        // A heal follows its Shaman (skipAgent - 1): the CPU does not know where it walks now.
        float2 effectCenter = command.center;
        if (command.heal > 0.0 && command.skipAgent != 0u)
        {
            AgentState healer = _StatesRead[command.skipAgent - 1u];
            if (healer.status != 1u)
            {
                continue;
            }

            effectCenter = healer.position;
        }

        float2 offset = state.position - effectCenter;
        float distanceSq = dot(offset, offset);
        float radiusSq = command.radius * command.radius;
        float effectiveInnerRadius = max(0.0, command.innerRadius);
        bool isPhysicsShockwave = command.innerRadius != 0.0;
        if (distanceSq > radiusSq || distanceSq < effectiveInnerRadius * effectiveInnerRadius)
        {
            continue;
        }

        if (command.heal > 0.0 && agentIndex + 1u != command.skipAgent && state.health < state.maxHealth)
        {
            float healed = min(command.heal, state.maxHealth - state.health);
            state.health += healed;
            EmitEvent(agentIndex, 9u, healed);
        }

        // A body this effect cannot push reports itself as event 8, so a caller can feel what it
        // ran into (the mammoth stops at an Orc Brute it cannot push, and at the boss).
        if (command.knockback > 0.0 && command.reportId != 0u && !IsAirborne(state) &&
            !CanBePushed(state, command.maxPushMass))
        {
            EmitEvent(command.reportId, 8u, max(0.1, state.mass));
        }

        if (command.knockback > 0.0 && CanBePushed(state, command.maxPushMass))
        {
            bool applyKnockback = true;
            float distance = sqrt(max(distanceSq, 0.000001));
            float2 direction;
            if (distanceSq > 0.000001)
            {
                direction = offset / distance;
            }
            else
            {
                float angle = frac((agentIndex + 1u) * 0.61803398875) * 6.2831853;
                sincos(angle, direction.y, direction.x);
            }

            float gameplayFalloff = 1.0;
            if (command.innerRadius <= 0.0)
            {
                float falloff = 1.0 - saturate(distance / command.radius);
                float smoothFalloff = falloff * falloff * (3.0 - 2.0 * falloff);
                gameplayFalloff = lerp(0.35, 1.0, smoothFalloff);
            }

            if (isPhysicsShockwave)
            {
                float noise = frac(sin((float)(agentIndex + 1u) * 12.9898 +
                    dot(command.center, float2(78.233, 37.719))) * 43758.5453);
                bool firstShockwaveContact =
                    state.shockwaveOutwardTimer <= 0.0 &&
                    state.shockwaveExposure < 0.05;
                applyKnockback = firstShockwaveContact ||
                    state.shockwaveOutwardTimer > 0.0;
                direction = Rotate2D(direction, (noise - 0.5) * 0.12);
                gameplayFalloff *= lerp(0.95, 1.05, frac(noise * 7.173));
                int2 shockwaveCell = WorldToCell(state.position);
                float localCrowd = IsInside(shockwaveCell)
                    ? saturate((float)_CellCountsRead[CellIndex(shockwaveCell)] / 32.0)
                    : 0.0;
                gameplayFalloff *= lerp(1.0, 1.35, localCrowd);
                gameplayFalloff *= lerp(1.0, 0.5, saturate(state.shockwaveExposure));
                state.shockwaveExposure = saturate(state.shockwaveExposure + 0.22);
                if (firstShockwaveContact)
                {
                    state.shockwaveCenter = command.center;
                    state.shockwaveReturnTimer = max(state.shockwaveReturnTimer, 12.0);
                    float rideSpeed = _ShockwavePropagationSpeed * lerp(0.88, 1.0, noise);
                    float remainingBoundaryDistance = max(0.0, SampleBoundaryDistance(state.position));
                    float2 boundaryNormal = SampleBoundaryNormal(state.position);
                    float radialWallAlignment = max(0.3, -dot(direction, boundaryNormal));
                    float remainingRideTime = remainingBoundaryDistance /
                        max(0.1, rideSpeed * radialWallAlignment);
                    // XPBD caps accepted travel per fixed tick. Keep the rider
                    // under wave control until a shared constraint ends the ride
                    // on actual impact.
                    remainingRideTime += 1.5;
                    state.shockwaveOutwardTimer = max(0.05, remainingRideTime);
                }
            }
            if (applyKnockback)
            {
                float inverseMass = rcp(max(1.0, state.mass));
                float2 addedVelocity = direction * command.knockback * gameplayFalloff * inverseMass;
                state.knockbackVelocity += addedVelocity;
                if (!isPhysicsShockwave)
                {
                    LaunchIntoAir(state, addedVelocity, command.launch);
                }
                state.padding = max(state.padding, clamp(command.knockback / 22.0, 1.5, 4.5));
            }
        }

        if (command.damage > 0.0)
        {
            float appliedDamage = max(0.0, command.damage - state.armor) *
                (1.0 - saturate(state.physicalResistance));
            state.health -= appliedDamage;
            if (state.health <= 0.0)
            {
                state.health = 0.0;
                state.status = 3u;
                RecordCorpse(state);
                EmitEvent(agentIndex, 1u, appliedDamage);
            }
            else
            {
                EmitEvent(agentIndex, 5u, appliedDamage);
            }
        }

        if (state.status == 1u && command.burnDamagePerSecond > 0.0 && command.burnDuration > 0.0)
        {
            uint existingStacks = (uint)round(state.burnDamagePerSecond / max(command.burnDamagePerSecond, 0.0001));
            uint nextStacks = min(max(1u, command.maxBurnStacks), existingStacks + 1u);
            state.burnDamagePerSecond = command.burnDamagePerSecond * nextStacks *
                (1.0 - saturate(state.fireResistance));
            state.burnTimer = max(state.burnTimer, command.burnDuration);
        }

        if (state.status != 1u)
        {
            break;
        }
    }

    _StatesRead[agentIndex] = state;
}

float DistancePointToSegmentSq(float2 samplePosition, float2 a, float2 b)
{
    float2 segment = b - a;
    float lengthSq = dot(segment, segment);
    if (lengthSq <= 0.000001)
    {
        return dot(samplePosition - a, samplePosition - a);
    }
    float t = saturate(dot(samplePosition - a, segment) / lengthSq);
    float2 nearest = a + segment * t;
    return dot(samplePosition - nearest, samplePosition - nearest);
}

// Orc Brutes (mass 3) and the boss count as heavy; Goblin Runners and Shamans do not.
#define HEAVY_TARGET_MASS 2.5

[numthreads(1, 1, 1)]
void ApplyProjectile(uint3 id : SV_DispatchThreadID)
{
    [loop]
    for (uint commandIndex = 0u; commandIndex < _ProjectileCommandCount; commandIndex++)
    {
        ProjectileCommand command = _ProjectileCommands[commandIndex];
        uint projectileSlot = command.projectileId % 2048u;
        if (command.resetHitCount != 0u)
        {
            _ProjectileHitCounts[projectileSlot] = 0u;
        }
        if (_ProjectileHitCounts[projectileSlot] >= command.maxHits)
        {
            continue;
        }
        float2 boundsMin = min(command.start, command.end) - command.radius;
        float2 boundsMax = max(command.start, command.end) + command.radius;
        int2 minCell = WorldToCell(boundsMin);
        int2 maxCell = WorldToCell(boundsMax);
        uint hitCount = _ProjectileHitCounts[projectileSlot];
        bool commandComplete = false;
        [loop]
        for (int y = minCell.y; y <= maxCell.y && !commandComplete; y++)
        {
            [loop]
            for (int x = minCell.x; x <= maxCell.x && !commandComplete; x++)
            {
                int2 cell = int2(x, y);
                if (!IsInside(cell))
                {
                    continue;
                }

                uint cellIndex = CellIndex(cell);
                uint count = min(_CellCountsRead[cellIndex], _CellCapacity);
                [loop]
                for (uint slot = 0u; slot < count; slot++)
                {
                    uint agentIndex = _CellAgentsRead[cellIndex * _CellCapacity + slot];
                    if (_AgentLastProjectileIds[agentIndex] == command.projectileId)
                    {
                        continue;
                    }
                    AgentState state = _StatesRead[agentIndex];
                    if (state.status != 1u || state.health <= 0.0 || ((state.flags & 1u) != 0u && command.canHitFlying == 0u))
                    {
                        continue;
                    }

                    float hitRadius = max(command.radius, state.scale * 0.62);
                    float distanceSq = command.mode == 0u
                        ? DistancePointToSegmentSq(state.position, command.start, command.end)
                        : dot(state.position - command.end, state.position - command.end);
                    if (distanceSq > hitRadius * hitRadius)
                    {
                        continue;
                    }

                    // padding.x: each goblin the shot passes through takes this share of what the one
                    // before took (the spear's pierce falloff); padding.y: the multiplier on heavy
                    // goblins (the big-game hunters). Zero means unused.
                    float hitKeep = command.padding.x > 0.0 ? command.padding.x : 1.0;
                    float heavyBonus = command.padding.y > 0.0 && state.mass >= HEAVY_TARGET_MASS ? command.padding.y : 1.0;
                    float hitDamage = command.damage * pow(hitKeep, (float)hitCount) * heavyBonus;
                    float appliedDamage = max(0.0, hitDamage - state.armor) * (1.0 - saturate(state.physicalResistance));
                    state.health = max(0.0, state.health - appliedDamage);
                    if (command.knockback > 0.0 && CanBePushed(state, 0.0))
                    {
                        float2 offset = state.position - command.end;
                        float offsetLength = length(offset);
                        float2 direction = offsetLength > 0.0001 ? offset / offsetLength : float2(1.0, 0.0);
                        state.knockbackVelocity += direction * command.knockback * 5.0;
                        state.padding = max(state.padding, 0.55);
                    }
                    if (state.health <= 0.0)
                    {
                        state.status = 3u;
                        RecordCorpse(state);
                        EmitEvent(agentIndex, 1u, appliedDamage);
                    }
                    else
                    {
                        EmitEvent(agentIndex, 5u, appliedDamage);
                        if (command.burnDamagePerSecond > 0.0 && command.burnDuration > 0.0)
                        {
                            uint existingStacks = (uint)round(state.burnDamagePerSecond / max(command.burnDamagePerSecond, 0.0001));
                            uint nextStacks = min(max(1u, command.maxBurnStacks), existingStacks + 1u);
                            state.burnDamagePerSecond = command.burnDamagePerSecond * nextStacks * (1.0 - saturate(state.fireResistance));
                            state.burnTimer = max(state.burnTimer, command.burnDuration);
                        }
                    }

                    _StatesRead[agentIndex] = state;
                    _AgentLastProjectileIds[agentIndex] = command.projectileId;
                    hitCount++;
                    _ProjectileHitCounts[projectileSlot] = hitCount;
                    if (command.maxHits > 0u && hitCount >= command.maxHits)
                    {
                        EmitEvent(command.projectileId, 6u, (float)hitCount);
                        commandComplete = true;
                        break;
                    }
                }
            }
        }
    }
}

void IntegrateXpbdBody(uint index, AgentState state, float4 control, float simulationDelta);

[numthreads(64, 1, 1)]
void Simulate(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _DiagnosticsRead[3])
    {
        return;
    }

    uint index = _ActiveIndicesRead[activeSlot];

    AgentState state = _StatesInput[index];
    float4 control = _Controls[index];
    if (control.y < 0.5)
    {
        state.status = 0;
        _StatesWrite[index] = state;
        return;
    }

    if (state.status != 1)
    {
        _StatesWrite[index] = state;
        return;
    }

    // Bit 0 is flying. Bit 1 is a transient renderer hint for a reserved
    // melee attacker and is recomputed every simulation step. Bit 2 marks a
    // shockwave body whose boundary/contact reflection is returning inward.
    state.flags &= 0xFFFFFFFDu;
    float simulationDelta = _DeltaTime;
    state.stepStartPosition = state.position;
    state.shockwaveOutwardTimer = max(0.0, state.shockwaveOutwardTimer);
    state.shockwaveExposure = max(0.0, state.shockwaveExposure - simulationDelta * 0.85);
    if (state.shockwaveOutwardTimer > 0.0)
    {
        state.shockwaveOutwardTimer = max(0.0, state.shockwaveOutwardTimer - simulationDelta);
    }
    bool shockwaveRiding = state.shockwaveOutwardTimer > 0.0;
    if (!shockwaveRiding)
    {
        state.shockwaveReturnTimer = max(
            0.0,
            state.shockwaveReturnTimer - simulationDelta);
        if (state.shockwaveReturnTimer <= 0.0)
            state.flags &= 0xFFFFFFFBu;
    }
    state.padding = max(0.0, state.padding - simulationDelta);
    if (state.padding <= 0.0)
        state.flags &= 0xFFFFFFFBu;
    // padding2 stores the dynamic blocker slot (+1) whose queue this body is
    // part of. Validate it every tick so removing that blocker releases the
    // remembered queue in this same dispatch.
    bool releasedBlockerThisTick = false;
    if (state.padding2 < -0.5)
        state.padding2 = 0.0;
    if (state.padding2 >= 1.0)
    {
        uint rememberedBlocker = (uint)round(state.padding2) - 1u;
        if (rememberedBlocker >= _DynamicTargetCapacity ||
            _DynamicTargetsRead[rememberedBlocker].status != 1u)
        {
            // -1 survives through contact finalization as a one-tick visual
            // release marker, then the next simulation step clears it above.
            state.padding2 = -1.0;
            releasedBlockerThisTick = true;
        }
    }

    if (state.slowTimer > 0.0)
    {
        state.slowTimer -= simulationDelta;
        if (state.slowTimer <= 0.0)
        {
            state.slowTimer = 0.0;
            state.slowMultiplier = 1.0;
        }
    }

    if (state.burnTimer > 0.0 && state.burnDamagePerSecond > 0.0)
    {
        state.health -= state.burnDamagePerSecond * simulationDelta;
        state.burnTimer -= simulationDelta;
        if (state.health <= 0.0)
        {
            state.health = 0.0;
            state.status = 3;
            EmitEvent(index, 1u, state.burnDamagePerSecond * simulationDelta);
            _StatesWrite[index] = state;
            return;
        }

        if (state.burnTimer <= 0.0)
        {
            state.burnTimer = 0.0;
            state.burnDamagePerSecond = 0.0;
        }
    }

    IntegrateXpbdBody(index, state, control, simulationDelta);
    return;
}

[numthreads(64, 1, 1)]
void QueryTargets(uint3 id : SV_DispatchThreadID)
{
    uint queryIndex = id.x;
    if (queryIndex >= _QueryCount)
    {
        return;
    }

    TargetQuery query = _TargetQueries[queryIndex];
    int2 center = WorldToCell(query.position);
    int cellRadius = max(1, (int)ceil(query.range / _CellSize));
    float rangeSq = query.range * query.range;
    TargetResult best;
    best.position = 0.0;
    best.velocity = 0.0;
    best.index = -1;
    best.score = -1e30;
    best.secondPosition = 0.0;
    best.secondVelocity = 0.0;
    best.secondIndex = -1;
    best.secondScore = -1e30;
    float bestDistanceSq = 1e30;
    float secondDistanceSq = 1e30;
    [loop]
    for (int oy = -cellRadius; oy <= cellRadius; oy++)
    {
        [loop]
        for (int ox = -cellRadius; ox <= cellRadius; ox++)
        {
            int2 cell = center + int2(ox, oy);
            if (!IsInside(cell))
            {
                continue;
            }

            uint cellIndex = CellIndex(cell);
            uint count = min(_CellCountsRead[cellIndex], _CellCapacity);
            [loop]
            for (uint slot = 0; slot < count; slot++)
            {
                uint agentIndex = _CellAgentsRead[cellIndex * _CellCapacity + slot];
                AgentState state = _StatesInput[agentIndex];
                float reservedDamage = max(0.0, _Controls[agentIndex].w);
                if (state.status != 1 || state.health - reservedDamage <= 0.001 ||
                    (int)agentIndex == query.excludedIndex ||
                    (query.canHitFlying == 0 && (state.flags & 1u) != 0))
                {
                    continue;
                }

                float2 delta = state.position - query.position;
                float distanceSq = dot(delta, delta);
                if (distanceSq > rangeSq)
                {
                    continue;
                }

                float score = -distanceSq;
                if (query.mode == 1u) score = state.progress;
                else if (query.mode == 2u) score = -state.progress;
                else if (query.mode == 3u) score = state.health - reservedDamage;
                if (best.index < 0 || score > best.score || (abs(score - best.score) < 0.0001 && distanceSq < bestDistanceSq))
                {
                    best.secondPosition = best.position;
                    best.secondVelocity = best.velocity;
                    best.secondIndex = best.index;
                    best.secondScore = best.score;
                    secondDistanceSq = bestDistanceSq;
                    best.position = state.position;
                    best.velocity = state.velocity;
                    best.index = (int)agentIndex;
                    best.score = score;
                    bestDistanceSq = distanceSq;
                }
                else if (best.secondIndex < 0 || score > best.secondScore ||
                    (abs(score - best.secondScore) < 0.0001 && distanceSq < secondDistanceSq))
                {
                    best.secondPosition = state.position;
                    best.secondVelocity = state.velocity;
                    best.secondIndex = (int)agentIndex;
                    best.secondScore = score;
                    secondDistanceSq = distanceSq;
                }
            }
        }
    }

    _TargetResults[queryIndex] = best;
}

[numthreads(1, 1, 1)]
void ClearVisibility(uint3 id : SV_DispatchThreadID)
{
    _IndirectArgs.Store(4, 0u);
    _LodIndirectArgs.Store(4, 0u);
    _VariantIndirectArgs.Store(4, 0u);
    _VariantLodIndirectArgs.Store(4, 0u);
}

[numthreads(64, 1, 1)]
void CullVisible(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _DiagnosticsRead[3])
    {
        return;
    }

    uint index = _ActiveIndicesRead[activeSlot];

    AgentState state = _StatesInput[index];
    if (state.status != 1)
    {
        return;
    }

    bool visible = true;
    if (_CullingEnabled != 0)
    {
        float4 clip = mul(_ViewProjection, float4(state.position.x, 0.0, state.position.y, 1.0));
        float margin = max(0.5, clip.w * 0.08);
        visible = clip.w > 0.0 && abs(clip.x) <= clip.w + margin && abs(clip.y) <= clip.w + margin;
    }

    if (visible)
    {
        uint visibleIndex;
        if (_GoblinVariantCulling >= 4u)
        {
            uint goblinVariant = index & 3u;
            if (goblinVariant == 0u)
            {
                _IndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
            }
            else if (goblinVariant == 1u)
            {
                _LodIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
            }
            else if (goblinVariant == 2u)
            {
                _VariantIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
            }
            else
            {
                _VariantLodIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
            }
            _VisibleIndices[_VisibleListCapacity * goblinVariant + visibleIndex] = index;
            InterlockedAdd(_Diagnostics[4], 1u);
            return;
        }

        bool secondGoblinModel = _GoblinVariantCulling != 0u && (index & 1u) != 0u;
        float cameraDistance = distance(state.position, _LodCameraPosition);
        float viewingDistance = sqrt(cameraDistance * cameraDistance + _LodProjection.x * _LodProjection.x);
        float projectedHeight = 2.4 * state.scale * _LodProjection.y /
            (_LodProjection.z > 0.5 ? 1.0 : max(0.1, viewingDistance));
        // Ground sprite cards already use the same mesh in both indirect draws.
        // Splitting them at a distance threshold changes draw order for coplanar
        // alpha-cut cards and produced a visible 8% size pop as a body crossed it.
        // Keep every card in the stable draw list; the model path retains its LOD.
        bool useLod = _SpriteCardRendering == 0u &&
            (_AnimatedGoblin != 0u ? projectedHeight < _LodProjection.w : cameraDistance > 32.0);
        if (_CullingEnabled != 0 && useLod)
        {
            if (secondGoblinModel)
            {
                _VariantLodIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
                _VisibleIndices[_VisibleListCapacity * 3u + visibleIndex] = index;
            }
            else
            {
                _LodIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
                _VisibleIndices[_VisibleListCapacity + visibleIndex] = index;
            }
        }
        else
        {
            if (secondGoblinModel)
            {
                _VariantIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
                _VisibleIndices[_VisibleListCapacity * 2u + visibleIndex] = index;
            }
            else
            {
                _IndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
                _VisibleIndices[visibleIndex] = index;
            }
        }
        InterlockedAdd(_Diagnostics[4], 1u);
    }
}

// -----------------------------------------------------------------------------
// XPBD crowd path
// -----------------------------------------------------------------------------

float XpbdBodyRadius(AgentState state)
{
    // state.scale sizes the full sprite card, including transparent padding.
    // Production contacts use the painted torso's radius instead. Lab bodies
    // retain their explicit disk diameter, independently of sprite artwork.
    return _XpbdUsePerBodyRadius != 0u
        ? max(_CollisionDiameter * 0.5, state.scale * _XpbdBodyRadiusPerVisualScale)
        : _CollisionDiameter * 0.5;
}

float XpbdPairDiameter(AgentState first, AgentState second)
{
    return _XpbdUsePerBodyRadius != 0u
        ? max(_CollisionDiameter, (first.scale + second.scale) * _XpbdBodyRadiusPerVisualScale)
        : _CollisionDiameter;
}

// Resolve outside the five-percent shell used to classify a shallow
// contact. This is collision skin, not a smaller diagnostic body: acceptance
// still measures the authored physical radius below. An eighteen-percent skin
// gives the fixed eight-pass Jacobi solve room to transmit sustained merge
// pressure before an authored disk becomes deeply intersecting.
float XpbdSolveDistance(float physicalDistance)
{
    return physicalDistance * 1.18;
}

void IntegrateXpbdBody(uint index, AgentState state, float4 control, float simulationDelta)
{
    int2 cell = WorldToCell(state.position);
    if (!IsInside(cell))
    {
        _StatesWrite[index] = state;
        return;
    }

    uint cellIndex = CellIndex(cell);
    if (_ExitEnabled != 0u && _FlowData[cellIndex].y >= 0.0 && _FlowData[cellIndex].y <= 0.001)
    {
        state.status = 2u;
        EmitEvent(index, 2u, 0.0);
        _StatesWrite[index] = state;
        return;
    }

    float2 centerOffset = _ArenaCenter - state.position;
    float centerLengthSq = dot(centerOffset, centerOffset);
    float2 flow = _CenterSeekingArena != 0u && centerLengthSq > 0.000001
        ? centerOffset * rsqrt(centerLengthSq)
        : FindNavigableFlow(state.position, SampleFlow(state.position));
    if (dot(flow, flow) < 0.0001) flow = float2(1.0, 0.0);
    bool shockwaveRiding = state.shockwaveOutwardTimer > 0.0;
    float desiredSpeed = max(0.0, control.x * _MovementSpeedMultiplier * state.slowMultiplier);
    float2 desiredVelocity = flow * min(desiredSpeed, _XpbdMaximumSpeed);
    if (shockwaveRiding) desiredVelocity = 0.0;
    bool releasedBlockerThisTick = state.padding2 < -0.5;

    // Blockers are static XPBD constraints, but their combat/reservation state
    // is still gameplay data. Reserve at most the target's declared mass and
    // stop only the combatant; contact pressure then forms the queue naturally
    // through the disk constraints behind it.
    int blockerIndex = -1;
    float closestBlockerDistanceSq = 1e30;
    float2 closestBlockerOffset = 0.0;
    float closestBlockerContact = 0.0;
    uint blockersInReach = 0u;
    uint activeTargetCount = min(_DynamicTargetActiveCountRead[0], _DynamicTargetCapacity);
    [loop]
    for (uint targetSlot = 0u; targetSlot < activeTargetCount; targetSlot++)
    {
        uint targetIndex = _DynamicTargetActiveIndicesRead[targetSlot];
        DynamicTargetState target = _DynamicTargetsRead[targetIndex];
        if (target.status != 1u || target.blockCapacity <= 0.0) continue;
        float axisLengthSq = dot(target.axis, target.axis);
        float alongTarget = axisLengthSq > 0.0001
            ? clamp(dot(state.position - target.position, target.axis),
                -target.segmentHalfLength, target.segmentHalfLength)
            : 0.0;
        float2 closestPoint = target.position + target.axis * alongTarget;
        float2 offset = closestPoint - state.position;
        float distanceSq = dot(offset, offset);
        // Engagement and physical contact must use the same body model. The
        // XPBD preventive shell can stop a body before the old sprite-scale
        // attack radius, leaving a valid blocker permanently untouched.
        float physicalContactDistance = XpbdBodyRadius(state) + max(0.05, target.halfDepth);
        // A blocker is a hard surface without a solve skin, so a body is in
        // reach once it is within a few centimetres of touching it. A wider
        // reach would also engage bodies that are only passing beside it.
        float attackRange = physicalContactDistance + 0.04;
        if (distanceSq <= attackRange * attackRange)
        {
            blockersInReach++;
        }

        if (distanceSq <= attackRange * attackRange && distanceSq < closestBlockerDistanceSq)
        {
            blockerIndex = (int)targetIndex;
            closestBlockerDistanceSq = distanceSq;
            closestBlockerOffset = offset;
            closestBlockerContact = physicalContactDistance;
        }
    }

    if (blockerIndex >= 0 && PassesBlockers(state))
    {
        // The boss walks on through blockers, slowed by each one it touches, and strikes the
        // nearest one on its way without taking any of its blocking room.
        uint targetIndex = (uint)blockerIndex;
        DynamicTargetState target = _DynamicTargetsRead[targetIndex];
        desiredVelocity *= max(PASS_BLOCKER_SLOWEST, 1.0 - PASS_BLOCKER_SLOW * (float)blockersInReach);
        state.attackTimer -= simulationDelta;
        if (state.attackTimer <= 0.0 && state.attackDamage > 0.0)
        {
            float targetMultiplier = target.kind == 0u
                ? state.wallDamageMultiplier
                : state.alliedDamageMultiplier;
            uint damageUnits = max(1u, (uint)round(
                state.attackDamage * max(0.0, targetMultiplier) * 1024.0));
            InterlockedAdd(_DynamicTargetDamage[targetIndex], damageUnits);
            uint previousAttacker;
            InterlockedExchange(_DynamicTargetLastAttacker[targetIndex], index + 1u, previousAttacker);
            state.attackTimer = max(0.15, state.attackInterval);
        }
    }
    else if (blockerIndex >= 0)
    {
        uint targetIndex = (uint)blockerIndex;
        DynamicTargetState target = _DynamicTargetsRead[targetIndex];
        state.padding2 = (float)(targetIndex + 1u);
        uint massUnits = max(1u, (uint)round(max(0.1, state.mass) * 1024.0));
        uint capacityUnits = max(1u, (uint)round(target.blockCapacity * 1024.0));
        // A bounded compare/exchange retry loop allowed eligible bodies to lose
        // reservation merely because more than eight GPU lanes contended at
        // once. Reserve once atomically, then roll back only a real capacity
        // overflow. With sufficient capacity the result is order-independent.
        uint observed;
        InterlockedAdd(_DynamicTargetBlockedMass[targetIndex], massUnits, observed);
        bool reserved = observed + massUnits <= capacityUnits;
        if (!reserved)
        {
            uint ignored;
            InterlockedAdd(_DynamicTargetBlockedMass[targetIndex], 0u - massUnits, ignored);
        }

        if (reserved)
        {
            // Reserving a blocker stops the advance only once the body touches
            // it. Closing the remaining gap keeps a fighter against the visible
            // surface instead of holding it a body-width short at the edge of
            // its attack range.
            float blockerDistance = sqrt(max(closestBlockerDistanceSq, 0.0));
            float blockerGap = blockerDistance - closestBlockerContact;
            if (blockerGap > 0.01 && blockerDistance > 0.0001)
            {
                float approachSpeed = min(max(length(desiredVelocity), 0.5),
                    blockerGap / max(simulationDelta, 0.0001));
                desiredVelocity = closestBlockerOffset / blockerDistance * approachSpeed;
            }
            else
            {
                desiredVelocity = 0.0;
            }
            // Reservation means this body is actively fighting, not merely
            // easing off its throttle. Keeping the incoming propulsion lets a
            // lone attacker slide around a circular blocker before its second
            // strike. Contact pressure from unreserved bodies still forms the
            // queue behind it.
            state.velocity = desiredVelocity;
            state.flags |= 2u;
            state.attackTimer -= simulationDelta;
            if (state.attackTimer <= 0.0 && state.attackDamage > 0.0)
            {
                float targetMultiplier = target.kind == 0u
                    ? state.wallDamageMultiplier
                    : state.alliedDamageMultiplier;
                uint damageUnits = max(1u, (uint)round(
                    state.attackDamage * max(0.0, targetMultiplier) * 1024.0));
                InterlockedAdd(_DynamicTargetDamage[targetIndex], damageUnits);
                uint previousAttacker;
                InterlockedExchange(_DynamicTargetLastAttacker[targetIndex], index + 1u, previousAttacker);
                state.attackTimer = max(0.15, state.attackInterval);

                if (target.thornsDamage > 0.0)
                {
                    float thornDamage = max(0.0, target.thornsDamage - state.armor) *
                        (1.0 - saturate(state.physicalResistance));
                    state.health = max(0.0, state.health - thornDamage);
                    if (state.health <= 0.0)
                    {
                        state.status = 3u;
                        RecordCorpse(state);
                        EmitEvent(index, 1u, thornDamage);
                        _StatesWrite[index] = state;
                        return;
                    }
                }

                if ((state.combatFlags & 2u) != 0u && target.kind == 1u)
                {
                    state.health = min(state.maxHealth, state.health + state.attackDamage);
                }
            }
        }
    }
    else if (state.padding2 >= 1.0)
    {
        state.padding2 = 0.0;
    }
    if (releasedBlockerThisTick)
    {
        // A combatant intentionally stores no propulsion while reserved. Give
        // it the current flow velocity on release so removing a blocker cannot
        // leave the front row waiting on the gentle crowd acceleration ramp.
        state.velocity = desiredVelocity;
    }
    // Once wave control releases a body, flow must retake it before the decaying
    // external channel can leave an interior row travelling outward while the
    // wall row is already returning. This scales the one shared profile value;
    // ordinary queues keep the gentle default acceleration.
    float effectiveFlowAcceleration = _FlowAcceleration *
        (state.shockwaveReturnTimer > 0.0 && !shockwaveRiding ? 12.0 : 1.0);
    float accelerationBlend = 1.0 - exp(-max(0.1, effectiveFlowAcceleration) * simulationDelta);
    state.velocity = lerp(state.velocity, desiredVelocity, accelerationBlend);
    state.velocity *= rcp(1.0 + max(0.01, _VelocityDamping) * simulationDelta);

    float2 impulse = _Impulses[index];
    _Impulses[index] = 0.0;
    state.knockbackVelocity += impulse;
    state.knockbackVelocity += float2(_Aux[1u + index * 2u], _Aux[2u + index * 2u]) * 0.000001;
    _Aux[1u + index * 2u] = 0;
    _Aux[2u + index * 2u] = 0;
    bool airborne = IsAirborne(state);
    if (airborne)
    {
        state.airSpeed -= AIR_GRAVITY * simulationDelta;
        state.airHeight += state.airSpeed * simulationDelta;
        if (state.airHeight <= 0.0)
        {
            state.airHeight = 0.0;
            state.airSpeed = 0.0;
            state.landingTimer = LANDING_SECONDS;
        }
    }
    else
    {
        state.landingTimer = max(0.0, state.landingTimer - simulationDelta);
    }
    // Little drag in the air; on landing the body skids to a stop quickly.
    float knockbackDamping = _KnockbackDamping > 0.0 ? _KnockbackDamping : 1.8;
    knockbackDamping = airborne ? AIR_DRAG : knockbackDamping * (state.landingTimer > 0.0 ? 3.0 : 1.0);
    state.knockbackVelocity *= exp(-simulationDelta * knockbackDamping);
    if (shockwaveRiding)
    {
        float2 shockwaveOffset = state.position - state.shockwaveCenter;
        float shockwaveDistanceSq = dot(shockwaveOffset, shockwaveOffset);
        float2 shockwaveDirection = shockwaveDistanceSq > 0.000001
            ? shockwaveOffset * rsqrt(shockwaveDistanceSq)
            : -flow;
        float noise = frac(sin((float)(index + 1u) * 12.9898 +
            dot(state.shockwaveCenter, float2(78.233, 37.719))) * 43758.5453);
        float rideSpeed = _ShockwavePropagationSpeed * lerp(0.88, 1.0, noise);
        float combinedOutwardSpeed = dot(
            state.velocity + state.knockbackVelocity,
            shockwaveDirection);
        state.knockbackVelocity += shockwaveDirection *
            (rideSpeed - combinedOutwardSpeed);
        state.padding = max(state.padding, 0.25);
    }
    // A body in the air does not walk, and may travel faster than the crowd's per-tick cap.
    float2 motion = ((airborne ? 0.0 : state.velocity) + state.knockbackVelocity) * simulationDelta;
    float maxTravel = max(0.005, _XpbdMaximumTravel);
    if (airborne) maxTravel = max(maxTravel, AIR_MAX_HORIZONTAL_SPEED * 1.05 * simulationDelta);
    float motionLength = length(motion);
    if (motionLength > maxTravel) motion *= maxTravel / motionLength;
    state.position += motion;
    _StatesWrite[index] = state;
}

[numthreads(64, 1, 1)]
void ClearXpbdGrid(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _CellCount)
    {
        _XpbdCellCounts[id.x] = 0u;
        _XpbdCellCursors[id.x] = 0u;
        _XpbdCellOffsets[id.x] = 0u;
    }
    if (id.x == 0u)
    {
        _XpbdCellOffsets[_CellCount] = 0u;
        _XpbdGridFailures[0] = 0u;
    }
}

[numthreads(64, 1, 1)]
void CountXpbdGrid(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _DiagnosticsRead[3]) return;
    uint index = _ActiveIndicesRead[activeSlot];
    AgentState state = _StatesRead[index];
    if (state.status != 1u) return;
    int2 cell = WorldToCell(state.position);
    if (IsInside(cell)) InterlockedAdd(_XpbdCellCounts[CellIndex(cell)], 1u);
}

groupshared uint XpbdScanScratch[256];

[numthreads(256, 1, 1)]
void ScanXpbdGridBlocks(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint index = groupId.x * 256u + groupThreadId.x;
    uint value = index < _CellCount ? _XpbdCellCounts[index] : 0u;
    XpbdScanScratch[groupThreadId.x] = value;
    for (uint offset = 1u; offset < 256u; offset <<= 1u)
    {
        GroupMemoryBarrierWithGroupSync();
        uint add = groupThreadId.x >= offset ? XpbdScanScratch[groupThreadId.x - offset] : 0u;
        GroupMemoryBarrierWithGroupSync();
        XpbdScanScratch[groupThreadId.x] += add;
    }
    GroupMemoryBarrierWithGroupSync();
    if (index < _CellCount) _XpbdCellOffsets[index] = XpbdScanScratch[groupThreadId.x] - value;
    if (groupThreadId.x == 255u) _XpbdBlockSums[groupId.x] = XpbdScanScratch[255];
}

[numthreads(256, 1, 1)]
void ScanXpbdGridBlockTotals(uint3 groupThreadId : SV_GroupThreadID)
{
    // Scan all block totals in shared-memory chunks, carrying the preceding
    // chunk's sum. Large authored maps must not stop at 256 blocks (65K cells).
    uint lane = groupThreadId.x;
    uint carry = 0u;
    for (uint baseIndex = 0u; baseIndex < _XpbdBlockCount; baseIndex += 256u)
    {
        uint index = baseIndex + lane;
        uint value = index < _XpbdBlockCount ? _XpbdBlockSums[index] : 0u;
        XpbdScanScratch[lane] = value;
        for (uint offset = 1u; offset < 256u; offset <<= 1u)
        {
            GroupMemoryBarrierWithGroupSync();
            uint add = lane >= offset ? XpbdScanScratch[lane - offset] : 0u;
            GroupMemoryBarrierWithGroupSync();
            XpbdScanScratch[lane] += add;
        }
        GroupMemoryBarrierWithGroupSync();
        if (index < _XpbdBlockCount)
            _XpbdBlockOffsets[index] = carry + XpbdScanScratch[lane] - value;
        carry += XpbdScanScratch[255];
        // All lanes must finish reading this chunk before the next overwrite.
        GroupMemoryBarrierWithGroupSync();
    }
}

[numthreads(256, 1, 1)]
void AddXpbdGridBlockOffsets(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _CellCount) return;
    _XpbdCellOffsets[id.x] += _XpbdBlockOffsets[id.x / 256u];
}

[numthreads(1, 1, 1)]
void FinalizeXpbdGrid(uint3 id : SV_DispatchThreadID)
{
    if (_CellCount > 0u)
        _XpbdCellOffsets[_CellCount] = _XpbdCellOffsets[_CellCount - 1u] + _XpbdCellCounts[_CellCount - 1u];
}

[numthreads(64, 1, 1)]
void ScatterXpbdGrid(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _DiagnosticsRead[3]) return;
    uint index = _ActiveIndicesRead[activeSlot];
    AgentState state = _StatesRead[index];
    if (state.status != 1u) return;
    int2 cell = WorldToCell(state.position);
    if (!IsInside(cell)) return;
    uint cellIndex = CellIndex(cell);
    uint localSlot;
    InterlockedAdd(_XpbdCellCursors[cellIndex], 1u, localSlot);
    uint destination = _XpbdCellOffsets[cellIndex] + localSlot;
    if (destination < _XpbdCellOffsets[_CellCount])
    {
        _XpbdCellAgents[destination] = index;
    }
    else
    {
        // This should be unreachable because the compact array has one entry
        // per live body. Keep it explicit so a future allocation regression is
        // a hard diagnostic rather than a silently missing neighbour.
        InterlockedAdd(_XpbdGridFailures[0], 1u);
    }
}

[numthreads(1, 1, 1)]
void ClearXpbdPairs(uint3 id : SV_DispatchThreadID)
{
    _XpbdPairCount[0] = 0u;
    _XpbdPairDispatchArgs.Store(0, 0u);
    _XpbdPairDispatchArgs.Store(4, 1u);
    _XpbdPairDispatchArgs.Store(8, 1u);
}

[numthreads(64, 1, 1)]
void BuildXpbdPairs(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _DiagnosticsRead[3]) return;
    uint index = _ActiveIndicesRead[activeSlot];
    AgentState state = _StatesRead[index];
    if (state.status != 1u) return;
    int2 center = WorldToCell(state.position);
    if (!IsInside(center)) return;
    // Corrections from one constraint can move a body into a different nearby
    // constraint during the eight Jacobi passes. Generate the immutable pair
    // set for the full per-tick relative travel envelope; a 1.25x diameter
    // query omitted second-ring pairs that could become deeply overlapping
    // before the grid was rebuilt on the next tick.
    float broadDistance = max(_CollisionDiameter, XpbdBodyRadius(state) * 2.0) +
        _XpbdMaximumTravel * 2.0;
    int radius = max(1, (int)ceil(broadDistance / _CellSize));
    [loop]
    for (int y = -radius; y <= radius; y++)
    {
        [loop]
        for (int x = -radius; x <= radius; x++)
        {
            int2 cell = center + int2(x, y);
            if (!IsInside(cell)) continue;
            uint cellIndex = CellIndex(cell);
            uint begin = _XpbdCellOffsets[cellIndex];
            uint end = _XpbdCellOffsets[cellIndex + 1u];
            [loop]
            for (uint slot = begin; slot < end; slot++)
            {
                uint otherIndex = _XpbdCellAgents[slot];
                if (otherIndex <= index) continue;
                AgentState other = _StatesRead[otherIndex];
                if (other.status != 1u) continue;
                float2 delta = other.position - state.position;
                float diameter = XpbdPairDiameter(state, other);
                float pairRange = diameter + _XpbdMaximumTravel * 2.0;
                if (dot(delta, delta) > pairRange * pairRange) continue;
                uint pairSlot;
                InterlockedAdd(_XpbdPairCount[0], 1u, pairSlot);
                if (pairSlot < _XpbdPairCapacity)
                {
                    XpbdPair pair;
                    pair.first = index;
                    pair.second = otherIndex;
                    pair.lambda = 0.0;
                    pair.padding = 0.0;
                    _XpbdPairs[pairSlot] = pair;
                }
                else
                {
                    InterlockedAdd(_Diagnostics[14], 1u);
                }
            }
        }
    }

    // Dynamic blockers use the same constraint list as disk contacts. The
    // compact active list has no per-cell cap, unlike the legacy target grid,
    // so a tight group of towers or barricades cannot make a blocker vanish.
    // The boss walks through them (PassesBlockers), so it gets no blocker contacts.
    uint activeTargetCount = PassesBlockers(state) ? 0u : min(_DynamicTargetActiveCount[0], _DynamicTargetCapacity);
    [loop]
    for (uint targetSlot = 0u; targetSlot < activeTargetCount; targetSlot++)
    {
        uint targetIndex = _DynamicTargetActiveIndices[targetSlot];
        DynamicTargetState target = _DynamicTargetsRead[targetIndex];
        if (target.status != 1u || target.blockCapacity <= 0.0) continue;
        float axisLengthSq = dot(target.axis, target.axis);
        float alongTarget = axisLengthSq > 0.0001
            ? clamp(dot(state.position - target.position, target.axis),
                -target.segmentHalfLength, target.segmentHalfLength)
            : 0.0;
        float2 closestTargetPoint = target.position + target.axis * alongTarget;
        float contactRadius = XpbdBodyRadius(state) + max(0.05, target.halfDepth);
        float2 targetDelta = state.position - closestTargetPoint;
        float targetPairRange = contactRadius + _XpbdMaximumTravel;
        if (dot(targetDelta, targetDelta) > targetPairRange * targetPairRange) continue;

        uint pairSlot;
        InterlockedAdd(_XpbdPairCount[0], 1u, pairSlot);
        if (pairSlot < _XpbdPairCapacity)
        {
            XpbdPair pair;
            pair.first = index;
            pair.second = targetIndex | 0x80000000u;
            pair.lambda = 0.0;
            pair.padding = 0.0;
            _XpbdPairs[pairSlot] = pair;
        }
        else
        {
            InterlockedAdd(_Diagnostics[14], 1u);
        }
    }
}

[numthreads(1, 1, 1)]
void FinalizeXpbdPairDispatch(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_XpbdPairCount[0], _XpbdPairCapacity);
    _XpbdPairDispatchArgs.Store(0, (count + 63u) / 64u);
    _XpbdPairDispatchArgs.Store(4, 1u);
    _XpbdPairDispatchArgs.Store(8, 1u);
}

[numthreads(64, 1, 1)]
void ClearXpbdCorrections(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _DiagnosticsRead[3]) return;
    uint index = _ActiveIndicesRead[activeSlot];
    _XpbdCorrectionX[index] = 0;
    _XpbdCorrectionY[index] = 0;
    _XpbdCorrectionCounts[index] = 0u;
    if (_XpbdResetLambdas != 0u)
    {
        _XpbdWallLambdas[index] = 0.0;
        _XpbdDeepContactMarked[index] = 0u;
    }
}

[numthreads(64, 1, 1)]
void SolveXpbdPairs(uint3 id : SV_DispatchThreadID)
{
    uint pairIndex = id.x;
    uint count = min(_XpbdPairCount[0], _XpbdPairCapacity);
    if (pairIndex >= count) return;
    XpbdPair pair = _XpbdPairs[pairIndex];
    AgentState first = _StatesRead[pair.first];
    if (first.status != 1u) return;
    bool isBlocker = (pair.second & 0x80000000u) != 0u;
    float2 firstGradient = 0.0;
    float2 secondGradient = 0.0;
    float constraint = 0.0;
    float inverseFirst = rcp(max(0.1, first.mass));
    float inverseSecond = 0.0;
    float deepContactWeight = 1.0;
    float contactStrength = 1.0;
    if (isBlocker)
    {
        uint targetIndex = pair.second & 0x7FFFFFFFu;
        DynamicTargetState target = _DynamicTargetsRead[targetIndex];
        if (target.status != 1u || target.blockCapacity <= 0.0) return;
        float axisLengthSq = dot(target.axis, target.axis);
        float alongTarget = axisLengthSq > 0.0001
            ? clamp(dot(first.position - target.position, target.axis),
                -target.segmentHalfLength, target.segmentHalfLength)
            : 0.0;
        float2 closestTargetPoint = target.position + target.axis * alongTarget;
        float2 targetDelta = first.position - closestTargetPoint;
        float distanceSq = dot(targetDelta, targetDelta);
        float distanceToTarget = sqrt(max(distanceSq, 0.00000001));
        float2 normal = distanceSq > 0.00000001
            ? targetDelta / distanceToTarget
            : float2(1.0, 0.0);
        // A static barricade is a hard surface, so its contact distance is the
        // physical one. The solve skin only gives crowd contacts room to relax.
        constraint = distanceToTarget -
            (XpbdBodyRadius(first) + max(0.05, target.halfDepth));
        firstGradient = normal;
    }
    else
    {
        AgentState second = _StatesRead[pair.second];
        if (second.status != 1u) return;
        contactStrength = min(ContactStrength(first), ContactStrength(second));
        if (contactStrength <= 0.0) return;
        float2 delta = second.position - first.position;
        float distanceSq = dot(delta, delta);
        float distanceToSecond = sqrt(max(distanceSq, 0.00000001));
        float2 normal = distanceSq > 0.00000001 ? delta / distanceToSecond :
            (pair.first < pair.second ? float2(1.0, 0.0) : float2(-1.0, 0.0));
        float physicalDiameter = XpbdPairDiameter(first, second);
        constraint = distanceToSecond - XpbdSolveDistance(physicalDiameter);
        // Prioritize a deeply intersecting torso over the surrounding shallow
        // contacts. Otherwise their Jacobi corrections can cancel at a merge
        // and leave the same pair embedded even though there is space to move.
        uint deepContactTicks = max(_XpbdDeepContactTicks[pair.first], _XpbdDeepContactTicks[pair.second]);
        deepContactWeight = distanceToSecond < physicalDiameter * 0.95
            ? 1.0 + 2.0 * saturate(((float)deepContactTicks - 3.0) * 0.25)
            : 1.0;
        firstGradient = -normal;
        secondGradient = normal;
        inverseSecond = rcp(max(0.1, second.mass));
        if (_ImpulseTransfer > 0.0 && constraint < 0.0)
        {
            // Overlapping bodies share only the knockback that exceeds a small
            // threshold along the contact normal, so a hit propagates through
            // the mass instead of leaving the neighbour untouched.
            float closing = dot(first.knockbackVelocity - second.knockbackVelocity, normal);
            float excess = closing - 0.5;
            if (excess > 0.0)
            {
                float exchange = _ImpulseTransfer * excess / max(0.000001, inverseFirst + inverseSecond);
                float2 firstDelta = -normal * exchange * inverseFirst;
                float2 secondDelta = normal * exchange * inverseSecond;
                const float knockbackScale = 1000000.0;
                InterlockedAdd(_Aux[1u + pair.first * 2u], (int)round(firstDelta.x * knockbackScale));
                InterlockedAdd(_Aux[2u + pair.first * 2u], (int)round(firstDelta.y * knockbackScale));
                InterlockedAdd(_Aux[1u + pair.second * 2u], (int)round(secondDelta.x * knockbackScale));
                InterlockedAdd(_Aux[2u + pair.second * 2u], (int)round(secondDelta.y * knockbackScale));
            }
        }
    }
    float appliedLambda;
    if (_XpbdContactCompliance <= 0.0)
    {
        // A hard unilateral contact only pushes overlapping bodies apart.
        // Accumulating a lambda while applying averaged Jacobi corrections
        // makes the lambda larger than the displacement actually accepted by
        // each body. On the next pass that mismatch produces a negative
        // correction which pulls the disks together again. Use classic hard
        // PBD for the default zero-compliance profile and reserve accumulated
        // XPBD lambdas for genuinely compliant contacts.
        if (constraint >= 0.0) return;
        appliedLambda = -constraint * deepContactWeight / max(0.000001, inverseFirst + inverseSecond);
        // The ordinary preventive shell remains gently Jacobi-averaged. Once
        // authored bodies cross the five-percent deep threshold, increase only
        // that unilateral repulsion so a rare cancelling pair cannot survive
        // for the thirteen ticks that define a persistent contact.
        pair.lambda = 0.0;
    }
    else
    {
        if (constraint >= 0.0 && pair.lambda <= 0.0) return;
        float alpha = _XpbdContactCompliance / max(0.000001, _DeltaTime * _DeltaTime);
        float deltaLambda = (-constraint - alpha * pair.lambda) /
            (inverseFirst + inverseSecond + alpha);
        float nextLambda = max(0.0, pair.lambda + deltaLambda);
        appliedLambda = nextLambda - pair.lambda;
        pair.lambda = nextLambda;
    }
    _XpbdPairs[pairIndex] = pair;
    appliedLambda *= contactStrength;
    float2 firstCorrection = firstGradient * appliedLambda * inverseFirst;
    float2 secondCorrection = secondGradient * appliedLambda * inverseSecond;
    const float fixedPointScale = 1000000.0;
    InterlockedAdd(_XpbdCorrectionX[pair.first], (int)round(clamp(firstCorrection.x, -8.0, 8.0) * fixedPointScale));
    InterlockedAdd(_XpbdCorrectionY[pair.first], (int)round(clamp(firstCorrection.y, -8.0, 8.0) * fixedPointScale));
    InterlockedAdd(_XpbdCorrectionCounts[pair.first], 1u);
    if (!isBlocker)
    {
        InterlockedAdd(_XpbdCorrectionX[pair.second], (int)round(clamp(secondCorrection.x, -8.0, 8.0) * fixedPointScale));
        InterlockedAdd(_XpbdCorrectionY[pair.second], (int)round(clamp(secondCorrection.y, -8.0, 8.0) * fixedPointScale));
        InterlockedAdd(_XpbdCorrectionCounts[pair.second], 1u);
    }
}

[numthreads(64, 1, 1)]
void SolveXpbdWalls(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _DiagnosticsRead[3]) return;
    uint index = _ActiveIndicesRead[activeSlot];
    AgentState state = _StatesRead[index];
    if (state.status != 1u) return;
    float constraint = SampleBoundaryDistance(state.position) -
        XpbdSolveDistance(XpbdBodyRadius(state));
    float2 normal = SampleBoundaryNormal(state.position);
    if (dot(normal, normal) < 0.000001) return;
    float inverseMass = rcp(max(0.1, state.mass));
    float appliedLambda;
    if (_XpbdWallCompliance <= 0.0)
    {
        if (constraint >= 0.0) return;
        appliedLambda = -constraint / max(0.000001, inverseMass);
        _XpbdWallLambdas[index] = 0.0;
    }
    else
    {
        float lambda = _XpbdWallLambdas[index];
        if (constraint >= 0.0 && lambda <= 0.0) return;
        float alpha = _XpbdWallCompliance / max(0.000001, _DeltaTime * _DeltaTime);
        float nextLambda = max(0.0, lambda + (-constraint - alpha * lambda) /
            (inverseMass + alpha));
        appliedLambda = nextLambda - lambda;
        _XpbdWallLambdas[index] = nextLambda;
    }
    float2 correction = normal * appliedLambda * inverseMass;
    const float fixedPointScale = 1000000.0;
    InterlockedAdd(_XpbdCorrectionX[index], (int)round(clamp(correction.x, -8.0, 8.0) * fixedPointScale));
    InterlockedAdd(_XpbdCorrectionY[index], (int)round(clamp(correction.y, -8.0, 8.0) * fixedPointScale));
    InterlockedAdd(_XpbdCorrectionCounts[index], 1u);
}

[numthreads(64, 1, 1)]
void ApplyXpbdCorrections(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _DiagnosticsRead[3]) return;
    uint index = _ActiveIndicesRead[activeSlot];
    AgentState state = _StatesRead[index];
    if (state.status != 1u)
    {
        _StatesWrite[index] = state;
        return;
    }
    float correctionCount = max(1.0, (float)_XpbdCorrectionCounts[index]);
    float jacobiDivisor = sqrt(correctionCount);
    // Mild weighted-Jacobi over-relaxation offsets the slow propagation of a
    // plain per-body average through long queues while retaining deterministic
    // fixed-point accumulation. The travel clamp remains the hard safety cap.
    const float jacobiRelaxation = 1.25;
    float2 correction = float2(_XpbdCorrectionX[index], _XpbdCorrectionY[index]) *
        (0.000001 * jacobiRelaxation / jacobiDivisor);
    float maximumCorrection = max(0.01, _XpbdMaximumTravel * 2.0);
    float correctionLength = length(correction);
    if (correctionLength > maximumCorrection) correction *= maximumCorrection / correctionLength;
    state.position += correction;
    float2 totalTravel = state.position - state.stepStartPosition;
    float totalTravelLength = length(totalTravel);
    if (totalTravelLength > _XpbdMaximumTravel)
    {
        state.position = state.stepStartPosition + totalTravel * (_XpbdMaximumTravel / totalTravelLength);
    }
    if (!IsWalkable(state.position)) state.position = ConstrainMove(state.stepStartPosition, state.position);
    if (_XpbdWallCompliance <= 0.0)
    {
        // The road boundary is static, so this final per-body projection has no
        // write conflict and need not be diluted by the number of neighbouring
        // disk constraints. It closes the small Jacobi residual at choke walls.
        float wallConstraint = SampleBoundaryDistance(state.position) -
            XpbdSolveDistance(XpbdBodyRadius(state));
        if (wallConstraint < 0.0)
        {
            float2 wallNormal = SampleBoundaryNormal(state.position);
            if (dot(wallNormal, wallNormal) > 0.000001)
            {
                state.position -= wallNormal * wallConstraint;
            }
        }
    }
    if (_XpbdFinalizePresentation != 0u)
    {
        float2 travel = state.position - state.stepStartPosition;
        float travelDistance = length(travel);
        // XPBD velocity is derived from accepted resolved travel. Retaining the
        // pre-contact propulsion velocity made a stopped queue drive its full
        // desired speed back into the same contacts every tick. Knockback stays
        // in its dedicated channel so the resolved travel is not applied twice.
        float2 acceptedVelocity = travel / max(_DeltaTime, 0.0001);
        float2 incomingCombinedVelocity = state.velocity + state.knockbackVelocity;
        bool hasExternalMotion = dot(state.knockbackVelocity, state.knockbackVelocity) > 0.000001 ||
            state.shockwaveReturnTimer > 0.0;
        if (hasExternalMotion)
        {
            // Preserve propulsion as its own controlled velocity and make the
            // external channel exactly the remainder accepted by contacts.
            // This lets wall/disk constraints reflect and transmit explosions
            // without turning their correction into next-tick propulsion.
            float propulsionSpeed = length(state.velocity);
            if (propulsionSpeed > _XpbdMaximumSpeed)
                state.velocity *= _XpbdMaximumSpeed / propulsionSpeed;
            float incomingSpeed = length(incomingCombinedVelocity);
            float acceptedSpeed = length(acceptedVelocity);
            float travelSpeedLimit = _XpbdMaximumTravel / max(_DeltaTime, 0.0001);
            bool onlyTravelLimited = incomingSpeed > travelSpeedLimit &&
                acceptedSpeed >= travelSpeedLimit * 0.99 &&
                dot(incomingCombinedVelocity, acceptedVelocity) >=
                    incomingSpeed * acceptedSpeed * 0.999;
            bool returningShockwave = (state.flags & 4u) != 0u && state.padding > 0.0;
            if (!onlyTravelLimited && !returningShockwave)
            {
                // Contact changed the accepted motion, so feed that response
                // back into the external channel. A pure per-tick travel cap is
                // different: preserve the remaining impulse for later ticks.
                state.knockbackVelocity = acceptedVelocity - state.velocity;
            }
            // A reflected shockwave must keep its decaying inward impulse while
            // a neighbouring disk temporarily blocks it. XPBD then transmits
            // that pressure through the row instead of deleting it in one tick.
        }
        else
        {
            float resolvedSpeed = length(acceptedVelocity);
            if (resolvedSpeed > _XpbdMaximumSpeed)
                acceptedVelocity *= _XpbdMaximumSpeed / resolvedSpeed;
            state.velocity = acceptedVelocity;
        }
        if (state.shockwaveOutwardTimer > 0.0)
        {
            float2 shockwaveDelta = state.position - state.shockwaveCenter;
            float shockwaveDistance = length(shockwaveDelta);
            float2 shockwaveDirection = shockwaveDistance > 0.0001
                ? shockwaveDelta / shockwaveDistance
                : float2(1.0, 0.0);
            float incomingOutwardSpeed = dot(incomingCombinedVelocity, shockwaveDirection);
            float acceptedOutwardSpeed = dot(acceptedVelocity, shockwaveDirection);
            float unconstrainedAcceptedSpeed = min(
                incomingOutwardSpeed,
                _XpbdMaximumTravel / max(_DeltaTime, 0.0001));
            bool receivedInwardContactCorrection =
                dot(correction, shockwaveDirection) < -0.0001;
            if (incomingOutwardSpeed > 0.1 &&
                (acceptedOutwardSpeed <= unconstrainedAcceptedSpeed * 0.5 ||
                    receivedInwardContactCorrection))
            {
                // A wall, blocker, or body constraint rejected the outward
                // ride by at least half. Reflect the actual pre-contact velocity
                // immediately; otherwise a dense contact chain turns around one
                // body at a time while wave control keeps pushing from behind.
                float2 reflectedVelocity = incomingCombinedVelocity -
                    2.0 * incomingOutwardSpeed * shockwaveDirection;
                state.knockbackVelocity = reflectedVelocity - state.velocity;
                state.shockwaveOutwardTimer = 0.0;
                state.flags |= 4u;
                state.padding = 0.32;
            }
        }
        if (SampleBoundaryDistance(state.position) <=
            XpbdSolveDistance(XpbdBodyRadius(state)) + 0.001)
        {
            // Earlier Jacobi passes normally place the body exactly on the
            // preventive wall shell. Reflect the accepted combined velocity at
            // that shell and store the change in the external channel.
            float2 wallNormal = SampleBoundaryNormal(state.position);
            float2 combinedVelocity = state.velocity + state.knockbackVelocity;
            float intoWall = dot(combinedVelocity, wallNormal);
            if (dot(wallNormal, wallNormal) > 0.000001)
            {
                if (state.shockwaveOutwardTimer > 0.0)
                {
                    // The constraint may already have converted this tick's
                    // accepted travel into an inward displacement. Contact with
                    // the preventive shell still ends outward wave control in
                    // that case; otherwise the rider remains controlled after
                    // it has visibly bounced.
                    if (intoWall < 0.0)
                    {
                        combinedVelocity -= 2.0 * intoWall * wallNormal;
                        state.knockbackVelocity = combinedVelocity - state.velocity;
                    }
                    state.shockwaveOutwardTimer = 0.0;
                    state.flags |= 4u;
                    state.padding = 0.32;
                }
            }
        }
        state.locomotionSpeed = travelDistance / max(_DeltaTime, 0.0001);
        state.presentationTime += _DeltaTime;
        if (travelDistance > 0.00001) state.animationDistance += travelDistance;
        float2 facing = travelDistance > 0.00001 ? travel / travelDistance : SampleFlow(state.position);
        if (dot(facing, facing) > 0.0001) state.facing = facing;
    }
    _StatesWrite[index] = state;
}

// Diagnostics measure the same compact grid and pair set that XPBD solved.
[numthreads(64, 1, 1)]
void MeasureXpbdGridDiagnostics(uint3 id : SV_DispatchThreadID)
{
    uint cellIndex = id.x;
    if (cellIndex >= _CellCount) return;
    InterlockedMax(_Diagnostics[2], _XpbdCellCounts[cellIndex]);
    if (cellIndex == 0u && _XpbdGridFailures[0] > 0u)
    {
        InterlockedAdd(_Diagnostics[14], _XpbdGridFailures[0]);
    }
}

[numthreads(64, 1, 1)]
void MeasureXpbdPairDiagnostics(uint3 id : SV_DispatchThreadID)
{
    uint pairIndex = id.x;
    uint pairCount = min(_XpbdPairCount[0], _XpbdPairCapacity);
    if (pairIndex == 0u && _XpbdPairCount[0] > _XpbdPairCapacity)
    {
        InterlockedAdd(_Diagnostics[14], _XpbdPairCount[0] - _XpbdPairCapacity);
    }
    if (pairIndex >= pairCount) return;

    XpbdPair pair = _XpbdPairs[pairIndex];
    AgentState first = _StatesRead[pair.first];
    if (first.status != 1u) return;
    bool isBlocker = (pair.second & 0x80000000u) != 0u;
    float diameter;
    float distanceToOther;
    if (isBlocker)
    {
        uint targetIndex = pair.second & 0x7FFFFFFFu;
        DynamicTargetState target = _DynamicTargetsRead[targetIndex];
        if (target.status != 1u || target.blockCapacity <= 0.0) return;
        float axisLengthSq = dot(target.axis, target.axis);
        float alongTarget = axisLengthSq > 0.0001
            ? clamp(dot(first.position - target.position, target.axis),
                -target.segmentHalfLength, target.segmentHalfLength)
            : 0.0;
        diameter = XpbdBodyRadius(first) + max(0.05, target.halfDepth);
        distanceToOther = distance(first.position, target.position + target.axis * alongTarget);
    }
    else
    {
        AgentState second = _StatesRead[pair.second];
        if (second.status != 1u) return;
        if (ContactStrength(first) < 1.0 || ContactStrength(second) < 1.0) return;
        diameter = XpbdPairDiameter(first, second);
        distanceToOther = distance(first.position, second.position);
    }
    // Active constraints use the solver's preventive contact shell. Shallow
    // and deep telemetry below continue to use the authored physical body.
    if (distanceToOther <= XpbdSolveDistance(diameter))
    {
        InterlockedAdd(_Diagnostics[11], 1u);
    }
    if (distanceToOther >= diameter) return;

    InterlockedAdd(_Diagnostics[12], 1u);
    float penetrationFraction = saturate((diameter - distanceToOther) / max(0.0001, diameter));
    InterlockedMax(_Diagnostics[6], (uint)round(penetrationFraction * 1000000.0));
    if (penetrationFraction > 0.05)
    {
        InterlockedAdd(_Diagnostics[13], 1u);
        InterlockedAdd(_Diagnostics[isBlocker ? 17u : 16u], 1u);
        uint prior;
        InterlockedCompareExchange(_XpbdDeepContactMarked[pair.first], 0u, 1u, prior);
        if (!isBlocker)
        {
            InterlockedCompareExchange(_XpbdDeepContactMarked[pair.second], 0u, 1u, prior);
        }
    }
    if (penetrationFraction > 0.005)
    {
        InterlockedAdd(_Diagnostics[5], 1u);
    }
}

// Wall contacts are constraints too. Measure them against the authored body
// radius so a center that remains technically walkable cannot hide a disk that
// is persistently embedded in the road boundary.
[numthreads(64, 1, 1)]
void MeasureXpbdBodyDiagnostics(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _Diagnostics[3]) return;
    uint index = _ActiveIndicesRead[activeSlot];
    AgentState state = _StatesRead[index];
    if (state.status != 1u) return;

    float radius = XpbdBodyRadius(state);
    float boundaryDistance = SampleBoundaryDistance(state.position);
    if (boundaryDistance <= XpbdSolveDistance(radius))
    {
        InterlockedAdd(_Diagnostics[11], 1u);
    }
    if (boundaryDistance >= radius) return;

    InterlockedAdd(_Diagnostics[12], 1u);
    float penetrationFraction = saturate((radius - boundaryDistance) / max(0.0001, radius));
    InterlockedMax(_Diagnostics[6], (uint)round(penetrationFraction * 1000000.0));
    if (penetrationFraction > 0.05)
    {
        InterlockedAdd(_Diagnostics[13], 1u);
        InterlockedAdd(_Diagnostics[18], 1u);
        uint prior;
        InterlockedCompareExchange(_XpbdDeepContactMarked[index], 0u, 1u, prior);
    }
    if (penetrationFraction > 0.005)
    {
        InterlockedAdd(_Diagnostics[5], 1u);
    }
}

// A deep contact is persistent only after it survives for more than 0.2 seconds
// of fixed simulation time. Keeping the streak on the GPU makes the definition
// independent of diagnostic readback frequency and rendered frame scheduling.
[numthreads(64, 1, 1)]
void FinalizeXpbdPersistentContacts(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _Diagnostics[3]) return;
    uint index = _ActiveIndicesRead[activeSlot];
    uint streak = _XpbdDeepContactMarked[index] != 0u
        ? min(_XpbdDeepContactTicks[index] + 1u, 0xFFFFFFFEu)
        : 0u;
    _XpbdDeepContactTicks[index] = streak;
    if (streak > 12u)
    {
        InterlockedAdd(_Diagnostics[15], 1u);
    }
}
