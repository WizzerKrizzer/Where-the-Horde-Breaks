struct AgentState
{
    float2 position;
    float2 velocity;
    float2 knockbackVelocity;
    float scale;
    float tint;
    uint status;
    float padding;
    float health;
    float progress;
    uint flags;
    float padding2;
    float slowMultiplier;
    float slowTimer;
    float burnDamagePerSecond;
    float burnTimer;
    float mass;
    float shockwaveExposure;
    float2 shockwaveCenter;
    float shockwaveOutwardTimer;
    float shockwaveReturnTimer;
    float maxHealth;
    float armor;
    float physicalResistance;
    float fireResistance;
    float slowResistance;
    float attackDamage;
    float attackInterval;
    float wallDamageMultiplier;
    float alliedDamageMultiplier;
    float attackTimer;
    uint combatFlags;
    uint definitionIndex;
    float animationDistance;
    float2 facing;
    float2 stepStartPosition;
    float locomotionSpeed;
    float presentationTime;
    // Thrown by a blast: height above the road, upward speed, and the time left until
    // contacts with the crowd are fully back after landing.
    float airHeight;
    float airSpeed;
    float landingTimer;
};

struct XpbdPair
{
    uint first;
    uint second;
    float lambda;
    float padding;
};

struct TargetQuery
{
    float2 position;
    float range;
    uint mode;
    uint canHitFlying;
    int excludedIndex;
    float2 padding;
};

struct TargetResult
{
    float2 position;
    float2 velocity;
    int index;
    float score;
    float2 secondPosition;
    float2 secondVelocity;
    int secondIndex;
    float secondScore;
};

struct DamageCommand
{
    uint index;
    float damage;
    float2 padding;
};

struct HordeEvent
{
    uint index;
    uint type;
    float value;
    uint generation;
    int sourceIndex;
    float padding;
};

struct DynamicTargetState
{
    float2 position;
    float health;
    float maxHealth;
    float radius;
    float2 axis;
    float segmentHalfLength;
    float halfDepth;
    float blockCapacity;
    float armor;
    float physicalResistance;
    float fireResistance;
    float slowResistance;
    float thornsDamage;
    float slowMultiplier;
    float slowTimer;
    float burnDamagePerSecond;
    float burnTimer;
    uint generation;
    uint status;
    uint kind;
    uint flags;
};

struct DynamicTargetCommand
{
    uint slot;
    uint generation;
    uint operation;
    uint kind;
    float2 position;
    float health;
    float maxHealth;
    float radius;
    float2 axis;
    float segmentHalfLength;
    float halfDepth;
    float blockCapacity;
    float armor;
    float physicalResistance;
    float fireResistance;
    float slowResistance;
    float thornsDamage;
    float padding;
};

struct StatusCommand
{
    uint index;
    float slowMultiplier;
    float slowDuration;
    float burnDamagePerSecond;
    float burnDuration;
    uint maxBurnStacks;
    uint burnApplications;
    float padding;
};

struct AreaEffectCommand
{
    float2 center;
    float radius;
    float damage;
    float knockback;
    uint maxTargets;
    float burnDamagePerSecond;
    float burnDuration;
    uint maxBurnStacks;
    float slowMultiplier;
    float slowDuration;
    float slowCapacity;
    float innerRadius;
    // How strongly the blast throws bodies upwards: upward speed per unit of knockback speed.
    // 0 keeps them on the ground.
    float launch;
    // When not 0, the kernel reports the mass of grounded bodies it hit as event 7 with this
    // id, so a caller can feel how much it ran into (the mammoth slows down in a crowd).
    uint reportId;
    // Bodies heavier than this are hit but not pushed or thrown; 0 pushes every weight.
    float maxPushMass;
    // Health given back to each living body in the area, up to its maximum (the Shaman), with
    // event 9; skipAgent - 1 is left out (the healer itself), 0 leaves no one out.
    float heal;
    uint skipAgent;
};

struct ProjectileCommand
{
    float2 start;
    float2 end;
    float radius;
    float damage;
    float knockback;
    uint maxHits;
    uint canHitFlying;
    uint mode;
    float burnDamagePerSecond;
    float burnDuration;
    uint maxBurnStacks;
    uint projectileId;
    uint resetHitCount;
    float2 padding;
};

// Bodies thrown by a blast fly in an arc. In the air they pass over the crowd without
// contacts, so a blast in a jammed road still has somewhere to send them. After landing,
// their contacts come back gradually over LANDING_SECONDS, so a body landing on others is
// eased apart instead of popping its neighbours.
#define AIR_GRAVITY 15.7
#define AIR_LAUNCH_MIN_SPEED 2.0
#define AIR_MAX_LAUNCH_SPEED 8.0
#define AIR_MAX_HORIZONTAL_SPEED 4.5
#define AIR_DRAG 0.6
#define LANDING_SECONDS 0.45

bool IsAirborne(AgentState state)
{
    return state.airHeight > 0.0 || state.airSpeed > 0.0;
}

// 0 in the air, rising from 0.1 to 1 while landing, 1 on the ground.
float ContactStrength(AgentState state)
{
    if (IsAirborne(state)) return 0.0;
    return state.landingTimer > 0.0
        ? lerp(0.1, 1.0, saturate(1.0 - state.landingTimer / LANDING_SECONDS))
        : 1.0;
}

void LaunchIntoAir(inout AgentState state, float2 addedVelocity, float launch)
{
    if (launch <= 0.0) return;
    // Already in the air: another hit does not throw it higher (a beast running over thrown
    // bodies would otherwise juggle them), but its speed stays capped.
    if (!IsAirborne(state))
    {
        float speed = length(addedVelocity);
        if (speed < AIR_LAUNCH_MIN_SPEED) return;
        state.airSpeed = min(AIR_MAX_LAUNCH_SPEED, speed * launch);
        state.airHeight = 0.001;
        state.landingTimer = 0.0;
    }
    float horizontal = length(state.knockbackVelocity);
    if (horizontal > AIR_MAX_HORIZONTAL_SPEED)
    {
        state.knockbackVelocity *= AIR_MAX_HORIZONTAL_SPEED / horizontal;
    }
}

