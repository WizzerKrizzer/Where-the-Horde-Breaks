struct AgentState
{
    float2 position;
    float2 velocity;
    float2 knockbackVelocity;
    float scale;
    float tint;
    uint status;
    float padding;
    float health;
    float progress;
    uint flags;
    float padding2;
    float slowMultiplier;
    float slowTimer;
    float burnDamagePerSecond;
    float burnTimer;
    float mass;
    float shockwaveExposure;
    float2 shockwaveCenter;
    float shockwaveOutwardTimer;
    float shockwaveReturnTimer;
    float maxHealth;
    float armor;
    float physicalResistance;
    float fireResistance;
    float slowResistance;
    float attackDamage;
    float attackInterval;
    float wallDamageMultiplier;
    float alliedDamageMultiplier;
    float attackTimer;
    uint combatFlags;
    uint definitionIndex;
    float animationDistance;
    float2 facing;
    float2 stepStartPosition;
    float locomotionSpeed;
    float presentationTime;
};

struct TargetQuery
{
    float2 position;
    float range;
    uint mode;
    uint canHitFlying;
    int excludedIndex;
    float2 padding;
};

struct TargetResult
{
    float2 position;
    float2 velocity;
    int index;
    float score;
    float2 secondPosition;
    float2 secondVelocity;
    int secondIndex;
    float secondScore;
};

struct DamageCommand
{
    uint index;
    float damage;
    float2 padding;
};

struct HordeEvent
{
    uint index;
    uint type;
    float value;
    uint generation;
    int sourceIndex;
    float padding;
};

struct DynamicTargetState
{
    float2 position;
    float health;
    float maxHealth;
    float radius;
    float2 axis;
    float segmentHalfLength;
    float halfDepth;
    float blockCapacity;
    float armor;
    float physicalResistance;
    float fireResistance;
    float slowResistance;
    float thornsDamage;
    float slowMultiplier;
    float slowTimer;
    float burnDamagePerSecond;
    float burnTimer;
    uint generation;
    uint status;
    uint kind;
    uint flags;
};

struct DynamicTargetCommand
{
    uint slot;
    uint generation;
    uint operation;
    uint kind;
    float2 position;
    float health;
    float maxHealth;
    float radius;
    float2 axis;
    float segmentHalfLength;
    float halfDepth;
    float blockCapacity;
    float armor;
    float physicalResistance;
    float fireResistance;
    float slowResistance;
    float thornsDamage;
    float padding;
};

struct StatusCommand
{
    uint index;
    float slowMultiplier;
    float slowDuration;
    float burnDamagePerSecond;
    float burnDuration;
    uint maxBurnStacks;
    uint burnApplications;
    float padding;
};

struct AreaEffectCommand
{
    float2 center;
    float radius;
    float damage;
    float knockback;
    uint maxTargets;
    float burnDamagePerSecond;
    float burnDuration;
    uint maxBurnStacks;
    float slowMultiplier;
    float slowDuration;
    float slowCapacity;
    float innerRadius;
};

struct ProjectileCommand
