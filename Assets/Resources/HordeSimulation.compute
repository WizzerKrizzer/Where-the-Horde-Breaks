void EmitDetailedEvent(uint objectIndex, uint eventType, float value, uint generation, int sourceIndex)
{
    uint eventIndex;
    InterlockedAdd(_EventCount[0], 1, eventIndex);
    if (eventIndex < _EventCapacity)
    {
        HordeEvent result;
        result.index = objectIndex;
        result.type = eventType;
        result.value = value;
        result.generation = generation;
        result.sourceIndex = sourceIndex;
        result.padding = 0.0;
        _HordeEvents[eventIndex] = result;
    }
}

void EmitEvent(uint agentIndex, uint eventType, float value)
{
    EmitDetailedEvent(agentIndex, eventType, value, 0u, -1);
}

int2 WorldToCell(float2 position)
{
    return (int2)floor((position - _GridOrigin) / _CellSize);
}

bool IsInside(int2 cell)
{
    return all(cell >= 0) && cell.x < _GridSize.x && cell.y < _GridSize.y;
}

uint CellIndex(int2 cell)
{
    return (uint)(cell.y * _GridSize.x + cell.x);
}

float MaximumPairDiameter()
{
    return max(_AnimatedGoblin != 0u ? _MaximumGoblinDiameter : 0.0,
        _CollisionDiameter * (_CenterSeekingArena != 0u ? 1.65 : 1.55));
}

float PairCollisionDiameter(float selfScale, float otherScale)
{
    // ContactRadiusPerScale already covers the measured running envelope.  A
    // small numerical skin prevents pixel-level intersections without turning
    // every neighbour into a visibly detached circle.
    float silhouetteSkin = _CenterSeekingArena != 0u ? 1.03 : 1.01;
    float minimumDiameter = _CollisionDiameter * (_CenterSeekingArena != 0u
        ? 0.84
        : _MinimumContactDiameterMultiplier);
    if (_AnimatedGoblin != 0u)
        return max(minimumDiameter, (selfScale + otherScale) * _BodyRadiusPerScale * silhouetteSkin);
    return clamp(
        (selfScale + otherScale) * _BodyRadiusPerScale * silhouetteSkin,
        minimumDiameter,
        MaximumPairDiameter());
}

float MovementPairDiameter(float selfScale, float otherScale)
{
    // Large waves need a tight visual packing; small tactical groups retain the
    // wider approach skin that prevents stop/start jitter in precision tests.
    float approachSkin = _ReferenceCrowd != 0u ? 1.0 : (_AgentCount >= 2500u ? 1.015 : 1.06);
    return PairCollisionDiameter(selfScale, otherScale) * approachSkin;
}

float ContactPairDiameter(float selfScale, float otherScale)
{
    return PairCollisionDiameter(selfScale, otherScale);
}

float MotionContactGap(float distance, float selfScale, float otherScale, bool releasedTogether)
{
    float hardGap = distance - PairCollisionDiameter(selfScale, otherScale) * 1.002;
    // Release uses the hard gap so a common translation starts immediately.
    // Other ticks restore the air gap in the motion proposal; feasibility then
    // accepts only the part that cannot create another intersection.
    if (releasedTogether) return hardGap;
    float approachGap = distance - MovementPairDiameter(selfScale, otherScale);
    return approachGap < 0.0 ? approachGap : approachGap * _DeltaTime / max(_DeltaTime, 0.3);
}

float BoundaryDistanceAt(int2 cell)
{
    if (!IsInside(cell))
    {
        return -_CellSize;
    }

    return _FlowData[CellIndex(cell)].w;
}

float SampleBoundaryDistance(float2 position)
{
    float2 grid = (position - _GridOrigin) / _CellSize - 0.5;
    int2 baseCell = (int2)floor(grid);
    float2 t = frac(grid);
    int2 bottomRightCell = baseCell + int2(1, 0);
    int2 topLeftCell = baseCell + int2(0, 1);
    int2 topRightCell = baseCell + int2(1, 1);
    float bottomLeft = BoundaryDistanceAt(baseCell);
    float bottomRight = BoundaryDistanceAt(bottomRightCell);
    float topLeft = BoundaryDistanceAt(topLeftCell);
    float topRight = BoundaryDistanceAt(topRightCell);
    float bottom = lerp(bottomLeft, bottomRight, t.x);
    float top = lerp(topLeft, topRight, t.x);
    return lerp(bottom, top, t.y);
}

float2 SampleBoundaryNormal(float2 position)
{
    float offset = _CellSize * 0.5;
    float2 gradient = float2(
        SampleBoundaryDistance(position + float2(offset, 0.0)) -
            SampleBoundaryDistance(position - float2(offset, 0.0)),
        SampleBoundaryDistance(position + float2(0.0, offset)) -
            SampleBoundaryDistance(position - float2(0.0, offset)));
    float lengthSq = dot(gradient, gradient);
    return lengthSq > 0.000001 ? gradient * rsqrt(lengthSq) : float2(0.0, 0.0);
}

bool IsWalkable(float2 position)
{
    return IsInside(WorldToCell(position)) && SampleBoundaryDistance(position) >= 0.0;
}

float4 GetFlowVector(int2 cell)
{
    if (!IsInside(cell) || _FlowData[CellIndex(cell)].y < 0.0)
    {
        return 0.0;
    }

    return _FlowVectors[CellIndex(cell)];
}

float CellOccupancy(int2 cell)
{
    return IsInside(cell) ? (float)_CellCountsRead[CellIndex(cell)] : 0.0;
}

float PressureOccupancy(int2 cell)
{
    // Road boundaries are handled by signed-distance contacts. Filling every
    // outside cell with imaginary bodies repels goblins up to two grid cells
    // (~1.2m) before the actual edge, leaving an invisible empty border.
    return IsInside(cell) && _FlowData[CellIndex(cell)].y >= 0.0
        ? CellOccupancy(cell)
        : (_AnimatedGoblin != 0u ? 0.0 : (float)_CellCapacity);
}

float SmoothedSideOccupancy(int2 cell, int2 offset, int2 tangent)
{
    int2 side = cell + offset;
    return PressureOccupancy(side) +
        (PressureOccupancy(side + tangent) + PressureOccupancy(side - tangent)) * 0.5;
}

float2 SampleFlow(float2 position)
{
    float2 grid = (position - _GridOrigin) / _CellSize - 0.5;
    int2 baseCell = (int2)floor(grid);
    float2 t = frac(grid);
    float2 a = lerp(GetFlowVector(baseCell).xy, GetFlowVector(baseCell + int2(1, 0)).xy, t.x);
    float2 b = lerp(GetFlowVector(baseCell + int2(0, 1)).xy, GetFlowVector(baseCell + int2(1, 1)).xy, t.x);
    float2 direction = lerp(a, b, t.y);
    float lengthSq = dot(direction, direction);
    return lengthSq > 0.000001 ? direction * rsqrt(lengthSq) : float2(0.0, 0.0);
}

float SamplePotential(float2 position)
{
    int2 cell = WorldToCell(position);
    return IsInside(cell) && _FlowData[CellIndex(cell)].y >= 0.0
        ? _FlowData[CellIndex(cell)].z
        : 0.0;
}

float SampleIntegration(float2 position)
{
    int2 cell = WorldToCell(position);
    return IsInside(cell) && _FlowData[CellIndex(cell)].y >= 0.0
        ? _FlowData[CellIndex(cell)].y
        : 1e20;
}

float2 Rotate2D(float2 value, float radians)
{
    float sine;
    float cosine;
    sincos(radians, sine, cosine);
    return float2(value.x * cosine - value.y * sine, value.x * sine + value.y * cosine);
}

float2 FindNavigableFlow(float2 position, float2 preferred)
{
    float probeDistance = _CellSize * 0.7;
    if (IsWalkable(position + preferred * probeDistance))
    {
        return preferred;
    }

    float currentIntegration = SampleIntegration(position);
    float2 best = preferred;
    float bestScore = -1e20;
    [unroll]
    for (int step = 1; step <= 4; step++)
    {
        float angle = radians(step * 22.5);
        float2 candidates[2] = { Rotate2D(preferred, angle), Rotate2D(preferred, -angle) };
        [unroll]
        for (int side = 0; side < 2; side++)
        {
            float2 candidate = candidates[side];
            float2 probe = position + candidate * probeDistance;
            if (!IsWalkable(probe))
            {
                continue;
            }

            // Integration always decreases towards the exit. It resolves the
            // otherwise symmetric up/down choice at square corners without relying
            // on the expensive harmonic potential used by irregular routes.
            float progress = currentIntegration - SampleIntegration(probe);
            float2 probeFlow = SampleFlow(probe);
            float routeAlignment = dot(probeFlow, probeFlow) > 0.0001
                ? dot(candidate, probeFlow)
                : 0.0;
            // The reference horde does not continually optimize a shortest path.
            // A runner carries its current direction until the environment blocks
            // it; only then does this choose a locally valid branch. The nearby
            // route vector wins that choice, while integration is merely a weak
            // tie-breaker for dead ends and split roads.
            float score = _ReferenceCrowd != 0u
                ? routeAlignment * 3.0 + dot(candidate, preferred) * 0.7 + progress * 0.2
                : progress * 6.0 + routeAlignment * 1.25 + dot(candidate, preferred) * 0.2;
            if (score > bestScore)
            {
                bestScore = score;
                best = candidate;
            }
        }
    }

    return best;
}

float2 ConstrainMoveStep(float2 current, float2 desired)
{
    if (IsWalkable(desired))
    {
        return desired;
    }

    float2 displacement = desired - current;
    float desiredDistance = SampleBoundaryDistance(desired);
    float2 inwardNormal = SampleBoundaryNormal(desired);
    float normalLengthSq = dot(inwardNormal, inwardNormal);
    if (normalLengthSq > 0.0001)
    {
        float2 projected = desired + inwardNormal * (max(0.0, -desiredDistance) + 0.002);
        if (IsWalkable(projected))
        {
            return projected;
        }

        float outwardAmount = min(0.0, dot(displacement, inwardNormal));
        float2 slidePosition = current + displacement - inwardNormal * outwardAmount;
        if (IsWalkable(slidePosition))
        {
            return slidePosition;
        }
    }

    float2 xOnly = float2(desired.x, current.y);
    float2 yOnly = float2(current.x, desired.y);
    bool xValid = IsWalkable(xOnly);
    bool yValid = IsWalkable(yOnly);
    if (xValid && yValid)
    {
        return dot(xOnly - current, xOnly - current) >= dot(yOnly - current, yOnly - current) ? xOnly : yOnly;
    }

    return xValid ? xOnly : (yValid ? yOnly : current);
}

float2 ConstrainMove(float2 current, float2 desired)
{
    float2 displacement = desired - current;
    float distance = length(displacement);
    int stepCount = clamp((int)ceil(distance / max(_CellSize * 0.4, 0.05)), 1, 16);
    float2 step = displacement / (float)stepCount;
    float2 result = current;
    [loop]
    for (int stepIndex = 0; stepIndex < stepCount; stepIndex++)
    {
        result = ConstrainMoveStep(result, result + step);
    }
    return result;
}

// Solve relative displacements against one immutable grid. The separating
// plane is based on tick-start centres: satisfying it prevents intersection
// over the entire step, including crossing streams and interpolated rendering.
[numthreads(64, 1, 1)]
void PrepareMotion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _DiagnosticsRead[3]) return;
    uint index = _ActiveIndicesRead[id.x];
    AgentState state = _StatesRead[index];
    _MotionWrite[index] = state.position - state.stepStartPosition;
    _AcceptedMotion[index] = 0.0;
    float4 self = _SpatialStatesRead[index];
    float4 obstacle = float4(0.0, 0.0, 0.0, state.padding2 < -0.5 ? -1.0 : 0.0);
    if (state.padding2 >= 1.0)
    {
        uint targetIndex = (uint)round(state.padding2) - 1u;
        if (targetIndex < _DynamicTargetCapacity)
        {
            DynamicTargetState target = _DynamicTargetsRead[targetIndex];
            if (target.status == 1u && target.blockCapacity > 0.0)
            {
                float along = clamp(dot(self.xy - target.position, target.axis), -target.segmentHalfLength, target.segmentHalfLength);
                float2 offset = self.xy - target.position - target.axis * along;
                float distance = length(offset);
                float radius = max(0.1, max(0.05, target.halfDepth) + state.scale * _BodyRadiusPerScale * 1.045);
                obstacle = float4(offset / max(0.000001, distance), distance - radius, 1.0);
            }
        }
    }
    _MotionObstacles[index] = obstacle;
    float search = MaximumPairDiameter() * 1.08 + _MaximumMotionDistance * 2.0;
    int radius = (int)ceil(search / _CellSize);
    int2 cell = WorldToCell(self.xy);
    uint total = 0;
    for (int y = -radius; y <= radius; y++)
    for (int x = -radius; x <= radius; x++)
    {
        int2 neighbour = cell + int2(x, y);
        if (!IsInside(neighbour)) continue;
        uint key = CellIndex(neighbour);
        uint count = min(_CellCountsRead[key], _CellCapacity);
        for (uint slot = 0; slot < count; slot++)
        {
            uint other = _CellAgentsRead[key * _CellCapacity + slot];
            if (other == index) continue;
            float2 delta = self.xy - _SpatialStatesRead[other].xy;
            float d2 = dot(delta, delta);
            if (d2 > search * search) continue;
            float distance = sqrt(max(d2, 0.00000001));
            float2 normal = d2 > 0.00000001 ? delta / distance : float2(index < other ? -1.0 : 1.0, 0.0);
            if (total < MOTION_NEIGHBORS)
                _MotionNeighbors[index * MOTION_NEIGHBORS + total] = float4(normal, distance, asfloat(other));
            total++;
        }
    }
    // The direct grid path below handles overflow without dropping a contact.
    _MotionNeighborCounts[index] = total;
}

[numthreads(64, 1, 1)]
void ConstrainMotion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _DiagnosticsRead[3]) return;
    uint index = _ActiveIndicesRead[id.x];
    float4 self = _SpatialStatesRead[index];
    float2 move = _MotionRead[index];
    float2 correction = 0.0;
    float contacts = 0.0;
    float search = MaximumPairDiameter() * 1.08 + _MaximumMotionDistance * 2.0;
    int radius = (int)ceil(search / _CellSize);
    int2 cell = WorldToCell(self.xy);
    uint cachedCount = _MotionNeighborCounts[index];
    if (cachedCount <= MOTION_NEIGHBORS)
    {
        for (uint slot = 0; slot < cachedCount; slot++)
        {
            float4 pair = _MotionNeighbors[index * MOTION_NEIGHBORS + slot];
            uint other = asuint(pair.w);
            float gap = MotionContactGap(pair.z, self.z, _SpatialStatesRead[other].z,
                _MotionObstacles[index].w < -0.5 && _MotionObstacles[other].w < -0.5);
            float violation = -gap - dot(move - _MotionRead[other], pair.xy);
            if (violation > 0.0)
            {
                correction += pair.xy * violation * (_SpatialStatesRead[other].w / max(0.0001, self.w + _SpatialStatesRead[other].w));
                contacts += 1.0;
            }
        }
    }
    else
    {
    for (int y = -radius; y <= radius; y++)
    for (int x = -radius; x <= radius; x++)
    {
        int2 neighbour = cell + int2(x, y);
        if (!IsInside(neighbour)) continue;
        uint key = CellIndex(neighbour);
        uint count = min(_CellCountsRead[key], _CellCapacity);
        for (uint slot = 0; slot < count; slot++)
        {
            uint other = _CellAgentsRead[key * _CellCapacity + slot];
            if (other == index) continue;
            float4 body = _SpatialStatesRead[other];
            float2 delta = self.xy - body.xy;
            float d2 = dot(delta, delta);
            if (d2 > search * search) continue;
            float distance = sqrt(max(d2, 0.00000001));
            float2 normal = d2 > 0.00000001 ? delta / distance : float2(index < other ? -1.0 : 1.0, 0.0);
            float gap = MotionContactGap(distance, self.z, body.z,
                _MotionObstacles[index].w < -0.5 && _MotionObstacles[other].w < -0.5);
            // Share braking over a short approach horizon. A one-tick horizon
            // waits until all spare space is consumed, then the feasibility
            // pass has to stop individual rows abruptly.
            float violation = -gap - dot(move - _MotionRead[other], normal);
            if (violation > 0.0)
            {
                correction += normal * violation * (body.w / max(0.0001, self.w + body.w));
                contacts += 1.0;
            }
        }
    }
    }
    move += correction / max(1.0, contacts);
    float4 obstacle = _MotionObstacles[index];
    if (obstacle.w > 0.5)
    {
        float gap = obstacle.z > 0.0 ? obstacle.z * _DeltaTime / max(_DeltaTime, 0.3) : obstacle.z;
        move += obstacle.xy * max(0.0, -gap - dot(move, obstacle.xy));
    }
    move = ConstrainMove(self.xy, self.xy + move) - self.xy;
    float maxTravel = _MaximumMotionDistance;
    float travel = length(move);
    _MotionWrite[index] = travel > maxTravel ? move * (maxTravel / travel) : move;
}

[numthreads(64, 1, 1)]
void CommitMotion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _DiagnosticsRead[3]) return;
    uint index = _ActiveIndicesRead[id.x];
    AgentState state = _StatesRead[index];
    if (state.status != 1u) return;
    float2 movement = _AcceptedMotion[index];
    state.position = state.stepStartPosition + movement;
    state.velocity = movement / max(_DeltaTime, 0.0001) - state.knockbackVelocity;
    int2 cell = WorldToCell(state.position);
    float integration = IsInside(cell) ? _FlowData[CellIndex(cell)].y : -1.0;
    if (_ExitEnabled != 0u && integration >= 0.0 && integration <= 0.001)
    {
        state.status = 2u;
        EmitEvent(index, 2u, 0.0);
    }
    else if (integration >= 0.0) state.progress = -integration;
    _StatesRead[index] = state;
}

float3 AcceptancePlane(uint index, uint slot, uint neighbours, float scale, float4 obstacle)
{
    if (slot == neighbours) return float3(obstacle.xy, -obstacle.z);
    float4 pair = _MotionNeighbors[index * MOTION_NEIGHBORS + slot];
    uint other = asuint(pair.w);
    float bound = PairCollisionDiameter(scale, _SpatialStatesRead[other].z) * 1.002 - pair.z
        + dot(_AcceptedMotion[other], pair.xy);
    return float3(pair.xy, bound);
}

// Feasibility, not penetration repair: move towards the solved proposal only
// as far as swept circles allow. Each accepted move preserves valid bodies.
// Cells of one colour cannot interact within the bounded travel distance.
[numthreads(64, 1, 1)]
void ReserveMotionCells(uint3 id : SV_DispatchThreadID)
{
    uint columns = ((uint)_GridSize.x + _CleanupCellStride - 1u) / _CleanupCellStride;
    uint2 phase = uint2(_CleanupCellPhase % _CleanupCellStride, _CleanupCellPhase / _CleanupCellStride);
    int2 cell = (int2)(uint2(id.x % columns, id.x / columns) * _CleanupCellStride + phase);
    if (!IsInside(cell)) return;
    uint key = CellIndex(cell);
    uint count = min(_CellCountsRead[key], _CellCapacity);
    float search = MaximumPairDiameter() * 1.08 + _MaximumMotionDistance * 2.0;
    int radius = (int)ceil(search / _CellSize);
    for (uint ordinal = 0; ordinal < count; ordinal++)
    {
        uint slot = _ReverseMotionReservation != 0u ? count - 1u - ordinal : ordinal;
        uint index = _CellAgentsRead[key * _CellCapacity + slot];
        float4 self = _SpatialStatesRead[index];
        float2 accepted = _AcceptedMotion[index];
        float2 proposal = _MotionRead[index];
        uint neighbours = _MotionNeighborCounts[index];
        float4 motionObstacle = _MotionObstacles[index];
        if (_SlidingMotionAcceptance != 0u && neighbours <= MOTION_NEIGHBORS)
        {
            // A blocked lateral component must not cancel a free forward step.
            // Project onto the intersection of all neighbour half-planes and the
            // travel disk. An optimum is either the goal or on a plane boundary.
            float2 goal = proposal;
            uint planeCount = neighbours + (motionObstacle.w > 0.5 ? 1u : 0u);
            bool goalFeasible = true;
            for (uint n = 0; n < planeCount; n++)
            {
                float3 plane = AcceptancePlane(index, n, neighbours, self.z, motionObstacle);
                if (dot(goal, plane.xy) < plane.z) goalFeasible = false;
            }
            if (!goalFeasible)
            {
                proposal = accepted; // already feasible against all live neighbours
                float bestError = dot(goal - accepted, goal - accepted);
                [loop]
                for (uint n = 0; n < planeCount; n++)
                {
                    float3 plane = AcceptancePlane(index, n, neighbours, self.z, motionObstacle);
                    float remaining = _MaximumMotionDistance * _MaximumMotionDistance - plane.z * plane.z;
                    if (remaining < 0.0) continue;
                    float2 lineOrigin = plane.xy * plane.z;
                    float2 tangent = float2(-plane.y, plane.x);
                    float low = -sqrt(remaining), high = -low;
                    bool feasible = true;
                    [loop]
                    for (uint j = 0; j < planeCount; j++)
                    {
                        if (j == n) continue;
                        float3 otherPlane = AcceptancePlane(index, j, neighbours, self.z, motionObstacle);
                        float numerator = otherPlane.z - dot(lineOrigin, otherPlane.xy);
                        float denominator = dot(tangent, otherPlane.xy);
                        if (abs(denominator) < 0.000001)
                        {
                            if (numerator > 0.000001) feasible = false;
                        }
                        else if (denominator > 0.0) low = max(low, numerator / denominator);
                        else high = min(high, numerator / denominator);
                    }
                    if (!feasible || low > high) continue;
                    float2 candidate = lineOrigin + tangent * clamp(dot(goal, tangent), low, high);
                    float error = dot(candidate - goal, candidate - goal);
                    if (error < bestError) { proposal = candidate; bestError = error; }
                }
            }
            proposal = ConstrainMove(self.xy, self.xy + proposal) - self.xy;
        }
        // The final swept-plane check protects feasibility if wall projection
        // changed the proposed slide, and is the complete-grid overflow fallback.
        float2 step = proposal - accepted;
        float a = dot(step, step);
        if (a < 1e-12) continue;
        float fraction = 1.0;
        uint cachedCount = _MotionNeighborCounts[index];
        if (cachedCount <= MOTION_NEIGHBORS)
        {
            for (uint otherSlot = 0; otherSlot < cachedCount; otherSlot++)
            {
                float4 pair = _MotionNeighbors[index * MOTION_NEIGHBORS + otherSlot];
                uint other = asuint(pair.w);
                float b = dot(pair.xy, step);
                if (b >= 0.0) continue;
                float diameter = PairCollisionDiameter(self.z, _SpatialStatesRead[other].z) * 1.002;
                float gap = pair.z - diameter + dot(accepted - _AcceptedMotion[other], pair.xy);
                fraction = min(fraction, max(0.0, max(0.0, gap) / -b - 0.0001));
            }
        }
        else
        {
        for (int y = -radius; y <= radius; y++)
        for (int x = -radius; x <= radius; x++)
        {
            int2 neighbour = cell + int2(x, y);
            if (!IsInside(neighbour)) continue;
            uint otherKey = CellIndex(neighbour);
            uint otherCount = min(_CellCountsRead[otherKey], _CellCapacity);
            for (uint otherSlot = 0; otherSlot < otherCount; otherSlot++)
            {
                uint other = _CellAgentsRead[otherKey * _CellCapacity + otherSlot];
                if (other == index) continue;
                float4 body = _SpatialStatesRead[other];
                float2 startDelta = self.xy - body.xy;
                float distance = length(startDelta);
                if (distance > search) continue;
                float2 normal = startDelta / max(distance, 0.000001);
                float b = dot(normal, step);
                if (b >= 0.0) continue;
                // Prediction reserves 8% air; feasibility protects the entire
                // diagnostic silhouette plus a numerical margin, never less.
                float diameter = PairCollisionDiameter(self.z, body.z) * 1.002;
                float gap = distance - diameter + dot(accepted - _AcceptedMotion[other], normal);
                float hit = max(0.0, gap) / -b;
                fraction = min(fraction, max(0.0, hit - 0.0001));
            }
        }
        }
        if (motionObstacle.w > 0.5)
        {
            float closing = dot(motionObstacle.xy, step);
            if (closing < 0.0)
                fraction = min(fraction, max(0.0, (motionObstacle.z + dot(accepted, motionObstacle.xy)) / -closing - 0.0001));
        }
        _AcceptedMotion[index] = accepted + step * fraction;
    }
}

[numthreads(64, 1, 1)]
void ResolveContacts(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _DiagnosticsRead[3])
    {
        return;
    }

    uint index = _ActiveIndicesRead[activeSlot];
    AgentState state = _StatesRead[index];
    if (state.status != 1u)
    {
        _StatesWrite[index] = state;
        return;
    }

    int2 centerCell = WorldToCell(state.position);
    float contactSpacing = _AnimatedGoblin != 0u && _CenterSeekingArena == 0u ? 1.08 : 1.0;
    float maximumCollisionDiameter = MaximumPairDiameter() * contactSpacing;
    float searchRadiusSq = maximumCollisionDiameter * maximumCollisionDiameter;
    int cellRadius = max(1, (int)ceil(maximumCollisionDiameter / _CellSize));
    float2 correction = 0.0;
    float2 deepestCorrection = 0.0;
    float deepestCorrectionLength = 0.0;
    float2 driveVelocityCorrection = 0.0;
    float2 knockbackVelocityCorrection = 0.0;
    uint overlapCount = 0u;
    float2 flow = SampleFlow(state.position);
    if (dot(flow, flow) < 0.0001)
    {
        flow = float2(1.0, 0.0);
    }
    float2 lateralAxis = float2(-flow.y, flow.x);
    float queuePenetration = 0.0;
    float selfBoundaryDistance = SampleBoundaryDistance(state.position);
    float2 selfBoundaryNormal = SampleBoundaryNormal(state.position);
    bool heldQueue = state.padding2 >= 1.0 || (state.flags & 2u) != 0u;

    [loop]
    for (int oy = -cellRadius; oy <= cellRadius && _HardContactCleanup == 0u; oy++)
    {
        [loop]
        for (int ox = -cellRadius; ox <= cellRadius; ox++)
        {
            int2 neighborCell = centerCell + int2(ox, oy);
            if (!IsInside(neighborCell))
            {
                continue;
            }

            uint cellIndex = CellIndex(neighborCell);
            uint count = min(_CellCountsRead[cellIndex], _CellCapacity);
            [loop]
            for (uint slot = 0u; slot < count; slot++)
            {
                uint otherIndex = _CellAgentsRead[cellIndex * _CellCapacity + slot];
                if (otherIndex == index)
                {
                    continue;
                }

                float4 otherSpatial = _SpatialStatesRead[otherIndex];
                AgentState otherState = _StatesRead[otherIndex];
                float2 delta = state.position - otherSpatial.xy;
                float distanceSq = dot(delta, delta);
                bool heldPair = _AnimatedGoblin != 0u && _CenterSeekingArena == 0u &&
                    (heldQueue || otherState.padding2 >= 1.0 || (otherState.flags & 2u) != 0u);
                float pairDiameter = heldPair
                    ? MovementPairDiameter(state.scale, otherSpatial.z)
                    : ContactPairDiameter(state.scale, otherSpatial.z);
                if (distanceSq >= pairDiameter * pairDiameter)
                {
                    continue;
                }

                float distance = sqrt(max(distanceSq, 0.000001));
                float2 direction;
                if (distanceSq <= 0.000001)
                {
                    uint lowerIndex = min(index, otherIndex);
                    uint upperIndex = max(index, otherIndex);
                    float angle = frac(lowerIndex * 0.7548777 + upperIndex * 0.5698403) * 6.2831853;
                    sincos(angle, direction.y, direction.x);
                    direction *= index < otherIndex ? 1.0 : -1.0;
                }
                else
                {
                    direction = delta / distance;
                }

                float selfMass = max(0.1, state.mass);
                float otherMass = max(0.1, otherState.mass);
                float selfShare = otherMass / (selfMass + otherMass);
                float velocityShare = selfShare;
                float2 selfContactVelocity = state.velocity + state.knockbackVelocity;
                float2 otherContactVelocity = otherState.velocity + otherState.knockbackVelocity;
                if (_CenterSeekingArena != 0u)
                {
                    float wallContactDistance = max(0.1, _CollisionDiameter * 0.95);
                    bool selfRepelledByWall =
                        state.shockwaveReturnTimer > 0.0 &&
                        selfBoundaryDistance < wallContactDistance;
                    bool otherRepelledByWall =
                        otherState.shockwaveReturnTimer > 0.0 &&
                        SampleBoundaryDistance(otherSpatial.xy) < wallContactDistance;
                    if (selfRepelledByWall != otherRepelledByWall)
                    {
                        // The magnetic wall response keeps all of its inward
                        // velocity. The body in front receives the full matching
                        // impulse instead of making the wall body wait for space.
                        velocityShare = selfRepelledByWall ? 0.0 : 1.0;
                    }

                    float2 selfFromCenter = state.position - _ArenaCenter;
                    float2 otherFromCenter = otherSpatial.xy - _ArenaCenter;
                    float selfRadius = length(selfFromCenter);
                    float otherRadius = length(otherFromCenter);
                    float2 selfInward = selfRadius > 0.0001
                        ? -selfFromCenter / selfRadius
                        : 0.0;
                    float2 otherInward = otherRadius > 0.0001
                        ? -otherFromCenter / otherRadius
                        : 0.0;
                    bool selfReturning =
                        state.shockwaveReturnTimer > 0.0 &&
                        state.shockwaveOutwardTimer <= 0.0 &&
                        dot(selfContactVelocity, selfInward) > 0.1;
                    bool otherReturning =
                        otherState.shockwaveReturnTimer > 0.0 &&
                        otherState.shockwaveOutwardTimer <= 0.0 &&
                        dot(otherContactVelocity, otherInward) > 0.1;
                    float radialLead = _CollisionDiameter * 0.05;
                    if (selfReturning && selfRadius > otherRadius + radialLead)
                    {
                        velocityShare = 0.0;
                    }
                    else if (otherReturning && otherRadius > selfRadius + radialLead)
                    {
                        velocityShare = 1.0;
                    }
                }
                float positionShare = selfShare;
                float selfCorrectionLength = (pairDiameter - distance) * positionShare;
                float2 pairCorrection = direction * selfCorrectionLength;
                correction += pairCorrection;
                if (selfCorrectionLength > deepestCorrectionLength)
                {
                    deepestCorrection = pairCorrection;
                    deepestCorrectionLength = selfCorrectionLength;
                }

                // Project the pair's relative velocity onto a non-penetrating
                // constraint. Both agents execute the complementary mass share,
                // so momentum crosses the crowd without creating extra energy.
                float relativeNormalSpeed = dot(
                    selfContactVelocity - otherContactVelocity,
                    direction);
                if (relativeNormalSpeed < 0.0)
                {
                    float2 pairVelocityCorrection =
                        direction * (-relativeNormalSpeed) * velocityShare;
                    bool externalContact =
                        dot(state.knockbackVelocity, state.knockbackVelocity) > 0.000001 ||
                        dot(otherState.knockbackVelocity, otherState.knockbackVelocity) > 0.000001 ||
                        state.padding > 0.0 || otherState.padding > 0.0;
                    if (externalContact)
                    {
                        knockbackVelocityCorrection += pairVelocityCorrection;
                    }
                    else
                    {
                        driveVelocityCorrection += pairVelocityCorrection;
                    }
                }
                float2 toOther = otherSpatial.xy - state.position;
                float forwardDistance = dot(toOther, flow);
                float lateralDistance = abs(dot(toOther, lateralAxis));
                float2 otherFlow = SampleFlow(otherSpatial.xy);
                float flowAlignment = dot(flow, otherFlow);
                if (flowAlignment > 0.92 && forwardDistance > 0.0 &&
                    lateralDistance < pairDiameter * 0.52)
                {
                    float requiredForwardDistance = sqrt(max(0.0,
                        pairDiameter * pairDiameter - lateralDistance * lateralDistance));
                    queuePenetration = max(queuePenetration,
                        requiredForwardDistance - forwardDistance);
                }
                overlapCount++;
            }
        }
    }

    if (overlapCount > 0u)
    {
        float contactRelaxation = rcp(max(1.0, sqrt((float)overlapCount)));
        state.velocity += driveVelocityCorrection * contactRelaxation;
        state.knockbackVelocity += knockbackVelocityCorrection * contactRelaxation;
        float resolvedKnockbackSpeed = length(state.knockbackVelocity);
        if (resolvedKnockbackSpeed > 140.0)
        {
            state.knockbackVelocity *= 140.0 / resolvedKnockbackSpeed;
        }
        if (_CenterSeekingArena != 0u)
        {
            // In a radial crowd the summed Jacobi correction approaches zero:
            // every neighbour has another neighbour on the opposite side. Solve
            // one complete unilateral constraint per pass instead. Rebuilding the
            // grid between passes then exposes the next-deepest pair.
            correction = deepestCorrection;

            // Once a body is touching the packed core, collision wins over the
            // shared center target. Remove every inward component until this body
            // has a valid non-overlapping position; outward blast motion remains.
            float2 fromArenaCenter = state.position - _ArenaCenter;
            float centerDistanceSq = dot(fromArenaCenter, fromArenaCenter);
            bool leavingArenaWall = selfBoundaryDistance < _CollisionDiameter * 2.0;
            if (centerDistanceSq > 0.000001 && !leavingArenaWall)
            {
                float2 outwardNormal = fromArenaCenter * rsqrt(centerDistanceSq);
                state.velocity -= outwardNormal * min(0.0, dot(state.velocity, outwardNormal));
                state.knockbackVelocity -= outwardNormal *
                    min(0.0, dot(state.knockbackVelocity, outwardNormal));
                correction += outwardNormal * deepestCorrectionLength * 0.22;
            }
        }
        else
        {
            // Under-relaxed Jacobi projection. The reference crowd still needs
            // a bounded deepest-pair term: averaging every overlap by its raw
            // count makes a dense junction retain intersecting visual blobs for
            // many frames, which looks like one stream has priority over another.
            if (_ReferenceCrowd != 0u && !heldQueue)
            {
                // The reference queue transmits momentum through velocity, not
                // through an instant positional teleport. Keep a small deepest
                // pair bias so dense contacts do not cancel to zero, but retain
                // the local average to prevent the selected neighbour changing
                // from pass to pass and flinging a body around the crowd.
                correction *= contactRelaxation;
                correction += deepestCorrection * 0.18;
            }
            else if (_AnimatedGoblin != 0u && !heldQueue)
            {
                correction /= max(1.0, (float)overlapCount);
            }
            else
            {
                correction *= contactRelaxation;
                correction += deepestCorrection * 0.9;
                correction -= flow * max(0.0, queuePenetration) * 0.62;
            }
        }

        // A travelling horde is a one-way flow. The old complementary contact
        // correction was physically symmetric, which meant it could first push
        // a runner backwards and let the drive code pull it forward next tick.
        // At close zoom that produced a very visible forward/backward hop.
        // Keep deliberate impulses and a genuinely held queue symmetric, but
        // project ordinary crowd contacts onto forward/lateral motion.
        bool canReceiveReverseContactMotion = heldQueue ||
            dot(state.knockbackVelocity, state.knockbackVelocity) > 0.000001 ||
            state.padding > 0.0001;
        if (_UnidirectionalHordeContacts != 0u && !canReceiveReverseContactMotion)
        {
            float reverseVelocity = dot(state.velocity, flow);
            if (reverseVelocity < 0.0)
            {
                state.velocity -= flow * reverseVelocity;
            }

            float reverseCorrection = dot(correction, flow);
            if (reverseCorrection < 0.0)
            {
                correction -= flow * reverseCorrection;
            }
        }
        float correctionLength = length(correction);
        float maximumCorrection = _CollisionDiameter * (_CenterSeekingArena != 0u ? 0.75 : 0.48);
        if (_ReferenceCrowd != 0u && _CenterSeekingArena == 0u)
        {
            // This is a per-60-Hz-tick displacement budget shared by all Jacobi
            // passes. Without it, a body may receive the maximum correction eight
            // times in one tick and visibly jump across an otherwise static queue.
            float perPassBudget = 1.55 * _DeltaTime / max(1.0, (float)_ContactIterationCount);
            maximumCorrection = min(maximumCorrection, perPassBudget);
        }
        if (correctionLength > maximumCorrection)
        {
            correction *= maximumCorrection / correctionLength;
        }
        if (state.padding2 < -0.5)
        {
            // The blocker vanished in this tick. Space is opening in front, so
            // contact cleanup may fan sideways but must not visually shove a
            // released row backwards before its first forward step.
            correction -= flow * min(0.0, dot(correction, flow));
        }
        state.position = ConstrainMove(state.position, state.position + correction);
    }

    if (_CenterSeekingArena != 0u &&
        selfBoundaryDistance < max(0.1, _CollisionDiameter * 0.95))
    {
        float2 inwardNormal = selfBoundaryNormal;
        float inwardNormalLengthSq = dot(inwardNormal, inwardNormal);
        if (inwardNormalLengthSq > 0.0001)
        {
            inwardNormal *= rsqrt(inwardNormalLengthSq);
            float normalDriveSpeed = _Controls[index].x * _MovementSpeedMultiplier * 0.72;
            float shockwaveRepulsionSpeed = state.shockwaveReturnTimer > 0.0
                ? _ShockwavePropagationSpeed * 0.42
                : 0.0;
            float minimumInwardSpeed = max(normalDriveSpeed, shockwaveRepulsionSpeed);
            float currentInwardSpeed = dot(
                state.velocity + state.knockbackVelocity,
                inwardNormal);
            state.shockwaveOutwardTimer = 0.0;
            state.knockbackVelocity += inwardNormal *
                max(0.0, minimumInwardSpeed - currentInwardSpeed);
            state.padding = max(state.padding, 0.32);
        }
    }

    if (_FinalizePresentation != 0u)
    {
        // Sample only the final position AFTER every contact iteration. The
        // pre-solve forward push is not distance walked when a queue is blocked.
        float2 travel = state.position - state.stepStartPosition;
        float signedForwardTravel = dot(travel, flow);
        float forwardTravel = max(0.0, signedForwardTravel);
        float travelDistance = length(travel);
        bool externalPresentationForce =
            dot(state.knockbackVelocity, state.knockbackVelocity) > 0.000001 ||
            state.padding > 0.0001;
        if (_ReferenceCrowd != 0u && !externalPresentationForce &&
            state.padding2 < 1.0 && signedForwardTravel < -0.000001)
        {
            InterlockedAdd(_Diagnostics[7], 1u);
            InterlockedMax(_Diagnostics[8], (uint)round(-signedForwardTravel * 1000000.0));
        }
        float requestedSpeed = max(0.0, _Controls[index].x * _MovementSpeedMultiplier * state.slowMultiplier);
        float resolvedSpeed = travelDistance / max(_DeltaTime, 0.0001);
        if (_PredictiveContacts == 0u && state.padding2 < -0.5 && travelDistance > 0.015 * _DeltaTime)
            resolvedSpeed = max(resolvedSpeed, requestedSpeed * 0.16);
        // Starting a step is immediate; only the return to the braced pose is
        // eased. The symmetric low-pass made visible running begin ~0.2s late.
        state.locomotionSpeed = _PredictiveContacts != 0u || resolvedSpeed > state.locomotionSpeed
            ? resolvedSpeed
            : lerp(state.locomotionSpeed, resolvedSpeed, 1.0 - exp(-_DeltaTime * 12.0));
        state.presentationTime += _DeltaTime;
        // Include lateral and externally pushed travel: a displaced body takes
        // recovery steps even when its own drive cannot advance into the queue.
        if (travelDistance > 0.015 * _DeltaTime && (state.flags & 2u) == 0u)
            state.animationDistance += min(travelDistance, max(0.5, requestedSpeed * 1.8) * _DeltaTime);
        if (dot(state.facing, state.facing) < 0.1)
            state.facing = flow;
        if (forwardTravel > 0.06 * _DeltaTime || (state.flags & 2u) != 0u)
        {
            float2 desiredFacing = flow;
            float2 blendedFacing = lerp(state.facing, desiredFacing, saturate(_DeltaTime * 10.0));
            if (dot(blendedFacing, blendedFacing) > 0.001)
                state.facing = normalize(blendedFacing);
        }
        // Contact projection is a positional correction, not another impulse.
        // Feeding it back as next tick's velocity makes neighbouring rows brake
        // and restart in alternating waves. Keep the contact-solved velocity;
        // presentation observes actual travel independently above.
    }
    _StatesWrite[index] = state;
}


[numthreads(64, 1, 1)]
void ResolveContactCells(uint3 id : SV_DispatchThreadID)
{
    uint columnCount = ((uint)_GridSize.x + _CleanupCellStride - 1u) / _CleanupCellStride;
    uint2 phase = uint2(_CleanupCellPhase % _CleanupCellStride, _CleanupCellPhase / _CleanupCellStride);
    int2 cell = (int2)(uint2(id.x % columnCount, id.x / columnCount) * _CleanupCellStride + phase);
    if (!IsInside(cell)) return;

    // One thread owns the entire cell and updates its bodies sequentially.
    // Selected cells are far enough apart that their read/write neighbourhoods
    // cannot meet, even after the maximum correction. This makes in-place
    // Gauss-Seidel safe and prevents equal simultaneous pushes from cancelling.
    uint count = min(_CellCountsRead[CellIndex(cell)], _CellCapacity);
    float maximumPush = _CollisionDiameter * 0.48;
    int cellRadius = max(1, (int)ceil((MaximumPairDiameter() * 1.08 + maximumPush * 2.0) / _CellSize));
    [loop]
    for (uint slot = 0u; slot < count; slot++)
    {
        uint index = _CellAgentsRead[CellIndex(cell) * _CellCapacity + slot];
        AgentState state = _StatesRead[index];
        float2 start = state.position;
        [loop]
        for (uint sweep = 0u; sweep < 6u; sweep++)
        {
            float deepest = 0.0;
            float2 correction = 0.0;
            [loop]
            for (int oy = -cellRadius; oy <= cellRadius; oy++)
            {
                [loop]
                for (int ox = -cellRadius; ox <= cellRadius; ox++)
                {
                    int2 neighbourCell = cell + int2(ox, oy);
                    if (!IsInside(neighbourCell)) continue;
                    uint neighbourCellIndex = CellIndex(neighbourCell);
                    uint neighbourCount = min(_CellCountsRead[neighbourCellIndex], _CellCapacity);
                    [loop]
                    for (uint neighbourSlot = 0u; neighbourSlot < neighbourCount; neighbourSlot++)
                    {
                        uint otherIndex = _CellAgentsRead[neighbourCellIndex * _CellCapacity + neighbourSlot];
                        if (otherIndex == index) continue;
                        AgentState other = _StatesRead[otherIndex];
                        float diameter = MovementPairDiameter(state.scale, other.scale);
                        float2 delta = state.position - other.position;
                        float distanceSq = dot(delta, delta);
                        if (distanceSq >= diameter * diameter) continue;
                        float distance = sqrt(max(distanceSq, 0.000001));
                        float depth = diameter - distance;
                        if (depth <= deepest) continue;
                        float2 direction = distanceSq > 0.000001 ? delta / distance :
                            float2(index < otherIndex ? -1.0 : 1.0, 0.0);
                        deepest = depth;
                        correction = direction * depth;
                    }
                }
            }
            if (deepest < 0.00001) break;
            float2 displacement = state.position + correction - start;
            float displacementLength = length(displacement);
            if (displacementLength > maximumPush) displacement *= maximumPush / displacementLength;
            float2 desired = ConstrainMove(state.position, start + displacement);
            if (dot(desired - state.position, desired - state.position) < 0.000000001) break;
            state.position = desired;
        }
        _StatesRead[index] = state;
    }
}

[numthreads(64, 1, 1)]
void MeasureOverlaps(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _DiagnosticsRead[3])
    {
        return;
    }

    uint index = _ActiveIndicesRead[activeSlot];
    float4 spatial = _SpatialStatesRead[index];
    int2 centerCell = WorldToCell(spatial.xy);
    float maximumCollisionDiameter = MaximumPairDiameter() * 1.08;
    int cellRadius = max(1, (int)ceil(maximumCollisionDiameter / _CellSize));
    float nearestSpacing = 1e20;

    [loop]
    for (int oy = -cellRadius; oy <= cellRadius; oy++)
    {
        [loop]
        for (int ox = -cellRadius; ox <= cellRadius; ox++)
        {
            int2 neighborCell = centerCell + int2(ox, oy);
            if (!IsInside(neighborCell))
            {
                continue;
            }

            uint cellIndex = CellIndex(neighborCell);
            uint count = min(_CellCountsRead[cellIndex], _CellCapacity);
            [loop]
            for (uint slot = 0u; slot < count; slot++)
            {
                uint otherIndex = _CellAgentsRead[cellIndex * _CellCapacity + slot];
                if (otherIndex == index)
                {
                    continue;
                }

                float4 otherSpatial = _SpatialStatesRead[otherIndex];
                float pairDiameter = PairCollisionDiameter(spatial.z, otherSpatial.z);
                float pairDistance = distance(spatial.xy, otherSpatial.xy);
                nearestSpacing = min(nearestSpacing, pairDistance / max(0.0001, pairDiameter));
                if (otherIndex <= index)
                {
                    continue;
                }
                if (pairDistance <= pairDiameter * 1.05)
                {
                    InterlockedAdd(_Diagnostics[11], 1u);
                }
                if (pairDistance < pairDiameter)
                {
                    float penetrationFraction = saturate((pairDiameter - pairDistance) / pairDiameter);
                    InterlockedMax(_Diagnostics[6], (uint)round(penetrationFraction * 1000000.0));
                    if (penetrationFraction > 0.005)
                    {
                        InterlockedAdd(_Diagnostics[5], 1u);
                    }
                }
            }
        }
    }

    if (nearestSpacing < 1e19)
    {
        InterlockedAdd(_Diagnostics[9], (uint)round(nearestSpacing * 1000.0));
        InterlockedAdd(_Diagnostics[10], 1u);
    }
}

[numthreads(64, 1, 1)]
void ApplyDynamicTargetCommands(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _DynamicTargetCommandCount)
    {
        return;
    }

    DynamicTargetCommand command = _DynamicTargetCommands[id.x];
    if (command.slot >= _DynamicTargetCapacity)
    {
        return;
    }

    DynamicTargetState state = _DynamicTargets[command.slot];
    if (command.operation == 1u)
    {
        state.position = command.position;
        state.health = command.health;
        state.maxHealth = command.maxHealth;
        state.radius = command.radius;
        state.axis = command.axis;
        state.segmentHalfLength = command.segmentHalfLength;
        state.halfDepth = command.halfDepth;
        state.blockCapacity = command.blockCapacity;
        state.armor = command.armor;
        state.physicalResistance = command.physicalResistance;
        state.fireResistance = command.fireResistance;
        state.slowResistance = command.slowResistance;
        state.thornsDamage = command.thornsDamage;
        state.slowMultiplier = 1.0;
        state.slowTimer = 0.0;
        state.burnDamagePerSecond = 0.0;
        state.burnTimer = 0.0;
        state.generation = command.generation;
        state.status = 1u;
        state.kind = command.kind;
        state.flags = 0u;
    }
    else if (state.generation == command.generation && command.operation == 2u)
    {
        state.position = command.position;
        state.radius = command.radius;
        state.axis = command.axis;
        state.segmentHalfLength = command.segmentHalfLength;
        state.halfDepth = command.halfDepth;
        state.blockCapacity = command.blockCapacity;
    }
    else if (state.generation == command.generation && command.operation == 3u)
    {
        state.status = 0u;
        state.health = 0.0;
    }

    _DynamicTargets[command.slot] = state;
}

[numthreads(64, 1, 1)]
void ClearDynamicTargetGrid(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _CellCount)
    {
        _DynamicTargetCellCounts[id.x] = 0u;
    }
    if (id.x < _DynamicTargetCapacity)
    {
        _DynamicTargetBlockedMass[id.x] = 0u;
        _DynamicTargetDamage[id.x] = 0u;
        _DynamicTargetLastAttacker[id.x] = 0u;
    }
}

[numthreads(64, 1, 1)]
void BuildDynamicTargetGrid(uint3 id : SV_DispatchThreadID)
{
    uint targetIndex = id.x;
    if (targetIndex >= _DynamicTargetCapacity)
    {
        return;
    }

    DynamicTargetState state = _DynamicTargetsRead[targetIndex];
    int2 cell = WorldToCell(state.position);
    if (state.status != 1u || !IsInside(cell))
    {
        return;
    }

    uint cellIndex = CellIndex(cell);
    uint slot;
    InterlockedAdd(_DynamicTargetCellCounts[cellIndex], 1u, slot);
    if (slot < _DynamicTargetCellCapacity)
    {
        _DynamicTargetCellIndices[cellIndex * _DynamicTargetCellCapacity + slot] = targetIndex;
    }
}

[numthreads(64, 1, 1)]
void ResolveDynamicTargetDamage(uint3 id : SV_DispatchThreadID)
{
    uint targetIndex = id.x;
    if (targetIndex >= _DynamicTargetCapacity)
    {
        return;
    }

    DynamicTargetState state = _DynamicTargets[targetIndex];
    uint packedDamage = _DynamicTargetDamage[targetIndex];
    if (state.status != 1u || packedDamage == 0u)
    {
        return;
    }

    float rawDamage = packedDamage / 1024.0;
    float appliedDamage = max(0.0, rawDamage - state.armor) * (1.0 - saturate(state.physicalResistance));
    if (appliedDamage <= 0.0)
    {
        return;
    }

    state.health = max(0.0, state.health - appliedDamage);
    uint attackerToken = _DynamicTargetLastAttacker[targetIndex];
    int sourceIndex = -1;
    if (attackerToken > 0u && attackerToken <= _AgentCount)
    {
        sourceIndex = (int)_StatesInput[attackerToken - 1u].definitionIndex;
    }

    if (state.health <= 0.0)
    {
        state.status = 2u;
        EmitDetailedEvent(targetIndex, 4u, 0.0, state.generation, sourceIndex);
    }
    else
    {
        EmitDetailedEvent(targetIndex, 3u, state.health, state.generation, sourceIndex);
    }
    _DynamicTargets[targetIndex] = state;
}

[numthreads(64, 1, 1)]
void ApplySpawns(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _SpawnCount) return;
    uint index = _SpawnStart + id.x;
    AgentState state = _SpawnStates[id.x];
    state.stepStartPosition = state.position;
    _StatesRead[index] = state;
    _StatesWrite[index] = state;
    if (_SpawnHasControls != 0u) _SpawnControlsWrite[index] = _SpawnControls[id.x];
}

[numthreads(64, 1, 1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _CellCount)
    {
        _CellCounts[id.x] = 0;
    }
}

[numthreads(64, 1, 1)]
void ClearDiagnostics(uint3 id : SV_DispatchThreadID)
{
    if (id.x < 12)
    {
        _Diagnostics[id.x] = 0;
    }
}

[numthreads(64, 1, 1)]
void BuildGrid(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _AgentCount) return;
    AgentState state = _StatesRead[index];
    if (state.status != 1 || _Controls[index].y < 0.5)
    {
        // Active-only kernels never visit retired slots. Carry their final state
        // into the other buffer, or the next swap resurrects the old live body.
        _StatesWrite[index] = state;
        return;
    }

    int2 cell = WorldToCell(_StatesRead[index].position);
    if (!IsInside(cell))
    {
        _StatesWrite[index] = state;
        return;
    }

    uint cellIndex = CellIndex(cell);
    _SpatialStates[index] = float4(state.position, state.scale, max(0.1, state.mass));
    uint slot;
    InterlockedAdd(_CellCounts[cellIndex], 1, slot);
    uint activeSlot;
    InterlockedAdd(_Diagnostics[3], 1, activeSlot);
    _ActiveIndices[activeSlot] = index;
    InterlockedMax(_Diagnostics[2], slot + 1);
    if (slot < _CellCapacity)
    {
        _CellAgents[cellIndex * _CellCapacity + slot] = index;
    }
    else
    {
        InterlockedAdd(_Diagnostics[1], 1);
        if (slot == _CellCapacity)
        {
            InterlockedAdd(_Diagnostics[0], 1);
        }
    }
}

[numthreads(1, 1, 1)]
void FinalizeActiveDispatch(uint3 id : SV_DispatchThreadID)
{
    uint groupCount = (_Diagnostics[3] + 63u) / 64u;
    _ActiveDispatchArgs.Store(0, groupCount);
    _ActiveDispatchArgs.Store(4, 1u);
    _ActiveDispatchArgs.Store(8, 1u);
}

[numthreads(64, 1, 1)]
void ApplyDamageCommands(uint3 id : SV_DispatchThreadID)
{
    uint commandIndex = id.x;
    if (commandIndex >= _DamageCommandCount)
    {
        return;
    }

    DamageCommand command = _DamageCommands[commandIndex];
    if (command.index >= _AgentCount || command.damage <= 0.0)
    {
        return;
    }

    AgentState state = _StatesRead[command.index];
    if (state.status != 1 || state.health <= 0.0)
    {
        return;
    }

    float appliedDamage = max(0.0, command.damage - state.armor) * (1.0 - saturate(state.physicalResistance));
    state.health -= appliedDamage;
    if (state.health <= 0.0)
    {
        state.health = 0.0;
        state.status = 3;
        EmitEvent(command.index, 1u, appliedDamage);
        _StatesWrite[command.index] = state;
    }

    _StatesRead[command.index] = state;
}

[numthreads(64, 1, 1)]
void ApplyStatusCommands(uint3 id : SV_DispatchThreadID)
{
    uint commandIndex = id.x;
    if (commandIndex >= _StatusCommandCount)
    {
        return;
    }

    StatusCommand command = _StatusCommands[commandIndex];
    if (command.index >= _AgentCount)
    {
        return;
    }

    AgentState state = _StatesRead[command.index];
    if (state.status != 1 || state.health <= 0.0)
    {
        return;
    }

    if (command.slowDuration > 0.0)
    {
        state.slowMultiplier = min(state.slowMultiplier, command.slowMultiplier);
        state.slowTimer = max(state.slowTimer, command.slowDuration * (1.0 - saturate(state.slowResistance)));
    }

    if (command.burnDamagePerSecond > 0.0 && command.burnDuration > 0.0 && command.burnApplications > 0u)
    {
        uint existingStacks = (uint)round(state.burnDamagePerSecond / max(command.burnDamagePerSecond, 0.0001));
        uint nextStacks = min(max(1u, command.maxBurnStacks), existingStacks + command.burnApplications);
        state.burnDamagePerSecond = command.burnDamagePerSecond * nextStacks * (1.0 - saturate(state.fireResistance));
        state.burnTimer = max(state.burnTimer, command.burnDuration);
    }

    _StatesRead[command.index] = state;
}

[numthreads(1, 1, 1)]
void ApplyAreaEffect(uint3 id : SV_DispatchThreadID)
{
    [loop]
    for (uint commandIndex = 0u; commandIndex < _AreaCommandCount; commandIndex++)
    {
        AreaEffectCommand command = _AreaEffectCommands[commandIndex];
        bool unlimitedCommand = command.maxTargets == 0u;
        bool hasCappedSlow = command.slowDuration > 0.0 && command.slowMultiplier < 0.995 &&
            command.slowCapacity > 0.0;
        if (unlimitedCommand && !hasCappedSlow)
        {
            continue;
        }

        int2 centerCell = WorldToCell(command.center);
        int cellRadius = max(1, (int)ceil(command.radius / _CellSize));
        float radiusSq = command.radius * command.radius;
        uint hitCount = 0u;
        float usedSlowCapacity = 0.0;
        bool commandComplete = false;
        [loop]
        for (int oy = -cellRadius; oy <= cellRadius && !commandComplete; oy++)
        {
            [loop]
            for (int ox = -cellRadius; ox <= cellRadius && !commandComplete; ox++)
            {
                int2 cell = centerCell + int2(ox, oy);
                if (!IsInside(cell))
                {
                    continue;
                }

                uint cellIndex = CellIndex(cell);
                uint count = min(_CellCountsRead[cellIndex], _CellCapacity);
                [loop]
                for (uint slot = 0u; slot < count; slot++)
                {
                    uint agentIndex = _CellAgentsRead[cellIndex * _CellCapacity + slot];
                    AgentState state = _StatesRead[agentIndex];
                    if (state.status != 1 || state.health <= 0.0)
                    {
                        continue;
                    }

                    float2 offset = state.position - command.center;
                    float distanceSq = dot(offset, offset);
                    if (distanceSq > radiusSq)
                    {
                        continue;
                    }

                    bool applySlow = command.slowDuration > 0.0 && command.slowMultiplier < 0.995 &&
                        usedSlowCapacity + max(0.1, state.mass) <= command.slowCapacity;
                    bool hasOtherEffect = !unlimitedCommand &&
                        (command.damage > 0.0 || command.knockback > 0.0 || command.burnDamagePerSecond > 0.0);
                    if (!applySlow && !hasOtherEffect)
                    {
                        continue;
                    }

                    if (!unlimitedCommand && command.knockback > 0.0)
                    {
                        float distance = sqrt(max(distanceSq, 0.000001));
                        float2 direction;
                        if (distanceSq > 0.000001)
                        {
                            direction = offset / distance;
                        }
                        else
                        {
                            float angle = frac((agentIndex + 1u) * 0.61803398875) * 6.2831853;
                            sincos(angle, direction.y, direction.x);
                        }
                        float falloff = 1.0 - saturate(distance / command.radius);
                        state.velocity += direction * command.knockback * lerp(2.5, 8.0, falloff);
                        state.padding = max(state.padding, clamp(command.knockback / 32.0, 0.55, 2.5));
                    }

                    if (!unlimitedCommand && command.damage > 0.0)
                    {
                        float appliedDamage = max(0.0, command.damage - state.armor) * (1.0 - saturate(state.physicalResistance));
                        state.health -= appliedDamage;
                        if (state.health <= 0.0)
                        {
                            state.health = 0.0;
                            state.status = 3;
                            EmitEvent(agentIndex, 1u, appliedDamage);
                        }
                        else
                        {
                            EmitEvent(agentIndex, 5u, appliedDamage);
                        }
                    }

                    if (!unlimitedCommand && state.status == 1 && command.burnDamagePerSecond > 0.0 && command.burnDuration > 0.0)
                    {
                        uint existingStacks = (uint)round(state.burnDamagePerSecond / max(command.burnDamagePerSecond, 0.0001));
                        uint nextStacks = min(max(1u, command.maxBurnStacks), existingStacks + 1u);
                        state.burnDamagePerSecond = command.burnDamagePerSecond * nextStacks * (1.0 - saturate(state.fireResistance));
                        state.burnTimer = max(state.burnTimer, command.burnDuration);
                    }

                    if (state.status == 1 && applySlow)
                    {
                        state.slowMultiplier = min(state.slowMultiplier, command.slowMultiplier);
                        state.slowTimer = max(state.slowTimer, command.slowDuration * (1.0 - saturate(state.slowResistance)));
                        usedSlowCapacity += max(0.1, state.mass);
                    }

                    _StatesRead[agentIndex] = state;
                    hitCount++;
                    if (command.maxTargets > 0u && hitCount >= command.maxTargets)
                    {
                        commandComplete = true;
                        break;
                    }
                }
            }
        }
    }
}

[numthreads(64, 1, 1)]
void ApplyUnlimitedAreaEffects(uint3 id : SV_DispatchThreadID)
{
    uint activeCount = _DiagnosticsRead[3];
    if (id.x >= activeCount)
    {
        return;
    }

    uint agentIndex = _ActiveIndicesRead[id.x];
    AgentState state = _StatesRead[agentIndex];
    if (state.status != 1u || state.health <= 0.0)
    {
        return;
    }

    [loop]
    for (uint commandIndex = 0u; commandIndex < _AreaCommandCount; commandIndex++)
    {
        AreaEffectCommand command = _AreaEffectCommands[commandIndex];
        if (command.maxTargets != 0u)
        {
            continue;
        }

        float2 offset = state.position - command.center;
        float distanceSq = dot(offset, offset);
        float radiusSq = command.radius * command.radius;
        float effectiveInnerRadius = max(0.0, command.innerRadius);
        bool isPhysicsShockwave = command.innerRadius != 0.0;
        if (distanceSq > radiusSq || distanceSq < effectiveInnerRadius * effectiveInnerRadius)
        {
            continue;
        }

        if (command.knockback > 0.0)
        {
            bool applyKnockback = true;
            float distance = sqrt(max(distanceSq, 0.000001));
            float2 direction;
            if (distanceSq > 0.000001)
            {
                direction = offset / distance;
            }
            else
            {
                float angle = frac((agentIndex + 1u) * 0.61803398875) * 6.2831853;
                sincos(angle, direction.y, direction.x);
            }

            float gameplayFalloff = 1.0;
            if (command.innerRadius <= 0.0)
            {
                float falloff = 1.0 - saturate(distance / command.radius);
                float smoothFalloff = falloff * falloff * (3.0 - 2.0 * falloff);
                gameplayFalloff = lerp(0.35, 1.0, smoothFalloff);
            }

            if (isPhysicsShockwave)
            {
                float noise = frac(sin((float)(agentIndex + 1u) * 12.9898 +
                    dot(command.center, float2(78.233, 37.719))) * 43758.5453);
                bool firstShockwaveContact =
                    state.shockwaveOutwardTimer <= 0.0 &&
                    state.shockwaveExposure < 0.05;
                applyKnockback = firstShockwaveContact ||
                    state.shockwaveOutwardTimer > 0.0;
                direction = Rotate2D(direction, (noise - 0.5) * 0.12);
                gameplayFalloff *= lerp(0.95, 1.05, frac(noise * 7.173));
                int2 shockwaveCell = WorldToCell(state.position);
                float localCrowd = IsInside(shockwaveCell)
                    ? saturate((float)_CellCountsRead[CellIndex(shockwaveCell)] / 32.0)
                    : 0.0;
                gameplayFalloff *= lerp(1.0, 1.35, localCrowd);
                gameplayFalloff *= lerp(1.0, 0.5, saturate(state.shockwaveExposure));
                state.shockwaveExposure = saturate(state.shockwaveExposure + 0.22);
                if (firstShockwaveContact)
                {
                    state.shockwaveCenter = command.center;
                    state.shockwaveReturnTimer = max(state.shockwaveReturnTimer, 12.0);
                    float rideSpeed = _ShockwavePropagationSpeed * lerp(0.88, 1.0, noise);
                    float remainingBoundaryDistance = max(0.0, SampleBoundaryDistance(state.position));
                    float2 boundaryNormal = SampleBoundaryNormal(state.position);
                    float radialWallAlignment = max(0.3, -dot(direction, boundaryNormal));
                    float remainingRideTime = remainingBoundaryDistance /
                        max(0.1, rideSpeed * radialWallAlignment);
                    state.shockwaveOutwardTimer = max(0.05, remainingRideTime);
                }
            }
            if (applyKnockback)
            {
                float inverseMass = rcp(max(1.0, state.mass));
                state.knockbackVelocity += direction * command.knockback * gameplayFalloff * inverseMass;
                state.padding = max(state.padding, clamp(command.knockback / 22.0, 1.5, 4.5));
            }
        }

        if (command.damage > 0.0)
        {
            float appliedDamage = max(0.0, command.damage - state.armor) *
                (1.0 - saturate(state.physicalResistance));
            state.health -= appliedDamage;
            if (state.health <= 0.0)
            {
                state.health = 0.0;
                state.status = 3u;
                EmitEvent(agentIndex, 1u, appliedDamage);
            }
            else
            {
                EmitEvent(agentIndex, 5u, appliedDamage);
            }
        }

        if (state.status == 1u && command.burnDamagePerSecond > 0.0 && command.burnDuration > 0.0)
        {
            uint existingStacks = (uint)round(state.burnDamagePerSecond / max(command.burnDamagePerSecond, 0.0001));
            uint nextStacks = min(max(1u, command.maxBurnStacks), existingStacks + 1u);
            state.burnDamagePerSecond = command.burnDamagePerSecond * nextStacks *
                (1.0 - saturate(state.fireResistance));
            state.burnTimer = max(state.burnTimer, command.burnDuration);
        }

        if (state.status != 1u)
        {
            break;
        }
    }

    _StatesRead[agentIndex] = state;
}

float DistancePointToSegmentSq(float2 samplePosition, float2 a, float2 b)
{
    float2 segment = b - a;
    float lengthSq = dot(segment, segment);
    if (lengthSq <= 0.000001)
    {
        return dot(samplePosition - a, samplePosition - a);
    }
    float t = saturate(dot(samplePosition - a, segment) / lengthSq);
    float2 nearest = a + segment * t;
    return dot(samplePosition - nearest, samplePosition - nearest);
}

[numthreads(1, 1, 1)]
void ApplyProjectile(uint3 id : SV_DispatchThreadID)
{
    [loop]
    for (uint commandIndex = 0u; commandIndex < _ProjectileCommandCount; commandIndex++)
    {
        ProjectileCommand command = _ProjectileCommands[commandIndex];
        uint projectileSlot = command.projectileId % 2048u;
        if (command.resetHitCount != 0u)
        {
            _ProjectileHitCounts[projectileSlot] = 0u;
        }
        if (_ProjectileHitCounts[projectileSlot] >= command.maxHits)
        {
            continue;
        }
        float2 boundsMin = min(command.start, command.end) - command.radius;
        float2 boundsMax = max(command.start, command.end) + command.radius;
        int2 minCell = WorldToCell(boundsMin);
        int2 maxCell = WorldToCell(boundsMax);
        uint hitCount = _ProjectileHitCounts[projectileSlot];
        bool commandComplete = false;
        [loop]
        for (int y = minCell.y; y <= maxCell.y && !commandComplete; y++)
        {
            [loop]
            for (int x = minCell.x; x <= maxCell.x && !commandComplete; x++)
            {
                int2 cell = int2(x, y);
                if (!IsInside(cell))
                {
                    continue;
                }

                uint cellIndex = CellIndex(cell);
                uint count = min(_CellCountsRead[cellIndex], _CellCapacity);
                [loop]
                for (uint slot = 0u; slot < count; slot++)
                {
                    uint agentIndex = _CellAgentsRead[cellIndex * _CellCapacity + slot];
                    if (_AgentLastProjectileIds[agentIndex] == command.projectileId)
                    {
                        continue;
                    }
                    AgentState state = _StatesRead[agentIndex];
                    if (state.status != 1u || state.health <= 0.0 || ((state.flags & 1u) != 0u && command.canHitFlying == 0u))
                    {
                        continue;
                    }

                    float hitRadius = max(command.radius, state.scale * 0.62);
                    float distanceSq = command.mode == 0u
                        ? DistancePointToSegmentSq(state.position, command.start, command.end)
                        : dot(state.position - command.end, state.position - command.end);
                    if (distanceSq > hitRadius * hitRadius)
                    {
                        continue;
                    }

                    float appliedDamage = max(0.0, command.damage - state.armor) * (1.0 - saturate(state.physicalResistance));
                    state.health = max(0.0, state.health - appliedDamage);
                    if (command.knockback > 0.0)
                    {
                        float2 offset = state.position - command.end;
                        float offsetLength = length(offset);
                        float2 direction = offsetLength > 0.0001 ? offset / offsetLength : float2(1.0, 0.0);
                        state.velocity += direction * command.knockback * 5.0;
                        state.padding = max(state.padding, 0.55);
                    }
                    if (state.health <= 0.0)
                    {
                        state.status = 3u;
                        EmitEvent(agentIndex, 1u, appliedDamage);
                    }
                    else
                    {
                        EmitEvent(agentIndex, 5u, appliedDamage);
                        if (command.burnDamagePerSecond > 0.0 && command.burnDuration > 0.0)
                        {
                            uint existingStacks = (uint)round(state.burnDamagePerSecond / max(command.burnDamagePerSecond, 0.0001));
                            uint nextStacks = min(max(1u, command.maxBurnStacks), existingStacks + 1u);
                            state.burnDamagePerSecond = command.burnDamagePerSecond * nextStacks * (1.0 - saturate(state.fireResistance));
                            state.burnTimer = max(state.burnTimer, command.burnDuration);
                        }
                    }

                    _StatesRead[agentIndex] = state;
                    _AgentLastProjectileIds[agentIndex] = command.projectileId;
                    hitCount++;
                    _ProjectileHitCounts[projectileSlot] = hitCount;
                    if (command.maxHits > 0u && hitCount >= command.maxHits)
                    {
                        EmitEvent(command.projectileId, 6u, (float)hitCount);
                        commandComplete = true;
                        break;
                    }
                }
            }
        }
    }
}

[numthreads(64, 1, 1)]
void Simulate(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _DiagnosticsRead[3])
    {
        return;
    }

    uint index = _ActiveIndicesRead[activeSlot];

    AgentState state = _StatesInput[index];
    float4 control = _Controls[index];
    if (control.y < 0.5)
    {
        state.status = 0;
        _StatesWrite[index] = state;
        return;
    }

    if (state.status != 1)
    {
        _StatesWrite[index] = state;
        return;
    }

    // Bit 0 is flying. Bit 1 is a transient renderer hint for a reserved
    // melee attacker and is recomputed every simulation step.
    state.flags &= 0xFFFFFFFDu;
    float simulationDelta = _DeltaTime;
    state.stepStartPosition = state.position;
    float2 knockbackVelocity = state.knockbackVelocity;
    bool wasShockwaveRiding = state.shockwaveOutwardTimer > 0.0;
    state.shockwaveOutwardTimer = max(0.0, state.shockwaveOutwardTimer);
    state.shockwaveExposure = max(0.0, state.shockwaveExposure - simulationDelta * 0.85);
    if (state.shockwaveOutwardTimer > 0.0)
    {
        state.shockwaveOutwardTimer = max(0.0, state.shockwaveOutwardTimer - simulationDelta);
    }
    bool shockwaveRiding = state.shockwaveOutwardTimer > 0.0;
    bool shockwaveReleased =
        wasShockwaveRiding && !shockwaveRiding;
    if (!shockwaveRiding)
    {
        state.shockwaveReturnTimer = max(
            0.0,
            state.shockwaveReturnTimer - simulationDelta);
    }
    bool hasDedicatedKnockback = dot(knockbackVelocity, knockbackVelocity) > 0.000001;
    bool hasPersistentKnockback = state.padding > 0.0;
    state.padding = max(0.0, state.padding - simulationDelta);
    // padding2 stores the dynamic blocker slot (+1) whose queue this body is
    // part of. Validate it every tick so removing that blocker releases the
    // remembered queue in this same dispatch.
    bool releasedBlockerThisTick = false;
    if (state.padding2 < -0.5)
        state.padding2 = 0.0;
    if (state.padding2 >= 1.0)
    {
        uint rememberedBlocker = (uint)round(state.padding2) - 1u;
        if (rememberedBlocker >= _DynamicTargetCapacity ||
            _DynamicTargetsRead[rememberedBlocker].status != 1u)
        {
            // -1 survives through contact finalization as a one-tick visual
            // release marker, then the next simulation step clears it above.
            state.padding2 = -1.0;
            releasedBlockerThisTick = true;
        }
    }

    if (state.slowTimer > 0.0)
    {
        state.slowTimer -= simulationDelta;
        if (state.slowTimer <= 0.0)
        {
            state.slowTimer = 0.0;
            state.slowMultiplier = 1.0;
        }
    }

    if (state.burnTimer > 0.0 && state.burnDamagePerSecond > 0.0)
    {
        state.health -= state.burnDamagePerSecond * simulationDelta;
        state.burnTimer -= simulationDelta;
        if (state.health <= 0.0)
        {
            state.health = 0.0;
            state.status = 3;
            EmitEvent(index, 1u, state.burnDamagePerSecond * simulationDelta);
            _StatesWrite[index] = state;
            return;
        }

        if (state.burnTimer <= 0.0)
        {
            state.burnTimer = 0.0;
            state.burnDamagePerSecond = 0.0;
        }
    }

    int2 centerCell = WorldToCell(state.position);
    if (!IsInside(centerCell))
    {
        _StatesWrite[index] = state;
        return;
    }

    uint centerIndex = CellIndex(centerCell);
    float centerIntegration = _FlowData[centerIndex].y;
    if (_ExitEnabled != 0u && centerIntegration >= 0.0 && centerIntegration <= 0.001)
    {
        state.status = 2;
        EmitEvent(index, 2u, 0.0);
        _StatesWrite[index] = state;
        return;
    }

    float2 flow;
    float centerDistance = 1e20;
    if (_CenterSeekingArena != 0u)
    {
        float2 centerOffset = _ArenaCenter - state.position;
        centerDistance = length(centerOffset);
        flow = centerDistance > 0.0001 ? centerOffset / centerDistance : 0.0;
    }
    else if (_RandomArenaMovement != 0u)
    {
        sincos(control.w, flow.y, flow.x);
    }
    else
    {
        flow = FindNavigableFlow(state.position, SampleFlow(state.position));
    }
    if (_CenterSeekingArena != 0u &&
        centerDistance < _CollisionDiameter * 4.0)
    {
        state.shockwaveReturnTimer = 0.0;
    }
    float2 shockwaveOffset = state.position - state.shockwaveCenter;
    float shockwaveDistanceSq = dot(shockwaveOffset, shockwaveOffset);
    float2 shockwaveDirection = shockwaveDistanceSq > 0.000001
        ? shockwaveOffset * rsqrt(shockwaveDistanceSq)
        : -flow;
    float shockwaveRideNoise = frac(sin((float)(index + 1u) * 12.9898 +
        dot(state.shockwaveCenter, float2(78.233, 37.719))) * 43758.5453);
    float shockwaveRideSpeed = _ShockwavePropagationSpeed * lerp(0.88, 1.0, shockwaveRideNoise);
    float2 lateralAxis = float2(-flow.y, flow.x);
    float flowLookAheadDistance = max(0.75, _CollisionDiameter * 3.0);
    float2 flowLookAheadPosition = state.position + flow * flowLookAheadDistance;
    float2 lookAheadFlow = _CenterSeekingArena != 0u
        ? flow
        : FindNavigableFlow(flowLookAheadPosition, SampleFlow(flowLookAheadPosition));
    if (dot(lookAheadFlow, lookAheadFlow) < 0.0001)
    {
        lookAheadFlow = flow;
    }
    bool straightForOvertake = dot(flow, lookAheadFlow) > 0.94;
    int blockingTarget = -1;
    float blockingDistanceSq = 1e30;
    float2 blockingTargetPosition = 0.0;
    float blockingContactRadius = 0.0;
    const int targetCellRadius = 2;
    [loop]
    for (int toy = -targetCellRadius; toy <= targetCellRadius; toy++)
    {
        [loop]
        for (int tox = -targetCellRadius; tox <= targetCellRadius; tox++)
        {
            int2 targetCell = centerCell + int2(tox, toy);
            if (!IsInside(targetCell))
            {
                continue;
            }

            uint targetCellIndex = CellIndex(targetCell);
            uint targetCount = min(_DynamicTargetCellCountsRead[targetCellIndex], _DynamicTargetCellCapacity);
            [loop]
            for (uint targetSlot = 0u; targetSlot < targetCount; targetSlot++)
            {
                uint targetIndex = _DynamicTargetCellIndicesRead[targetCellIndex * _DynamicTargetCellCapacity + targetSlot];
                DynamicTargetState target = _DynamicTargetsRead[targetIndex];
                float axisLengthSq = dot(target.axis, target.axis);
                float alongTarget = axisLengthSq > 0.0001
                    ? clamp(dot(state.position - target.position, target.axis),
                        -target.segmentHalfLength, target.segmentHalfLength)
                    : 0.0;
                float2 closestTargetPoint = target.position + target.axis * alongTarget;
                float2 targetOffset = closestTargetPoint - state.position;
                float targetDistanceSq = dot(targetOffset, targetOffset);
                float targetDepth = max(0.05, target.halfDepth);
                float attackRange = max(0.35, targetDepth + state.scale * 1.2);
                float forwardOffset = dot(targetOffset, flow);
                if (target.status == 1u && target.blockCapacity > 0.0 &&
                    forwardOffset >= -state.scale * 0.15 &&
                    targetDistanceSq <= attackRange * attackRange && targetDistanceSq < blockingDistanceSq)
                {
                    blockingTarget = (int)targetIndex;
                    blockingDistanceSq = targetDistanceSq;
                    blockingTargetPosition = closestTargetPoint;
                    blockingContactRadius = max(0.1, targetDepth + state.scale * _BodyRadiusPerScale * 1.045);
                }
            }
        }
    }

    if (blockingTarget >= 0)
    {
        state.padding2 = (float)(blockingTarget + 1);
        uint targetIndex = (uint)blockingTarget;
        DynamicTargetState target = _DynamicTargetsRead[targetIndex];
        uint massUnits = max(1u, (uint)round(max(0.1, state.mass) * 1024.0));
        uint capacityUnits = max(1u, (uint)round(target.blockCapacity * 1024.0));
        uint observed = _DynamicTargetBlockedMass[targetIndex];
        bool reserved = false;
        [loop]
        for (uint attempt = 0u; attempt < 8u && observed + massUnits <= capacityUnits; attempt++)
        {
            uint original;
            InterlockedCompareExchange(_DynamicTargetBlockedMass[targetIndex], observed, observed + massUnits, original);
            if (original == observed)
            {
                reserved = true;
                break;
            }
            observed = original;
        }

        if (reserved)
        {
            state.flags |= 2u;
            state.attackTimer -= simulationDelta;
            if (state.attackTimer <= 0.0 && state.attackDamage > 0.0)
            {
                float targetMultiplier = target.kind == 0u ? state.wallDamageMultiplier : state.alliedDamageMultiplier;
                uint damageUnits = max(1u, (uint)round(state.attackDamage * max(0.0, targetMultiplier) * 1024.0));
                InterlockedAdd(_DynamicTargetDamage[targetIndex], damageUnits);
                uint previousAttacker;
                InterlockedExchange(_DynamicTargetLastAttacker[targetIndex], index + 1u, previousAttacker);
                state.attackTimer = max(0.15, state.attackInterval);

                if (target.thornsDamage > 0.0)
                {
                    float thornDamage = max(0.0, target.thornsDamage - state.armor) * (1.0 - saturate(state.physicalResistance));
                    state.health = max(0.0, state.health - thornDamage);
                    if (state.health <= 0.0)
                    {
                        state.status = 3u;
                        EmitEvent(index, 1u, thornDamage);
                        _StatesWrite[index] = state;
                        return;
                    }
                }

                if ((state.combatFlags & 2u) != 0u && target.kind == 1u)
                {
                    state.health = min(state.maxHealth, state.health + state.attackDamage);
                }
            }
        }
        // Block capacity limits simultaneous attackers, not collision.
        // Agents that lose the atomic reservation deliberately retain the
        // physical target and stop instead of passing through its body.
    }

    float2 separation = 0.0;
    float2 overtakePressure = 0.0;
    float2 contactCorrection = 0.0;
    float2 continuousDriveCorrection = 0.0;
    float2 continuousKnockbackCorrection = 0.0;
    uint continuousConstraintCount = 0u;
    float propagatedKnockback = 0.0;
    float congestion = 0.0;
    float forwardSpeedLimit = 1e30;
    float shockwaveSpeedLimit = max(0.0, shockwaveRideSpeed);
    bool shockwaveBlockedForward = false;
    float rawOccupancy = CellOccupancy(centerCell);
    float overflowRatio = saturate((rawOccupancy - (float)_CellCapacity) / max(1.0, (float)_CellCapacity));
    float maximumCollisionDiameter = MaximumPairDiameter() * 1.08;
    float searchRadiusSq = maximumCollisionDiameter * maximumCollisionDiameter;
    int cellRadius = max(1, (int)ceil(maximumCollisionDiameter / _CellSize));
    [loop]
    for (int oy = -cellRadius; oy <= cellRadius; oy++)
    {
        [loop]
        for (int ox = -cellRadius; ox <= cellRadius; ox++)
        {
            int2 neighborCell = centerCell + int2(ox, oy);
            if (!IsInside(neighborCell))
            {
                continue;
            }

            float2 cellMin = _GridOrigin + (float2)neighborCell * _CellSize;
            float2 closestInCell = clamp(state.position, cellMin, cellMin + _CellSize);
            float2 cellOffset = state.position - closestInCell;
            if (dot(cellOffset, cellOffset) >= searchRadiusSq)
            {
                continue;
            }

            uint cellIndex = CellIndex(neighborCell);
            uint count = min(_CellCountsRead[cellIndex], _CellCapacity);
            [loop]
            for (uint slot = 0; slot < count; slot++)
            {
                uint otherIndex = _CellAgentsRead[cellIndex * _CellCapacity + slot];
                if (otherIndex == index)
                {
                    continue;
                }

                float4 otherSpatial = _SpatialStatesRead[otherIndex];
                float2 otherPosition = otherSpatial.xy;
                float otherScale = otherSpatial.z;
                AgentState otherState = _StatesInput[otherIndex];
                float2 delta = state.position - otherPosition;
                float distanceSq = dot(delta, delta);
                if (distanceSq >= searchRadiusSq)
                {
                    continue;
                }


                float pairDiameter = MovementPairDiameter(state.scale, otherScale);
                float distance = sqrt(max(distanceSq, 0.000001));
                float2 direction;
                if (distanceSq <= 0.000001)
                {
                    uint lowerIndex = min(index, otherIndex);
                    uint upperIndex = max(index, otherIndex);
                    float angle = frac((lowerIndex * 0.7548777 + upperIndex * 0.5698403)) * 6.2831853;
                    sincos(angle, direction.y, direction.x);
                    direction *= index < otherIndex ? 1.0 : -1.0;
                }
                else
                {
                    direction = delta / distance;
                }
                if (shockwaveRiding)
                {
                    float2 shockwaveToOther = otherPosition - state.position;
                    float shockwaveForwardDistance = dot(shockwaveToOther, shockwaveDirection);
                    float shockwaveLateralDistance = abs(dot(
                        shockwaveToOther,
                        float2(-shockwaveDirection.y, shockwaveDirection.x)));
                    if (shockwaveForwardDistance > 0.0 && shockwaveLateralDistance < pairDiameter)
                    {
                        float contactForwardDistance = sqrt(max(0.0,
                            pairDiameter * pairDiameter -
                            shockwaveLateralDistance * shockwaveLateralDistance));
                        float freeDistance = max(0.0,
                            shockwaveForwardDistance - contactForwardDistance);
                        // A body that has not met the wave yet is pushed through
                        // normal contact; it must not hold the rider at zero speed.
                        // Only an existing rider constrains the wave-aligned
                        // speed. Reflected bodies are handled as direct blockers.
                        float otherSignedOutwardSpeed = dot(
                            otherState.velocity + otherState.knockbackVelocity,
                            shockwaveDirection);
                        if (otherState.shockwaveOutwardTimer > 0.0)
                        {
                            float otherOutwardSpeed = max(0.0, otherSignedOutwardSpeed);
                            shockwaveSpeedLimit = min(
                                shockwaveSpeedLimit,
                                otherOutwardSpeed + freeDistance / max(simulationDelta, 0.0001));
                        }
                        bool otherAlreadyStoppedOrReflected =
                            otherState.shockwaveExposure > 0.05 &&
                            otherState.shockwaveOutwardTimer <= 0.0 &&
                            otherSignedOutwardSpeed < shockwaveRideSpeed * 0.18;
                        if (freeDistance < pairDiameter * 0.16 &&
                            otherAlreadyStoppedOrReflected)
                        {
                            shockwaveBlockedForward = true;
                        }
                    }
                }
                float forwardDistance = dot(otherPosition - state.position, flow);
                float lateralDistance = abs(dot(otherPosition - state.position, lateralAxis));
                float2 otherContactFlow = SampleFlow(otherPosition);
                if (dot(otherContactFlow, otherContactFlow) < 0.0001)
                {
                    otherContactFlow = flow;
                }
                float selfDriveSpeed = control.x * max(0.05, state.slowMultiplier);
                float otherDriveSpeed = _Controls[otherIndex].x * _MovementSpeedMultiplier *
                    max(0.05, otherState.slowMultiplier);
                float selfMass = max(0.1, state.mass);
                float otherMass = max(0.1, otherState.mass);
                float selfShare = otherMass / (selfMass + otherMass);
                float2 selfContactVelocity = state.velocity + knockbackVelocity;
                float2 otherContactVelocity = otherState.velocity + otherState.knockbackVelocity;
                float closingSpeed = dot(otherContactVelocity - selfContactVelocity, direction);
                float contactGap = max(0.0, distance - pairDiameter);
                float allowedClosingSpeed = contactGap / max(simulationDelta, 0.0001) * 0.82;
                float blockedClosingSpeed = max(0.0, closingSpeed - allowedClosingSpeed);
                bool externalContact = dot(knockbackVelocity, knockbackVelocity) > 0.000001 ||
                    dot(otherState.knockbackVelocity, otherState.knockbackVelocity) > 0.000001 ||
                    state.padding > 0.0 || otherState.padding > 0.0;
                if (blockedClosingSpeed > 0.0)
                {
                    float2 pairVelocityCorrection = direction * blockedClosingSpeed * selfShare;
                    if (externalContact)
                    {
                        continuousKnockbackCorrection += pairVelocityCorrection;
                    }
                    else
                    {
                        continuousDriveCorrection += pairVelocityCorrection;
                    }
                    continuousConstraintCount++;
                }
                float flowAgreement = dot(flow, otherContactFlow);
                bool closeForOvertake = straightForOvertake &&
                    abs(forwardDistance) < pairDiameter * 1.5 &&
                    lateralDistance < pairDiameter * 0.82 && flowAgreement > 0.9;
                if (closeForOvertake && forwardDistance > 0.0 && selfDriveSpeed > otherDriveSpeed + 0.12)
                {
                    float passSide = frac((index + 1u) * 0.61803398875) < 0.5 ? -1.0 : 1.0;
                    float speedAdvantage = selfDriveSpeed - otherDriveSpeed;
                    overtakePressure += lateralAxis * passSide * speedAdvantage * 0.46;
                }
                else if (closeForOvertake && forwardDistance < 0.0 && otherDriveSpeed > selfDriveSpeed + 0.12)
                {
                    float passSide = frac((otherIndex + 1u) * 0.61803398875) < 0.5 ? -1.0 : 1.0;
                    float speedAdvantage = otherDriveSpeed - selfDriveSpeed;
                    float pusherMassResponse = 2.0 * otherMass / (selfMass + otherMass);
                    overtakePressure -= lateralAxis * passSide * speedAdvantage * 0.58 * pusherMassResponse;
                }
                if (_ReferenceCrowd == 0u && forwardDistance > 0.0 && lateralDistance < pairDiameter && flowAgreement > 0.96)
                {
                    float contactForwardDistance = sqrt(max(0.0,
                        pairDiameter * pairDiameter - lateralDistance * lateralDistance));
                    float freeDistance = max(0.0, forwardDistance - contactForwardDistance);
                    float otherForwardSpeed = max(0.0, dot(
                        otherState.velocity + otherState.knockbackVelocity, flow));
                    bool otherLinkedToActiveBlocker = false;
                    bool otherReleasedBlockerThisTick = false;
                    if (otherState.padding2 >= 1.0)
                    {
                        uint otherBlocker = (uint)round(otherState.padding2) - 1u;
                        otherLinkedToActiveBlocker = otherBlocker < _DynamicTargetCapacity &&
                            _DynamicTargetsRead[otherBlocker].status == 1u;
                        otherReleasedBlockerThisTick = !otherLinkedToActiveBlocker;
                    }
                    bool otherDirectlyAttacking = (otherState.flags & 2u) != 0u;
                    if (otherLinkedToActiveBlocker)
                        state.padding2 = otherState.padding2;

                    // Propagate a free queue's ready speed through every row in
                    // this dispatch. Matching the predicted speed of the body in
                    // front lets the whole queue start immediately without any
                    // follower consuming its physical gap. A blocker or reserved
                    // attacker still propagates its actual (usually zero) speed.
                    float otherReadySpeed = otherForwardSpeed;
                    if ((otherLinkedToActiveBlocker || otherDirectlyAttacking) && !externalContact)
                    {
                        // A held body can retain drive velocity even when contact
                        // projection cancels its travel. Propagating that intent
                        // keeps the whole stopped queue pressing and shuffling.
                        float otherResolvedForwardSpeed = max(0.0, dot(
                            otherState.position - otherState.stepStartPosition, flow) /
                            max(simulationDelta, 0.0001));
                        otherReadySpeed = min(otherForwardSpeed, otherResolvedForwardSpeed);
                    }
                    if (!otherLinkedToActiveBlocker && !otherDirectlyAttacking)
                    {
                        // Predict the velocity update the leading body executes in
                        // this same dispatch. Using only last tick's velocity makes
                        // acceleration crawl backwards one row per frame and can
                        // reduce a large free horde to an almost stationary mass.
                        float otherAccelerationAlpha = saturate(_FlowAcceleration * simulationDelta);
                        float otherPredictedSpeed = lerp(
                            otherForwardSpeed,
                            otherDriveSpeed,
                            otherAccelerationAlpha);
                        otherReadySpeed = max(otherForwardSpeed, otherPredictedSpeed);
                    }
                    if (otherReleasedBlockerThisTick)
                        otherReadySpeed = max(otherReadySpeed, otherDriveSpeed * 0.16);
                    forwardSpeedLimit = min(forwardSpeedLimit,
                        otherReadySpeed + freeDistance / max(simulationDelta, 0.0001));
                }
                if (distanceSq >= pairDiameter * pairDiameter)
                {
                    continue;
                }

                float massResponse = 2.0 * otherMass / (selfMass + otherMass);
                float penetration = 1.0 - distance / pairDiameter;
                separation += direction * penetration * 1.25 * massResponse;
                float contactDepth = pairDiameter - distance;
                float2 pairCorrection = direction * contactDepth * 0.62 * massResponse;
                contactCorrection += pairCorrection;
                float desiredClosingSpeed = dot(
                    otherContactFlow * otherDriveSpeed - flow * selfDriveSpeed,
                    direction);
                float momentumClosingSpeed = max(closingSpeed, desiredClosingSpeed);
                bool forwardQueueContact = abs(dot(direction, flow)) > 0.6;
                if (momentumClosingSpeed > 0.0 && (externalContact || forwardQueueContact))
                {
                    // ResolveContacts performs the mass-conserving velocity
                    // transfer. This pass only carries shockwave lifetime; another
                    // impulse here multiplies energy through dense contact chains.
                    if (externalContact)
                    {
                        propagatedKnockback = max(
                            propagatedKnockback,
                            max(state.padding, otherState.padding) * 0.97);
                    }
                }
                congestion += dot(otherPosition - state.position, flow) > 0.0 ? penetration : 0.0;
            }
        }
    }

    if (continuousConstraintCount > 0u && _PredictiveContacts == 0u)
    {
        float continuousRelaxation = rcp(max(1.0, sqrt((float)continuousConstraintCount)));
        state.velocity += continuousDriveCorrection * continuousRelaxation;
        knockbackVelocity += continuousKnockbackCorrection * continuousRelaxation;
    }

    separation = clamp(separation, -1.25, 1.25);
    if (_StationaryHorde == 0u)
    {
        separation = flow * dot(separation, flow) * 0.72 + lateralAxis * dot(separation, lateralAxis) * 1.28;
    }
    float overtakeLength = length(overtakePressure);
    if (overtakeLength > 1.4)
    {
        overtakePressure *= 1.4 / overtakeLength;
    }
    if (!straightForOvertake && !hasPersistentKnockback && propagatedKnockback <= 0.0)
    {
        overtakePressure = 0.0;
    }
    float densityLeft = SmoothedSideOccupancy(centerCell, int2(-1, 0), int2(0, 1));
    float densityRight = SmoothedSideOccupancy(centerCell, int2(1, 0), int2(0, 1));
    float densityDown = SmoothedSideOccupancy(centerCell, int2(0, -1), int2(1, 0));
    float densityUp = SmoothedSideOccupancy(centerCell, int2(0, 1), int2(1, 0));
    float2 densityGradient = float2(
        densityRight - densityLeft,
        densityUp - densityDown);
    densityGradient /= max(1.0, (float)_CellCapacity * 3.0);
    float2 pressureAwayFromDensity = -densityGradient;
    // The center arena needs collision separation, but broad density pressure
    // keeps an already valid crowd artificially inflated and visibly detached.
    float2 widthPressure = _CenterSeekingArena != 0u
        ? pressureAwayFromDensity * 0.18
        : (_StationaryHorde != 0u
            ? pressureAwayFromDensity * 1.35
            : lateralAxis * dot(pressureAwayFromDensity, lateralAxis) * 1.35 +
                flow * dot(pressureAwayFromDensity, flow) * 0.22);
    float crowdPressureWeight = saturate(rawOccupancy / 8.0);
    float overflowAngle = frac(index * 0.61803398875 +
        (_ReferenceCrowd != 0u ? 0.0 : _FrameIndex * 0.0027)) * 6.2831853;
    float2 overflowScatter;
    sincos(overflowAngle, overflowScatter.y, overflowScatter.x);
    float2 overflowPressure = (pressureAwayFromDensity * 1.8 + overflowScatter * 0.22) * overflowRatio;
    float2 crowdPressure = widthPressure * crowdPressureWeight + overflowPressure;
    float combatSpeed = blockingTarget >= 0 ? 0.04 : 1.0;
    float congestionStop = saturate(congestion / 2.0);
    bool acceleratedShockwaveReturn =
        _CenterSeekingArena != 0u &&
        !shockwaveRiding &&
        state.shockwaveReturnTimer > 0.0;
    float congestionSpeedFactor = acceleratedShockwaveReturn
        ? 1.0
        : lerp(1.0, 0.64, congestionStop);
    float centerPackingBrake = _CenterSeekingArena != 0u && !acceleratedShockwaveReturn
        ? lerp(1.0, 0.2, saturate((rawOccupancy - 2.0) / 4.0))
        : 1.0;
    float centerArrivalBrake = _CenterSeekingArena != 0u
        ? saturate(centerDistance / max(0.1, _CollisionDiameter * 2.5))
        : 1.0;
    float movementControl = shockwaveRiding ? 0.0 : control.x;
    float desiredSpeed = movementControl * _MovementSpeedMultiplier * combatSpeed *
        max(0.05, state.slowMultiplier) *
        congestionSpeedFactor * centerPackingBrake * centerArrivalBrake;
    float2 desiredVelocity = flow * desiredSpeed;
    if (_ReferenceCrowd == 0u && _AgentCount >= 2500u && _StationaryHorde == 0u && blockingTarget < 0)
    {
        // A persistent, individually phased lateral cadence breaks the perfect
        // marching lattice without adding CPU state or letting bodies leave the
        // road. Contact projection remains the authority on final placement.
        float cadence = 0.72 + frac((index + 1u) * 0.38196601125) * 0.36;
        float phase = state.presentationTime * cadence +
            frac((index + 1u) * 0.61803398875) * 6.2831853;
        float sway = sin(phase) * min(0.14, desiredSpeed * 0.035);
        desiredVelocity += lateralAxis * sway;
    }
    float2 flowForce = (desiredVelocity - state.velocity) * _FlowAcceleration;
    // Animated crowds retain only the sideways part of the soft separation
    // spring. It opens room between equal-speed neighbours without braking the
    // convoy or making a packed queue start one row at a time.
    bool heldByBarrier = state.padding2 >= 1.0 || blockingTarget >= 0;
    float2 animatedSeparation = heldByBarrier ? 0.0 :
        lateralAxis * dot(separation, lateralAxis) * 0.55;
    if (_AnimatedGoblin != 0u && heldByBarrier && !hasPersistentKnockback && !hasDedicatedKnockback)
    {
        crowdPressure = 0.0;
        overtakePressure = 0.0;
    }
    float2 collisionForce = ((_AnimatedGoblin != 0u ? animatedSeparation : separation) + crowdPressure + overtakePressure) * _CollisionAcceleration;
    if (_ReferenceCrowd != 0u && !hasPersistentKnockback && !hasDedicatedKnockback && propagatedKnockback <= 0.0)
    {
        // A flowing crowd opens sideways around pressure. It brakes behind a
        // body in front through the forward-speed limit instead of behaving as
        // a spring that alternates between forward and backward displacement.
        float2 lateralPressure = lateralAxis * dot(
            separation + crowdPressure + overtakePressure,
            lateralAxis);
        collisionForce = lateralPressure * _CollisionAcceleration * _ReferenceLateralContactResponse;
    }
    if (_PredictiveContacts != 0u) collisionForce = 0.0;
    float4 flowCell = _FlowVectors[centerIndex];
    // Ordinary tactical units may use the full road. A reference horde needs a
    // broad inward pressure field instead: allowing every body to touch the
    // edge creates an unnaturally dense, glued boundary row.
    float boundaryDistance = max(0.0, SampleBoundaryDistance(state.position));
    float wallInfluence = _ReferenceCrowd != 0u
        ? max(_WallInfluence, _CollisionDiameter * 1.75)
        : min(_WallInfluence, max(0.12, _CollisionDiameter * 0.42));
    float wallPenetration = 1.0 - saturate(boundaryDistance / wallInfluence);
    float2 wallNormal = SampleBoundaryNormal(state.position);
    if (dot(wallNormal, wallNormal) < 0.0001)
    {
        wallNormal = flowCell.zw;
    }
    if (_StationaryHorde == 0u)
    {
        float backwardsWallComponent = min(0.0, dot(wallNormal, flow));
        wallNormal -= flow * backwardsWallComponent;
    }
    float2 wallForce = wallNormal * wallPenetration * _WallAcceleration;
    // Boundary clipping and body constraints already share one motion solve.
    // A second wall spring adds lateral velocity to a released, valid queue
    // and makes edge bodies consume the opening before the other rows do.
    if (_PredictiveContacts != 0u) wallForce = 0.0;
    float2 impulse = _Impulses[index];
    _Impulses[index] = 0.0;
    if (propagatedKnockback > 0.0)
    {
        state.padding = max(state.padding, propagatedKnockback);
    }
    state.velocity += (flowForce + collisionForce + wallForce) * simulationDelta + impulse;
    state.velocity *= rcp(1.0 + _VelocityDamping * simulationDelta);

    if (shockwaveReleased && _CenterSeekingArena != 0u)
    {
        // A body released at the boundary needs a decisive inward component;
        // otherwise wall contacts can keep its zero velocity indefinitely.
        float releaseSpeed = max(
            desiredSpeed,
            control.x * _MovementSpeedMultiplier * 0.72);
        float currentInwardSpeed = dot(state.velocity, flow);
        state.velocity += flow * max(0.0, releaseSpeed - currentInwardSpeed);
        knockbackVelocity = 0.0;
    }

    if (shockwaveRiding)
    {
        bool blockedByWall =
            boundaryDistance < max(0.1, _CollisionDiameter * 0.92) &&
            dot(shockwaveDirection, wallNormal) < -0.22;
        if (blockedByWall || shockwaveBlockedForward)
        {
            // A rider reflects as soon as neither the wall nor the already
            // stopped crowd in front allows it to advance. Reflect its actual
            // incoming motion so the response also propagates through a packed row.
            float2 impactVelocity = state.velocity + knockbackVelocity;
            float impactSpeed = length(impactVelocity);
            float2 incomingDirection = impactSpeed > 0.0001
                ? impactVelocity / impactSpeed
                : shockwaveDirection;
            float2 bounceDirection = -incomingDirection;
            if (dot(bounceDirection, shockwaveDirection) > -0.2)
            {
                bounceDirection = -shockwaveDirection;
            }
            float bounceSpeed = max(
                desiredSpeed,
                max(impactSpeed, shockwaveRideSpeed) * 0.52);
            state.shockwaveOutwardTimer = 0.0;
            shockwaveRiding = false;
            state.velocity = 0.0;
            knockbackVelocity = bounceDirection * bounceSpeed;
            state.padding = max(state.padding, 0.32);
        }
        else
        {
            float targetOutwardSpeed = min(shockwaveRideSpeed, shockwaveSpeedLimit);
            float currentOutwardSpeed = dot(knockbackVelocity, shockwaveDirection);
            knockbackVelocity += shockwaveDirection * (targetOutwardSpeed - currentOutwardSpeed);
            state.velocity -= shockwaveDirection * min(0.0, dot(state.velocity, shockwaveDirection));
            state.padding = max(state.padding, 0.25);
        }
    }
    float maxSpeed = max(0.25, desiredSpeed * 1.12);
    float velocityLength = length(state.velocity);
    bool hasExternalImpulse = shockwaveRiding || hasDedicatedKnockback || hasPersistentKnockback ||
        propagatedKnockback > 0.0 || dot(impulse, impulse) > 0.000001;
    if (hasExternalImpulse)
    {
        // Continuous collision needs the body to travel less than one diameter
        // before the spatial grid is rebuilt. Retain the strong impulse for longer
        // rather than allowing a single tunnelling leap.
        float continuousCollisionSpeed = _CollisionDiameter * 0.32 / max(simulationDelta, 0.0001);
        maxSpeed = max(maxSpeed, min(velocityLength, continuousCollisionSpeed));
    }
    if (velocityLength > maxSpeed)
    {
        state.velocity *= maxSpeed / velocityLength;
    }

    // Dense contact pressure must not turn a forward-moving horde into a
    // sideways avalanche. Preserve real impulses (knockback), but keep normal
    // crowd motion inside a broad cone around the local flow direction.
    if (_StationaryHorde == 0u && blockingTarget < 0 && !hasExternalImpulse)
    {
        // Keep locomotion intent hot while contact projection decides whether
        // the body can actually travel. An ordinary packed crowd can therefore
        // start together instead of propagating acceleration one row per tick.
        // The reference crowd may lose all forward momentum on a body or wall.
        // Restoring a fixed 55% drive velocity here was an artificial boost and
        // made every collision look like a spring. It now rebuilds speed solely
        // through the same acceleration curve as a newly spawned unit.
        float minimumForwardVelocity = (_AnimatedGoblin != 0u || _ReferenceCrowd != 0u)
            ? 0.0
            : desiredSpeed * 0.55;
        float forwardVelocity = max(dot(state.velocity, flow), minimumForwardVelocity);
        bool linkedToActiveBlocker = false;
        if (state.padding2 >= 1.0)
        {
            uint queueBlocker = (uint)round(state.padding2) - 1u;
            linkedToActiveBlocker = queueBlocker < _DynamicTargetCapacity &&
                _DynamicTargetsRead[queueBlocker].status == 1u;
        }
        if (_AnimatedGoblin != 0u && releasedBlockerThisTick && !linkedToActiveBlocker)
        {
            // A modest always-ready drive starts every free row immediately;
            // the same value is propagated above so it cannot consume the gap.
            forwardVelocity = max(forwardVelocity, desiredSpeed * 0.16);
        }
        if (_PredictiveContacts == 0u && forwardSpeedLimit < 1e20 && rawOccupancy < (float)_CellCapacity)
        {
            // Continuous relative contact: following bodies may match the
            // speed ahead, but cannot consume more than the remaining gap.
            forwardVelocity = min(forwardVelocity, forwardSpeedLimit);
        }
        float lateralVelocity = clamp(
            dot(state.velocity, lateralAxis),
            -desiredSpeed * 0.38,
            desiredSpeed * 0.38);
        float2 flowConstrainedVelocity = flow * forwardVelocity + lateralAxis * lateralVelocity;
        state.velocity = lerp(state.velocity, flowConstrainedVelocity, _FlowAlignment);
        if (_PredictiveContacts == 0u && _AnimatedGoblin != 0u && forwardSpeedLimit < 1e20)
            state.velocity -= flow * max(0.0, dot(state.velocity, flow) - forwardSpeedLimit);
    }

    float2 oldPosition = state.position;
    float2 movementKnockbackVelocity = knockbackVelocity;
    float movementKnockbackSpeed = length(movementKnockbackVelocity);
    float continuousContactSpeed = shockwaveRiding
        ? shockwaveRideSpeed
        : _CollisionDiameter * 0.22 / max(simulationDelta, 0.0001);
    if (movementKnockbackSpeed > continuousContactSpeed)
    {
        movementKnockbackVelocity *= continuousContactSpeed / movementKnockbackSpeed;
    }
    float2 movementVelocity = state.velocity + movementKnockbackVelocity;
    if (_PredictiveContacts != 0u && releasedBlockerThisTick && !hasExternalImpulse && blockingTarget < 0)
    {
        // A free queue translates with a shared ready drive on its first tick.
        // Neither accumulated lateral contact motion nor local congestion may
        // turn that translation into competing separation corrections.
        state.velocity = flow * control.x * _MovementSpeedMultiplier * max(0.05, state.slowMultiplier) * 0.16;
        movementVelocity = state.velocity;
    }
    if (_PredictiveContacts != 0u)
    {
        float maxTravel = _MaximumMotionDistance;
        float travel = length(movementVelocity) * simulationDelta;
        if (travel > maxTravel) movementVelocity *= maxTravel / travel;
    }
    float2 desiredPosition = oldPosition + movementVelocity * simulationDelta;
    state.position = ConstrainMove(oldPosition, desiredPosition);
    if (dot(state.position - desiredPosition, state.position - desiredPosition) > 0.000001)
    {
        float2 actualMovementVelocity = (state.position - oldPosition) / max(simulationDelta, 0.0001);
        if (_ReferenceCrowd != 0u && !hasExternalImpulse)
        {
            // Sliding along a wall keeps tangential momentum. The component that
            // attempted to enter the wall is removed, exactly like an inelastic
            // crowd impact; the ordinary drive then rebuilds it gradually.
            float2 impactNormal = SampleBoundaryNormal(state.position);
            if (dot(impactNormal, impactNormal) > 0.000001)
            {
                float intoWallSpeed = min(0.0, dot(state.velocity, impactNormal));
                state.velocity -= impactNormal * intoWallSpeed;
            }
            else
            {
                state.velocity = actualMovementVelocity;
            }
        }
        float knockbackSpeed = length(knockbackVelocity);
        if (knockbackSpeed > 0.0001)
        {
            float2 knockbackDirection = knockbackVelocity / knockbackSpeed;
            float allowedKnockbackSpeed = max(0.0, dot(actualMovementVelocity - state.velocity, knockbackDirection));
            knockbackVelocity = knockbackDirection * min(knockbackSpeed, allowedKnockbackSpeed);
        }
    }
    float knockbackDrag = lerp(0.8, 0.18, saturate(state.padding / 2.5));
    if (_ReferenceCrowd != 0u) knockbackDrag = _ReferenceExternalForceRecovery;
    knockbackVelocity *= exp(-knockbackDrag * simulationDelta);
    if (dot(knockbackVelocity, knockbackVelocity) < 0.000001)
    {
        knockbackVelocity = 0.0;
    }
    state.knockbackVelocity = knockbackVelocity;

    // Keep both signs of the flow-axis correction. Backward correction is how
    // contact pressure propagates through a stopped queue instead of allowing
    // rear agents to occupy the same space as agents at the obstacle.
    // At hard cell-capacity overflow the neighbour set is incomplete, so a
    // backward component would introduce a biased whole-pile drift. The
    // emergency pressure path keeps only forward/lateral correction there.
    if (_StationaryHorde == 0u && !hasExternalImpulse && rawOccupancy >= (float)_CellCapacity)
    {
        contactCorrection = lateralAxis * dot(contactCorrection, lateralAxis) +
            flow * max(0.0, dot(contactCorrection, flow));
    }
    float correctionLength = length(contactCorrection);
    float maximumCorrection = _CollisionDiameter * (hasExternalImpulse ? 0.32 : 0.4);
    if (correctionLength > maximumCorrection)
    {
        contactCorrection *= maximumCorrection / correctionLength;
    }
    // Animated goblins and the circular arena use only ResolveContacts.
    // Retain the older pre-projection for the separate sphere prototype.
    if (_AnimatedGoblin == 0u && _ReferenceCrowd == 0u && correctionLength > 0.00001 && _CenterSeekingArena == 0u)
        state.position = ConstrainMove(state.position, state.position + contactCorrection);

    if (blockingTarget >= 0 && blockingContactRadius > 0.0)
    {
        float2 obstacleDelta = state.position - blockingTargetPosition;
        float obstacleDistanceSq = dot(obstacleDelta, obstacleDelta);
        if (obstacleDistanceSq < blockingContactRadius * blockingContactRadius)
        {
            float obstacleDistance = sqrt(max(obstacleDistanceSq, 0.000001));
            float2 obstacleNormal = obstacleDistanceSq > 0.000001
                ? obstacleDelta / obstacleDistance
                : -flow;
            float2 projectedPosition = blockingTargetPosition + obstacleNormal * blockingContactRadius;
            float2 constrainedPosition = ConstrainMove(oldPosition, projectedPosition);
            if (distance(constrainedPosition, blockingTargetPosition) > distance(state.position, blockingTargetPosition))
            {
                state.position = constrainedPosition;
            }
            float inwardSpeed = min(0.0, dot(state.velocity, obstacleNormal));
            state.velocity -= obstacleNormal * inwardSpeed;
        }
    }

    // Drive the run cycle from actual forward travel, not global time. Limit the
    // contribution to intentional movement so knockback/contact corrections do
    // not make the goblin's legs spin or jump to another phase.
    // Locomotion phase is finalized after ResolveContacts.

    state.tint = state.slowTimer > 0.0 && state.slowMultiplier < 0.995 ? 4.0 : control.z;
    int2 finalCell = WorldToCell(state.position);
    float finalIntegration = -1.0;
    if (IsInside(finalCell))
    {
        finalIntegration = _FlowData[CellIndex(finalCell)].y;
    }
    if (_PredictiveContacts == 0u && _ExitEnabled != 0u && finalIntegration >= 0.0 && finalIntegration <= 0.001)
    {
        state.status = 2;
        EmitEvent(index, 2u, 0.0);
    }
    else if (finalIntegration >= 0.0)
    {
        state.progress = -finalIntegration;
    }

    _StatesWrite[index] = state;
}

[numthreads(64, 1, 1)]
void QueryTargets(uint3 id : SV_DispatchThreadID)
{
    uint queryIndex = id.x;
    if (queryIndex >= _QueryCount)
    {
        return;
    }

    TargetQuery query = _TargetQueries[queryIndex];
    int2 center = WorldToCell(query.position);
    int cellRadius = max(1, (int)ceil(query.range / _CellSize));
    float rangeSq = query.range * query.range;
    TargetResult best;
    best.position = 0.0;
    best.velocity = 0.0;
    best.index = -1;
    best.score = -1e30;
    best.secondPosition = 0.0;
    best.secondVelocity = 0.0;
    best.secondIndex = -1;
    best.secondScore = -1e30;
    float bestDistanceSq = 1e30;
    float secondDistanceSq = 1e30;
    [loop]
    for (int oy = -cellRadius; oy <= cellRadius; oy++)
    {
        [loop]
        for (int ox = -cellRadius; ox <= cellRadius; ox++)
        {
            int2 cell = center + int2(ox, oy);
            if (!IsInside(cell))
            {
                continue;
            }

            uint cellIndex = CellIndex(cell);
            uint count = min(_CellCountsRead[cellIndex], _CellCapacity);
            [loop]
            for (uint slot = 0; slot < count; slot++)
            {
                uint agentIndex = _CellAgentsRead[cellIndex * _CellCapacity + slot];
                AgentState state = _StatesInput[agentIndex];
                float reservedDamage = max(0.0, _Controls[agentIndex].w);
                if (state.status != 1 || state.health - reservedDamage <= 0.001 ||
                    (int)agentIndex == query.excludedIndex ||
                    (query.canHitFlying == 0 && (state.flags & 1u) != 0))
                {
                    continue;
                }

                float2 delta = state.position - query.position;
                float distanceSq = dot(delta, delta);
                if (distanceSq > rangeSq)
                {
                    continue;
                }

                float score = -distanceSq;
                if (query.mode == 1u) score = state.progress;
                else if (query.mode == 2u) score = -state.progress;
                else if (query.mode == 3u) score = state.health - reservedDamage;
                if (best.index < 0 || score > best.score || (abs(score - best.score) < 0.0001 && distanceSq < bestDistanceSq))
                {
                    best.secondPosition = best.position;
                    best.secondVelocity = best.velocity;
                    best.secondIndex = best.index;
                    best.secondScore = best.score;
                    secondDistanceSq = bestDistanceSq;
                    best.position = state.position;
                    best.velocity = state.velocity;
                    best.index = (int)agentIndex;
                    best.score = score;
                    bestDistanceSq = distanceSq;
                }
                else if (best.secondIndex < 0 || score > best.secondScore ||
                    (abs(score - best.secondScore) < 0.0001 && distanceSq < secondDistanceSq))
                {
                    best.secondPosition = state.position;
                    best.secondVelocity = state.velocity;
                    best.secondIndex = (int)agentIndex;
                    best.secondScore = score;
                    secondDistanceSq = distanceSq;
                }
            }
        }
    }

    _TargetResults[queryIndex] = best;
}

[numthreads(1, 1, 1)]
void ClearVisibility(uint3 id : SV_DispatchThreadID)
{
    _IndirectArgs.Store(4, 0u);
    _LodIndirectArgs.Store(4, 0u);
    _VariantIndirectArgs.Store(4, 0u);
    _VariantLodIndirectArgs.Store(4, 0u);
}

[numthreads(64, 1, 1)]
void CullVisible(uint3 id : SV_DispatchThreadID)
{
    uint activeSlot = id.x;
    if (activeSlot >= _DiagnosticsRead[3])
    {
        return;
    }

    uint index = _ActiveIndicesRead[activeSlot];

    AgentState state = _StatesInput[index];
    if (state.status != 1)
    {
        return;
    }

    bool visible = true;
    if (_CullingEnabled != 0)
    {
        float4 clip = mul(_ViewProjection, float4(state.position.x, 0.0, state.position.y, 1.0));
        float margin = max(0.5, clip.w * 0.08);
        visible = clip.w > 0.0 && abs(clip.x) <= clip.w + margin && abs(clip.y) <= clip.w + margin;
    }

    if (visible)
    {
        uint visibleIndex;
        if (_GoblinVariantCulling >= 4u)
        {
            uint goblinVariant = index & 3u;
            if (goblinVariant == 0u)
            {
                _IndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
            }
            else if (goblinVariant == 1u)
            {
                _LodIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
            }
            else if (goblinVariant == 2u)
            {
                _VariantIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
            }
            else
            {
                _VariantLodIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
            }
            _VisibleIndices[_VisibleListCapacity * goblinVariant + visibleIndex] = index;
            InterlockedAdd(_Diagnostics[4], 1u);
            return;
        }

        bool secondGoblinModel = _GoblinVariantCulling != 0u && (index & 1u) != 0u;
        float cameraDistance = distance(state.position, _LodCameraPosition);
        float viewingDistance = sqrt(cameraDistance * cameraDistance + _LodProjection.x * _LodProjection.x);
        float projectedHeight = 2.4 * state.scale * _LodProjection.y /
            (_LodProjection.z > 0.5 ? 1.0 : max(0.1, viewingDistance));
        bool useLod = _AnimatedGoblin != 0u ? projectedHeight < _LodProjection.w : cameraDistance > 32.0;
        if (_CullingEnabled != 0 && useLod)
        {
            if (secondGoblinModel)
            {
                _VariantLodIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
                _VisibleIndices[_VisibleListCapacity * 3u + visibleIndex] = index;
            }
            else
            {
                _LodIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
                _VisibleIndices[_VisibleListCapacity + visibleIndex] = index;
            }
        }
        else
        {
            if (secondGoblinModel)
            {
                _VariantIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
                _VisibleIndices[_VisibleListCapacity * 2u + visibleIndex] = index;
            }
            else
            {
                _IndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
                _VisibleIndices[visibleIndex] = index;
            }
        }
        InterlockedAdd(_Diagnostics[4], 1u);
    }
}
